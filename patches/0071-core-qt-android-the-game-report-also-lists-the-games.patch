diff --git a/src/citra_qt/game_list.cpp b/src/citra_qt/game_list.cpp
index 1409a3d..9b11e53 100644
--- a/src/citra_qt/game_list.cpp
+++ b/src/citra_qt/game_list.cpp
@@ -42,6 +42,7 @@
 #include "core/file_sys/archive_source_sd_savedata.h"
 #include "core/hle/service/am/am.h"
 #include "core/hle/service/fs/archive.h"
+#include "core/tangelo_report.h"
 #include "qcursor.h"
 
 GameListSearchField::KeyReleaseEater::KeyReleaseEater(GameList* gamelist, QObject* parent)
@@ -518,6 +519,26 @@ void GameList::DonePopulating(const QStringList& watch_list) {
     }
     tree_view->header()->setStretchLastSection(true);
 
+    // The games in the user's own game folders (not the installed ones) for the opt-in game
+    // report: the server lists them per console as "in the game folders".
+    std::vector<u64> folder_titles;
+    for (int i = 0; i < item_model->rowCount(); ++i) {
+        const QStandardItem* dir = item_model->item(i, 0);
+        if (dir == nullptr || static_cast<GameListItemType>(dir->type()) !=
+                                  GameListItemType::CustomDir) {
+            continue;
+        }
+        for (int row = 0; row < dir->rowCount(); ++row) {
+            const QStandardItem* game = dir->child(row, 0);
+            if (game != nullptr &&
+                static_cast<GameListItemType>(game->type()) == GameListItemType::Game) {
+                folder_titles.push_back(
+                    game->data(GameListItemPath::ProgramIdRole).toULongLong());
+            }
+        }
+    }
+    Core::SetGameFolderTitles(std::move(folder_titles));
+
     emit PopulatingCompleted();
 }
 
diff --git a/src/core/tangelo_report.cpp b/src/core/tangelo_report.cpp
index 70aba36..adba359 100644
--- a/src/core/tangelo_report.cpp
+++ b/src/core/tangelo_report.cpp
@@ -4,6 +4,8 @@
 
 #include <algorithm>
 #include <memory>
+#include <mutex>
+#include <optional>
 #include <thread>
 #include <fmt/format.h>
 #include <httplib.h>
@@ -24,6 +26,17 @@ namespace {
 // Title ID high halves worth reporting: applications, demos, updates and DLC.
 constexpr u32 ReportedTitleTypes[] = {0x00040000, 0x00040002, 0x0004000E, 0x0004008C};
 
+std::mutex folder_mutex;
+std::optional<std::vector<u64>> folder_titles;
+
+std::string TitleList(const std::vector<u64>& titles) {
+    std::string list;
+    for (const u64 title : titles) {
+        list += fmt::format("{}\"{:016X}\"", list.empty() ? "" : ",", title);
+    }
+    return list;
+}
+
 std::string JsonString(std::string_view text) {
     std::string out = "\"";
     for (const char c : text) {
@@ -92,15 +105,22 @@ std::vector<u64> ListInstalledGames() {
     return titles;
 }
 
-std::string MakeGameReport(u64 console_id, u64 started_title, const std::vector<u64>& installed) {
-    std::string list;
-    for (const u64 title : installed) {
-        list += fmt::format("{}\"{:016X}\"", list.empty() ? "" : ",", title);
-    }
+void SetGameFolderTitles(std::vector<u64> titles) {
+    std::sort(titles.begin(), titles.end());
+    titles.erase(std::unique(titles.begin(), titles.end()), titles.end());
+    titles.erase(std::remove(titles.begin(), titles.end(), u64{0}), titles.end());
+    std::scoped_lock lock{folder_mutex};
+    folder_titles = std::move(titles);
+}
+
+std::string MakeGameReport(u64 console_id, u64 started_title, const std::vector<u64>& installed,
+                           const std::optional<std::vector<u64>>& folder) {
+    const std::string folder_part =
+        folder ? fmt::format(",\"folder\":[{}]", TitleList(*folder)) : std::string{};
     return fmt::format("{{\"console_id\":\"{:016X}\",\"started\":\"{:016X}\","
-                       "\"installed\":[{}],\"tangelo\":{},\"platform\":\"{}\"}}",
-                       console_id, started_title, list, JsonString(Common::g_scm_desc),
-                       Platform());
+                       "\"installed\":[{}]{},\"tangelo\":{},\"platform\":\"{}\"}}",
+                       console_id, started_title, TitleList(installed), folder_part,
+                       JsonString(Common::g_scm_desc), Platform());
 }
 
 std::string GameReportUrl(const std::string& server) {
@@ -130,10 +150,15 @@ void ReportGameStart(System& system, u64 started_title) {
     if (const auto cfg = Service::CFG::GetModule(system)) {
         console_id = cfg->GetConsoleUniqueId();
     }
+    std::optional<std::vector<u64>> folder;
+    {
+        std::scoped_lock lock{folder_mutex};
+        folder = folder_titles;
+    }
     // Everything the thread needs is copied: it may outlive this game.
-    std::thread([url, console_id, started_title] {
+    std::thread([url, console_id, started_title, folder = std::move(folder)] {
         const std::vector<u64> installed = ListInstalledGames();
-        const std::string body = MakeGameReport(console_id, started_title, installed);
+        const std::string body = MakeGameReport(console_id, started_title, installed, folder);
         const Common::URLInfo info = Common::SplitUrl(url);
         std::unique_ptr<httplib::ClientImpl> client;
         if (info.is_https) {
@@ -153,8 +178,10 @@ void ReportGameStart(System& system, u64 started_title) {
         } else if (response->status != 200) {
             LOG_WARNING(Core, "Game report for {:016X}: HTTP {}", started_title, response->status);
         } else {
-            LOG_INFO(Core, "Game report sent: started {:016X}, {} installed title(s)",
-                     started_title, installed.size());
+            LOG_INFO(Core, "Game report sent: started {:016X}, {} installed title(s), {}",
+                     started_title, installed.size(),
+                     folder ? fmt::format("{} in the game folders", folder->size())
+                            : std::string{"game folders not loaded yet"});
         }
