@@ -16,8 +17,17 @@ class System;
 /// in the NAND, read from their title folders.
 std::vector<u64> ListInstalledGames();
 
-/// The JSON body of a game report (see ReportGameStart).
-std::string MakeGameReport(u64 console_id, u64 started_title, const std::vector<u64>& installed);
+/**
+ * The titles of the games in the frontend's game folders (the game list's own folders, network
+ * folders included, not the installed titles), set by the frontend each time its game list has
+ * been loaded. Game reports send them as "folder". Until the frontend has set them, reports
+ * leave "folder" out, so the server keeps what it knew.
+ */
+void SetGameFolderTitles(std::vector<u64> titles);
+
+/// The JSON body of a game report (see ReportGameStart). `folder` is left out when not known.
+std::string MakeGameReport(u64 console_id, u64 started_title, const std::vector<u64>& installed,
+                           const std::optional<std::vector<u64>>& folder = std::nullopt);
 
 /// The address a game report goes to: the custom Nintendo server ("[scheme://]host[:port]
 /// [/base]", http when no scheme is given) with "/tangelo/v1/games" added to its path.
diff --git a/src/tests/core/tangelo_report.cpp b/src/tests/core/tangelo_report.cpp
index 39e711a..f58dc37 100644
--- a/src/tests/core/tangelo_report.cpp
+++ b/src/tests/core/tangelo_report.cpp
@@ -27,4 +27,15 @@ TEST_CASE("MakeGameReport lists the started and installed titles", "[core][tange
 
     const std::string empty = Core::MakeGameReport(1, 2, {});
     REQUIRE(empty.find("\"installed\":[]") != std::string::npos);
+    // The game folders are left out until the frontend has loaded its game list.
+    REQUIRE(empty.find("\"folder\"") == std::string::npos);
+}
+
+TEST_CASE("MakeGameReport sends the game folder titles when known", "[core][tangelo_report]") {
+    const std::string body = Core::MakeGameReport(
+        1, 0x00040000001A2E00, {}, std::vector<u64>{0x00040000001A2E00, 0x0004000000153600});
+    REQUIRE(body.find("\"folder\":[\"00040000001A2E00\",\"0004000000153600\"]") !=
+            std::string::npos);
+    const std::string none = Core::MakeGameReport(1, 2, {}, std::vector<u64>{});
+    REQUIRE(none.find("\"folder\":[]") != std::string::npos);
 }
