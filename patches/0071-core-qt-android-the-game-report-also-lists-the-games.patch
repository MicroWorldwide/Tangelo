+void Java_io_github_microworldwide_tangelo_NativeLibrary_setGameFolderTitles(
+    JNIEnv* env, [[maybe_unused]] jobject obj, jlongArray j_titles) {
+    std::vector<u64> titles;
+    if (j_titles != nullptr) {
+        const jsize count = env->GetArrayLength(j_titles);
+        std::vector<jlong> values(static_cast<std::size_t>(count));
+        env->GetLongArrayRegion(j_titles, 0, count, values.data());
+        titles.reserve(values.size());
+        for (const jlong value : values) {
+            titles.push_back(static_cast<u64>(value));
+        }
+    }
+    Core::SetGameFolderTitles(std::move(titles));
+}
+
 jlongArray Java_io_github_microworldwide_tangelo_NativeLibrary_getSystemTitleIds(JNIEnv* env,
                                                                      [[maybe_unused]] jobject obj,
                                                                      jint system_type,
