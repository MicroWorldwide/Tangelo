+bool IsNetPassRelayUrl(std::string_view url) {
+    const std::string host = GetUrlHost(url);
+    if (host != NetPassHost && host != "devapi.netpass.cafe") {
+        return false;
+    }
+    const std::string_view rest = SplitAuthority(url).second;
+    constexpr std::string_view relay = "/spr";
+    return rest.starts_with(relay) &&
+           (rest.size() == relay.size() || rest[relay.size()] == '/' ||
+            rest[relay.size()] == '?');
+}
+
+std::optional<std::string> RedirectNetPassRelayUrl(std::string_view url, std::string_view server) {
+    if (!IsNetPassRelayUrl(url)) {
+        return std::nullopt;
+    }
+    return JoinServer(server, std::string(SplitAuthority(url).second), "https");
+}
