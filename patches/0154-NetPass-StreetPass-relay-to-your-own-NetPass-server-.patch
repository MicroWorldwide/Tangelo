+void Context::LogRelayResult(const std::string& request_url) const {
+    // The StreetPass relay answers in headers: 3ds-netpass-msg (why a request was refused) and
+    // x-spr-slotNN-result per uploaded outbox. Nothing else in the log shows them.
+    if (state != RequestState::ReceivingBody) {
+        return; // "Request failed" was logged already
+    }
+    std::string details;
+    for (const auto& [name, value] : response.headers) {
+        std::string lower(name);
+        std::transform(lower.begin(), lower.end(), lower.begin(),
+                       [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+        if (lower == "3ds-netpass-msg" || lower.starts_with("x-spr-")) {
+            details += fmt::format("; {}: {}", name, value);
+        }
+    }
+    if (response.status >= 200 && response.status < 300) {
+        LOG_INFO(Service_HTTP, "StreetPass relay {}: {}{}", request_url, response.status,
+                 details);
+    } else {
+        std::string body = response.body.substr(0, 200);
+        std::replace_if(
+            body.begin(), body.end(), [](unsigned char c) { return c < 0x20 || c > 0x7E; },
+            ' ');
+        LOG_WARNING(Service_HTTP, "StreetPass relay {}: refused with {}{}{}", request_url,
+                    response.status, details, body.empty() ? "" : "; body: " + body);
+    }
+}
