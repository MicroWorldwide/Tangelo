diff --git a/src/core/hle/service/http/spotpass_redirect.cpp b/src/core/hle/service/http/spotpass_redirect.cpp
index 54e0c49..7502f55 100644
--- a/src/core/hle/service/http/spotpass_redirect.cpp
+++ b/src/core/hle/service/http/spotpass_redirect.cpp
@@ -130,6 +130,11 @@ bool IsSpotPassUrl(std::string_view url) {
 }
 
 bool IsSpotPassUploadUrl(std::string_view url) {
+    // Play reports ("preport" tasks) are sent to the npvk hosts.
+    const std::string host = GetUrlHost(url);
+    if (host == "npvk.app.nintendo.net" || host == "npvk.app.nintendowifi.net") {
+        return true;
+    }
     if (!IsSpotPassUrl(url)) {
         return false;
     }
diff --git a/src/core/hle/service/http/spotpass_redirect.h b/src/core/hle/service/http/spotpass_redirect.h
index c0b98c7..2d7a1cf 100644
--- a/src/core/hle/service/http/spotpass_redirect.h
+++ b/src/core/hle/service/http/spotpass_redirect.h
@@ -22,8 +22,8 @@ std::string GetSpotPassHost(std::string_view url);
 /// on NetPass's SpotPass mirror (api.netpass.cafe), which NetPass puts in place of Nintendo's URLs.
 bool IsSpotPassUrl(std::string_view url);
 
-/// Returns true if `url` is a SpotPass upload (npul host or a /p01/recv/ path). Upload tasks send
-/// data to the server instead of downloading.
+/// Returns true if `url` is a SpotPass upload (npul host or a /p01/recv/ path) or a play report
+/// (npvk host). Such tasks send data to the server instead of downloading.
 bool IsSpotPassUploadUrl(std::string_view url);
 
 /**
diff --git a/src/tests/core/hle/service/spotpass_redirect.cpp b/src/tests/core/hle/service/spotpass_redirect.cpp
index 91d5ede..b005470 100644
--- a/src/tests/core/hle/service/spotpass_redirect.cpp
+++ b/src/tests/core/hle/service/spotpass_redirect.cpp
@@ -95,6 +95,8 @@ TEST_CASE("SpotPass upload URLs are recognised", "[service][http][spotpass]") {
         "https://a248.e.akamai.net/f/1/2/3/npdl.c.app.nintendowifi.net/p01/recv/abc/task"));
     CHECK_FALSE(IsSpotPassUploadUrl("https://npdl.cdn.nintendowifi.net/p01/nsa/abc/task/file"));
     CHECK_FALSE(IsSpotPassUploadUrl("https://example.com/p01/recv/abc"));
+    // Play reports (Mario & Sonic's "preport" task).
+    CHECK(IsSpotPassUploadUrl("https://npvk.app.nintendo.net/reports"));
 }
 
 TEST_CASE("Nintendo services are redirected to the stand-in server", "[service][http][spotpass]") {
