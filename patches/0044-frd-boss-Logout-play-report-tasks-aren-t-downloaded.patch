From 089871ada687ffc173c9ccefa54beb62b089f9b3 Mon Sep 17 00:00:00 2001
From: Tangelo Dev <tangelo-dev@noreply.invalid>
Date: Wed, 30 Sep 2026 23:41:36 +0200
Subject: [PATCH] frd, boss: Logout; play report tasks aren't downloaded

Seen with Mario & Sonic at the Rio 2016 Olympic Games after 0042 (the
login now ends in the game's normal 002-0110 message):

- frd:u/frd:a Logout (0x0004) was unimplemented; it now ends the
  session like Login started it.
- The game's "preport" SpotPass task sends play reports to
  npvk.app.nintendo.net/reports. It was run as a download and failed
  with "Could not establish connection"; it's now treated like other
  upload tasks (reported as failed without a request).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FYz3krf43qKGY6aS2Z5snz
---
 src/core/hle/service/frd/frd.cpp                 | 10 ++++++++++
 src/core/hle/service/frd/frd.h                   |  7 +++++++
 src/core/hle/service/frd/frd_a.cpp               |  2 +-
 src/core/hle/service/frd/frd_u.cpp               |  2 +-
 src/core/hle/service/http/spotpass_redirect.cpp  |  5 +++++
 src/core/hle/service/http/spotpass_redirect.h    |  4 ++--
 src/tests/core/hle/service/spotpass_redirect.cpp |  2 ++
 7 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/src/core/hle/service/frd/frd.cpp b/src/core/hle/service/frd/frd.cpp
index c33caa7..bfea921 100644
--- a/src/core/hle/service/frd/frd.cpp
+++ b/src/core/hle/service/frd/frd.cpp
@@ -312,6 +312,16 @@ void Module::Interface::Login(Kernel::HLERequestContext& ctx) {
     rb.Push(ResultSuccess);
 }
 
+void Module::Interface::Logout(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    frd->logged_in = false;
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push(ResultSuccess);
+
+    LOG_DEBUG(Service_FRD, "called");
+}
+
 void Module::Interface::GetLastResponseResult(Kernel::HLERequestContext& ctx) {
     LOG_WARNING(Service_FRD, "(STUBBED) called");
 
diff --git a/src/core/hle/service/frd/frd.h b/src/core/hle/service/frd/frd.h
index fb609c7..da2ada6 100644
--- a/src/core/hle/service/frd/frd.h
+++ b/src/core/hle/service/frd/frd.h
@@ -287,6 +287,13 @@ public:
          */
         void GetLastResponseResult(Kernel::HLERequestContext& ctx);
 
+        /**
+         * FRD::Logout service function
+         *  Outputs:
+         *      1 : Result of function, 0 on success, otherwise error code
+         */
+        void Logout(Kernel::HLERequestContext& ctx);
+
         /**
          * FRD::RequestGameAuthentication service function. Logs in at the game server login
          * (NASC) for the game's server id; the answer is read with GetGameAuthenticationData.
