From e41003b490551c61d39e36c0d5a7fa118a6ad2ba Mon Sep 17 00:00:00 2001
From: Tangelo Dev <tangelo-dev@noreply.invalid>
Date: Fri, 2 Oct 2026 03:06:55 +0200
Subject: [PATCH] apt, kernel: stop the software's threads while the 3DS sleeps

After a lid close the software prepares for sleep (it unloads the DSP and
closes handles) and ends with ReplySleepNotificationComplete. A real 3DS
stops its CPU from there until the lid opens. Tangelo kept running the
software's threads, so a thread could wait on a handle that had just been
closed: nintendogs + cats on the walk screen threw a fatal error
(WaitSynchronizationN, 0xD8E007F7 invalid handle) and the emulator stopped.

ReplySleepNotificationComplete now unschedules the calling process's threads
(new UnscheduleMode::SLEEP); opening the lid schedules them again before
SleepAwake is sent. The clock and the virtual pedometer keep going.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FYz3krf43qKGY6aS2Z5snz
---
 src/core/hle/kernel/process.h               |  1 +
 src/core/hle/service/apt/applet_manager.cpp | 44 +++++++++++++++++++++
 src/core/hle/service/apt/applet_manager.h   | 16 ++++++++
 src/core/hle/service/apt/apt.cpp            |  5 ++-
 4 files changed, 65 insertions(+), 1 deletion(-)

diff --git a/src/core/hle/kernel/process.h b/src/core/hle/kernel/process.h
index 0ea2563..e6c6892 100644
--- a/src/core/hle/kernel/process.h
+++ b/src/core/hle/kernel/process.h
@@ -56,6 +56,7 @@ enum class UnscheduleMode : u32 {
     SVC = (1 << 0),
     GDB = (1 << 1),
     FRONTEND = (1 << 2),
+    SLEEP = (1 << 3), ///< The 3DS is asleep (lid closed): the software's threads don't run
 };
 DECLARE_ENUM_FLAG_OPERATORS(UnscheduleMode);
 
diff --git a/src/core/hle/service/apt/applet_manager.cpp b/src/core/hle/service/apt/applet_manager.cpp
index 432a0fe..9352052 100644
--- a/src/core/hle/service/apt/applet_manager.cpp
+++ b/src/core/hle/service/apt/applet_manager.cpp
@@ -7,6 +7,8 @@
 #include "common/settings.h"
 #include "core/core.h"
 #include "core/frontend/input.h"
+#include "core/hle/kernel/process.h"
+#include "core/hle/kernel/thread.h"
 #include "core/hle/applets/applet.h"
 #include "core/hle/applets/erreula.h"
 #include "core/hle/applets/mii_selector.h"
@@ -1787,6 +1789,7 @@ void AppletManager::ApplyShellState(bool closed) {
         return;
     }
 
+    WakeSleepingProcesses();
     if (sleeping) {
         LOG_INFO(Service_APT, "3DS lid opened: waking up");
         SendNotificationToAll(Notification::SleepAwake);
@@ -1829,6 +1832,47 @@ void AppletManager::ReplySleepQuery(AppletId from_applet_id, SleepQueryReply rep
     }
 }
 
+void AppletManager::SleepNotificationComplete(AppletId from_applet_id,
+                                              std::shared_ptr<Kernel::Process> process) {
+    if (!shell_closed || !sleeping || !process) {
+        return; // not asleep (the lid was opened again in between)
+    }
+    for (const auto& weak : sleeping_processes) {
+        if (weak.lock() == process) {
+            return;
+        }
+    }
+    LOG_INFO(Service_APT, "{:03X} is ready for sleep: stopping process {} until the lid opens",
+             from_applet_id, process->process_id);
+    // Only the thread flags here: this runs inside the software's own IPC call, so the switch to
+    // other threads is left to the next reschedule.
+    SetProcessAsleep(*process, true);
+    sleeping_processes.push_back(process);
+}
+
+void AppletManager::SetProcessAsleep(Kernel::Process& process, bool asleep) {
+    for (const auto& thread : process.GetThreadList()) {
+        if (asleep) {
+            thread->SetUnscheduleMode(Kernel::UnscheduleMode::SLEEP);
+        } else {
+            thread->ClearUnscheduleMode(Kernel::UnscheduleMode::SLEEP);
+        }
+    }
+    for (u32 core = 0; core < system.GetNumCores(); ++core) {
+        system.GetCore(core).PrepareReschedule();
+    }
+}
+
+void AppletManager::WakeSleepingProcesses() {
+    for (const auto& weak : sleeping_processes) {
+        if (const auto process = weak.lock()) {
+            LOG_INFO(Service_APT, "Waking process {}", process->process_id);
+            SetProcessAsleep(*process, false);
+        }
+    }
+    sleeping_processes.clear();
+}
+
 void AppletManager::ButtonUpdateEvent(std::uintptr_t user_data, s64 cycles_late) {
     if (is_device_reload_pending.exchange(false)) {
         LoadInputDevices();
