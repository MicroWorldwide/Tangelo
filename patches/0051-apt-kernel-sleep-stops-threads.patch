 }
@@ -291,6 +295,14 @@ public:
     /// A reply to SleepQuery (APT ReplySleepQuery).
     void ReplySleepQuery(AppletId from_applet_id, SleepQueryReply reply);
 
+    /**
+     * The software finished getting ready for sleep (APT ReplySleepNotificationComplete). A real
+     * 3DS stops its CPU from here until the lid opens, so the process's threads are unscheduled;
+     * left running, threads of the sleeping software wait on handles it has just closed.
+     */
+    void SleepNotificationComplete(AppletId from_applet_id,
+                                   std::shared_ptr<Kernel::Process> process);
+
     /**
      * Clears any existing parameter and places a new one. This function is currently only used by
      * HLE Applets and should be likely removed in the future
@@ -547,7 +559,11 @@ private:
     bool shell_closed = false;
     bool sleep_query_pending = false;
     bool sleeping = false;
+    /// Processes stopped for sleep, scheduled again when the lid opens.
+    std::vector<std::weak_ptr<Kernel::Process>> sleeping_processes;
     void ApplyShellState(bool closed);
+    void WakeSleepingProcesses();
+    void SetProcessAsleep(Kernel::Process& process, bool asleep);
     std::unique_ptr<Input::ButtonDevice> home_button;
     std::unique_ptr<Input::ButtonDevice> power_button;
     bool last_home_button_state = false;
diff --git a/src/core/hle/service/apt/apt.cpp b/src/core/hle/service/apt/apt.cpp
index b25b72d..17fd296 100644
--- a/src/core/hle/service/apt/apt.cpp
+++ b/src/core/hle/service/apt/apt.cpp
@@ -1080,10 +1080,13 @@ void Module::APTInterface::ReplySleepNotificationComplete(Kernel::HLERequestCont
     IPC::RequestParser rp(ctx);
     const auto from_app_id = rp.PopEnum<AppletId>();
 
-    LOG_WARNING(Service_APT, "(STUBBED) called, from_app_id={:08X}", from_app_id);
+    LOG_DEBUG(Service_APT, "called, from_app_id={:08X}", from_app_id);
 
     IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
     rb.Push(ResultSuccess);
+
+    apt->applet_manager->SleepNotificationComplete(from_app_id,
+                                                   ctx.ClientThread()->owner_process.lock());
 }
 
 void Module::APTInterface::PrepareToJumpToHomeMenu(Kernel::HLERequestContext& ctx) {
