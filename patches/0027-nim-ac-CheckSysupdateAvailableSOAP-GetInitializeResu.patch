+    void CheckSysupdateAvailableSOAP(Kernel::HLERequestContext& ctx);
+
+    /**
+     * NIM::GetInitializeResult service function
+     *  Outputs:
+     *      1 : Result of NIM's initialization, 0 if it is ready
+     */
+    void GetInitializeResult(Kernel::HLERequestContext& ctx);
+
     SERVICE_SERIALIZATION_SIMPLE
 };
 
