         // clang-format on
     };
@@ -24,4 +27,26 @@ NIM_S::NIM_S() : ServiceFramework("nim:s", 1) {
 
 NIM_S::~NIM_S() = default;
 
+void NIM_S::CheckSysupdateAvailableSOAP(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+
+    // Nintendo's update servers are gone and emulated system files aren't updated this way, so
+    // never report an update: apps such as the Nintendo Zone viewer stop using the connection
+    // when one is reported.
+    IPC::RequestBuilder rb = rp.MakeBuilder(2, 0);
+    rb.Push(ResultSuccess);
+    rb.Push<u8>(0);
+
+    LOG_DEBUG(Service_NIM, "called, reporting no system update");
+}
+
+void NIM_S::GetInitializeResult(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push(ResultSuccess);
+
+    LOG_DEBUG(Service_NIM, "called");
+}
+
 } // namespace Service::NIM
