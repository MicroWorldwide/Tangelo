From 815855e4db4f2b5c0f02fbd0857f4f5221ec31d5 Mon Sep 17 00:00:00 2001
From: Tangelo Dev <tangelo-dev@noreply.invalid>
Date: Mon, 28 Sep 2026 02:10:32 +0200
Subject: [PATCH 2/2] dsp: log binary pipe (AAC codec) messages at debug level

The DSP binary pipe (channel 3) carries the AAC decode/encode protocol,
which is only partly mapped in audio_core/hle/decoder.h. HLE audio has
no AAC encoder, so recording in Nintendo 3DS Sound hangs.

Dump every binary pipe message in both directions under Service.DSP
debug logging. With LLE audio this records the real firmware's requests
and replies, the reference needed to implement EncodeAAC in HLE.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FYz3krf43qKGY6aS2Z5snz
---
 src/core/hle/service/dsp/dsp_dsp.cpp | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/src/core/hle/service/dsp/dsp_dsp.cpp b/src/core/hle/service/dsp/dsp_dsp.cpp
index f8b23c0..0b8e265 100644
--- a/src/core/hle/service/dsp/dsp_dsp.cpp
+++ b/src/core/hle/service/dsp/dsp_dsp.cpp
@@ -23,6 +23,26 @@ enum class DspPipe;
 
 namespace Service::DSP {
 
+/// Binary pipe (channel 3) carries the AAC codec protocol. Its messages are only partly
+/// understood (see audio_core/hle/decoder.h), so dump them at debug level. With LLE audio this
+/// records what the real DSP firmware answers, which is the reference for the HLE codec.
+static constexpr u32 BinaryPipeChannel = 3;
+
+static void LogBinaryPipeMessage(const char* direction, u32 channel, std::span<const u8> data) {
+    if (channel != BinaryPipeChannel || data.empty()) {
+        return;
+    }
+    std::string hex;
+    hex.reserve(data.size() * 3);
+    for (std::size_t i = 0; i < data.size(); ++i) {
+        hex += fmt::format("{:02X}", data[i]);
+        if (i % 4 == 3 && i + 1 != data.size()) {
+            hex += ' ';
+        }
+    }
+    LOG_DEBUG(Service_DSP, "binary pipe {} [{}]: {}", direction, data.size(), hex);
+}
+
 void DSP_DSP::RecvData(Kernel::HLERequestContext& ctx) {
     IPC::RequestParser rp(ctx);
     const u32 register_number = rp.Pop<u32>();
@@ -100,6 +120,7 @@ void DSP_DSP::WriteProcessPipe(Kernel::HLERequestContext& ctx) {
         break;
     }
 
+    LogBinaryPipeMessage("app->dsp", channel, buffer);
     system.DSP().PipeWrite(pipe, buffer);
 
     IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
@@ -124,6 +145,8 @@ void DSP_DSP::ReadPipe(Kernel::HLERequestContext& ctx) {
     else
         UNREACHABLE(); // No more data is in pipe. Hardware hangs in this case; Should never happen.
 
+    LogBinaryPipeMessage("dsp->app", channel, pipe_buffer);
+
     IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
     rb.Push(ResultSuccess);
     rb.PushStaticBuffer(std::move(pipe_buffer), 0);
@@ -162,6 +185,8 @@ void DSP_DSP::ReadPipeIfPossible(Kernel::HLERequestContext& ctx) {
         pipe_buffer = system.DSP().PipeRead(pipe, size);
     }
 
+    LogBinaryPipeMessage("dsp->app", channel, pipe_buffer);
+
     IPC::RequestBuilder rb = rp.MakeBuilder(2, 2);
     rb.Push(ResultSuccess);
     rb.Push<u16>(static_cast<u16>(pipe_buffer.size()));
