@@ -0,0 +1,96 @@
+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include "core/hle/service/http/spotpass_redirect.h"
+
+namespace Service::HTTP {
+
+namespace {
+
+constexpr std::array<std::string_view, 3> SpotPassHosts{
+    "npdl.cdn.nintendowifi.net",   // SpotPass content (/p01/nsa/<boss code>/<task>/<file>)
+    "nppl.c.app.nintendowifi.net", // Policy list (/p01/policylist/...)
+    "npul.c.app.nintendowifi.net", // SpotPass uploads (/p01/recv/...)
+};
+
+std::string ToLower(std::string_view text) {
+    std::string result(text);
+    std::transform(result.begin(), result.end(), result.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return result;
+}
+
+std::string_view Trim(std::string_view text) {
+    while (!text.empty() && std::isspace(static_cast<unsigned char>(text.front()))) {
+        text.remove_prefix(1);
+    }
+    while (!text.empty() && std::isspace(static_cast<unsigned char>(text.back()))) {
+        text.remove_suffix(1);
+    }
+    return text;
+}
+
+/// Splits "scheme://authority/rest" into authority and rest ("/..." or "?..." or empty).
+std::pair<std::string_view, std::string_view> SplitAuthority(std::string_view url) {
+    const auto scheme_end = url.find("://");
+    if (scheme_end != std::string_view::npos) {
+        url.remove_prefix(scheme_end + 3);
+    }
+    const auto rest_start = url.find_first_of("/?#");
+    if (rest_start == std::string_view::npos) {
+        return {url, {}};
+    }
+    return {url.substr(0, rest_start), url.substr(rest_start)};
+}
+
+} // namespace
+
+std::string GetUrlHost(std::string_view url) {
+    std::string_view authority = SplitAuthority(url).first;
+    const auto at = authority.rfind('@');
+    if (at != std::string_view::npos) {
+        authority.remove_prefix(at + 1);
+    }
+    const auto colon = authority.find(':');
+    if (colon != std::string_view::npos) {
+        authority = authority.substr(0, colon);
+    }
+    return ToLower(authority);
+}
+
+bool IsSpotPassHost(std::string_view host) {
+    const std::string name = GetUrlHost(host);
+    return std::find(SpotPassHosts.begin(), SpotPassHosts.end(), name) != SpotPassHosts.end();
+}
+
+std::optional<std::string> RedirectSpotPassUrl(std::string_view url, std::string_view server) {
+    server = Trim(server);
+    if (server.empty() || !IsSpotPassHost(GetUrlHost(url))) {
+        return std::nullopt;
+    }
+
+    std::string base(server);
+    if (base.find("://") == std::string::npos) {
+        base = "https://" + base;
+    }
+    if (GetUrlHost(base).empty()) {
+        return std::nullopt;
+    }
+    // Drop trailing slashes of the base path only (never the "//" after the scheme).
+    const std::size_t authority_end = base.find("://") + 3 + SplitAuthority(base).first.size();
+    while (base.size() > authority_end && base.back() == '/') {
+        base.pop_back();
+    }
+
+    std::string rest(SplitAuthority(url).second);
+    if (rest.empty() || rest.front() != '/') {
+        rest.insert(rest.begin(), '/');
+    }
+    return base + rest;
+}
+
+} // namespace Service::HTTP
