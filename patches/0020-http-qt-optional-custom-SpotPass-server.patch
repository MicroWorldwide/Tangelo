+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <catch2/catch_test_macros.hpp>
+#include "core/hle/service/http/spotpass_redirect.h"
+
+using Service::HTTP::GetUrlHost;
+using Service::HTTP::IsSpotPassHost;
+using Service::HTTP::RedirectSpotPassUrl;
+
+TEST_CASE("SpotPass hosts are recognised", "[service][http][spotpass]") {
+    CHECK(IsSpotPassHost("npdl.cdn.nintendowifi.net"));
+    CHECK(IsSpotPassHost("NPDL.CDN.NintendoWiFi.net:443"));
+    CHECK(IsSpotPassHost("nppl.c.app.nintendowifi.net"));
+    CHECK(IsSpotPassHost("npul.c.app.nintendowifi.net"));
+    CHECK_FALSE(IsSpotPassHost("nasc.nintendowifi.net"));
+    CHECK_FALSE(IsSpotPassHost("npdl.cdn.nintendowifi.net.evil.example"));
+    CHECK_FALSE(IsSpotPassHost(""));
+}
+
+TEST_CASE("URL host extraction", "[service][http][spotpass]") {
+    CHECK(GetUrlHost("https://npdl.cdn.nintendowifi.net/p01/nsa/x") == "npdl.cdn.nintendowifi.net");
+    CHECK(GetUrlHost("http://User@Example.local:8080?q=1") == "example.local");
+    CHECK(GetUrlHost("example.local") == "example.local");
+}
+
+TEST_CASE("SpotPass URLs are redirected to the custom server", "[service][http][spotpass]") {
+    const std::string content =
+        "https://npdl.cdn.nintendowifi.net/p01/nsa/0N4QxEv2JVgYrMtZ/data/0000001?x=1";
+
+    CHECK(RedirectSpotPassUrl(content, "http://192.168.1.10:8080") ==
+          "http://192.168.1.10:8080/p01/nsa/0N4QxEv2JVgYrMtZ/data/0000001?x=1");
+    CHECK(RedirectSpotPassUrl(content, "  https://spot.local/base/  ") ==
+          "https://spot.local/base/p01/nsa/0N4QxEv2JVgYrMtZ/data/0000001?x=1");
+    // No scheme: https is assumed.
+    CHECK(RedirectSpotPassUrl(content, "spot.local:8443") ==
+          "https://spot.local:8443/p01/nsa/0N4QxEv2JVgYrMtZ/data/0000001?x=1");
+    CHECK(RedirectSpotPassUrl("https://nppl.c.app.nintendowifi.net/p01/policylist/3/NL",
+                              "http://spot.local") == "http://spot.local/p01/policylist/3/NL");
+    CHECK(RedirectSpotPassUrl("https://npdl.cdn.nintendowifi.net", "http://spot.local") ==
+          "http://spot.local/");
+}
+
+TEST_CASE("Other URLs and empty servers are left alone", "[service][http][spotpass]") {
+    CHECK_FALSE(RedirectSpotPassUrl("https://nasc.nintendowifi.net/ac", "http://spot.local"));
+    CHECK_FALSE(RedirectSpotPassUrl("https://npdl.cdn.nintendowifi.net/p01/nsa/a/b/c", ""));
+    CHECK_FALSE(RedirectSpotPassUrl("https://npdl.cdn.nintendowifi.net/p01/nsa/a/b/c", "   "));
+    CHECK_FALSE(RedirectSpotPassUrl("https://npdl.cdn.nintendowifi.net/p01/nsa/a/b/c", "http://"));
+}
