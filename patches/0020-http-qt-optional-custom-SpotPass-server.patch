+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace Service::HTTP {
+
+/// Returns true if `host` (optionally with ":port") is one of Nintendo's SpotPass (BOSS) hosts:
+/// content downloads, the policy list and SpotPass uploads.
+bool IsSpotPassHost(std::string_view host);
+
+/**
+ * Rewrites a SpotPass URL so it points at a custom server.
+ * `server` is "[scheme://]host[:port][/base/path]"; without a scheme, https is assumed.
+ * The original path and query are appended to the server's base path, so
+ * "https://npdl.cdn.nintendowifi.net/p01/nsa/abc/task/file" with server "http://my.host:8080/sp"
+ * becomes "http://my.host:8080/sp/p01/nsa/abc/task/file".
+ * Returns nullopt if `url` isn't a SpotPass URL or `server` is empty.
+ */
+std::optional<std::string> RedirectSpotPassUrl(std::string_view url, std::string_view server);
+
+/// The host part of `url` without scheme, port, path or query.
+std::string GetUrlHost(std::string_view url);
+
+} // namespace Service::HTTP
