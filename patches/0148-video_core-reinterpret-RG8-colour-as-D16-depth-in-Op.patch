+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the misc/licenses/gplv2.txt file included.
+
+//? #version 430 core
+
+// RG8 colour data written back into a 16-bit depth buffer (DEAD OR ALIVE Dimensions does this,
+// the other way round of d16_to_rg8). In 3DS memory RG8 is stored [G, R] and D16 is a
+// little-endian u16, so R is the high byte of the depth and G the low byte.
+
+precision highp int;
+precision highp float;
+
+layout(location = 0) in mediump vec2 tex_coord;
+
+layout(binding = 0) uniform lowp sampler2D source;
+
+void main() {
+    mediump vec2 coord = tex_coord * vec2(textureSize(source, 0));
+    mediump ivec2 tex_icoord = ivec2(coord);
+    highp uvec2 rg = uvec2(texelFetch(source, tex_icoord, 0).rg * (exp2(8.0) - 1.0) + 0.5);
+    highp uint depth_val = (rg.r << 8u) | rg.g;
+    gl_FragDepth = float(depth_val) / (exp2(16.0) - 1.0);
+}
