diff --git a/src/tests/core/hle/service/news_arrivals.cpp b/src/tests/core/hle/service/news_arrivals.cpp
new file mode 100644
index 0000000..597f68e
--- /dev/null
+++ b/src/tests/core/hle/service/news_arrivals.cpp
@@ -0,0 +1,125 @@
+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <cstring>
+#include <filesystem>
+#include <string>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include "common/file_util.h"
+#include "common/string_util.h"
+#include "core/hle/service/news/news_arrivals.h"
+
+using namespace Service::NEWS;
+
+namespace {
+void PutText(std::vector<u8>& data, std::size_t offset, std::u16string_view text) {
+    std::memcpy(data.data() + offset, text.data(), text.size() * sizeof(char16_t));
+}
+
+/// Like the Mii Plaza payloads (NsData 0x88D / 0x962E): flags 01 01 00 01, program ID to jump
+/// to at 0x8, title at 0x20, message at 0x60, 0x17E0 bytes without an image.
+std::vector<u8> MakePayload(bool with_image, bool with_link) {
+    std::vector<u8> data(NewsPayloadImageOffset);
+    data[0] = 1; // valid
+    data[1] = 1; // unread
+    data[2] = with_image ? 1 : 0;
+    data[3] = 1; // SpotPass
+    data[5] = with_link ? 1 : 0;
+    constexpr u64 MiiPlaza = 0x0004001000022800;
+    std::memcpy(data.data() + 8, &MiiPlaza, sizeof(MiiPlaza));
+    PutText(data, NewsPayloadTitleOffset, u"Puzzelruil");
+    PutText(data, NewsPayloadMessageOffset, u"Er zijn nieuwe puzzels\nbeschikbaar.");
+    if (with_link) {
+        const char link[] = "https://example.com/";
+        std::memcpy(data.data() + NewsPayloadMessageOffset + 36 * 2, link, sizeof(link));
+    }
+    if (with_image) {
+        const std::vector<u8> jpeg{0xFF, 0xD8, 0xFF, 0xE0, 1, 2, 3, 0xFF, 0xD9};
+        data.insert(data.end(), jpeg.begin(), jpeg.end());
+    }
+    return data;
+}
+} // namespace
+
+TEST_CASE("NEWS payloads become notifications", "[service][news]") {
+    const auto parsed = ParseNewsPayload(MakePayload(false, false), 0x962E, 1, 12345);
+    REQUIRE(parsed);
+    const auto& header = parsed->header;
+    CHECK(header.flag_valid == 1);
+    CHECK(header.flag_read == 1);
+    CHECK(header.flag_boss == 1);
+    CHECK(header.flag_jpeg == 0);
+    CHECK(header.program_id == 0x0004001000022800);
+    CHECK(header.ns_data_id == 0x962E);
+    CHECK(header.version == 1);
+    CHECK(header.date_time == 12345);
+    CHECK(Common::UTF16BufferToUTF8(header.title) == "Puzzelruil");
+
+    const std::u16string expected = u"Er zijn nieuwe puzzels\nbeschikbaar.";
+    REQUIRE(parsed->message.size() == (expected.size() + 1) * 2); // text + NUL
+    CHECK(std::memcmp(parsed->message.data(), expected.data(), expected.size() * 2) == 0);
+    CHECK(parsed->image.empty());
+}
+
+TEST_CASE("NEWS payloads with an image and a link", "[service][news]") {
+    const auto parsed = ParseNewsPayload(MakePayload(true, true), 1, 2, 0);
+    REQUIRE(parsed);
+    CHECK(parsed->header.flag_jpeg == 1);
+    CHECK(parsed->header.flag_url == 1);
+    CHECK(parsed->image == std::vector<u8>{0xFF, 0xD8, 0xFF, 0xE0, 1, 2, 3, 0xFF, 0xD9});
+    // Text (35 characters + NUL) followed by the link and its NUL.
+    const std::string link = "https://example.com/";
+    REQUIRE(parsed->message.size() == 36 * 2 + link.size() + 1);
+    CHECK(std::string(reinterpret_cast<const char*>(parsed->message.data()) + 36 * 2) == link);
+
+    // Image flag without image data: no image.
+    auto no_image = MakePayload(true, false);
+    no_image.resize(NewsPayloadImageOffset);
+    const auto parsed2 = ParseNewsPayload(no_image, 1, 2, 0);
+    REQUIRE(parsed2);
+    CHECK(parsed2->header.flag_jpeg == 0);
+
+    // Too small or not valid.
+    CHECK_FALSE(ParseNewsPayload(std::vector<u8>(0x40, 1), 1, 1, 0));
+    auto invalid = MakePayload(false, false);
+    invalid[0] = 0;
+    CHECK_FALSE(ParseNewsPayload(invalid, 1, 1, 0));
+}
+
+TEST_CASE("Arrived notifications are queued once", "[service][news]") {
+    const std::string old_nand = FileUtil::GetUserPath(FileUtil::UserPath::NANDDir);
+    const std::string nand =
+        (std::filesystem::temp_directory_path() / "tangelo-news-test").string() + "/";
+    FileUtil::DeleteDirRecursively(nand);
+    REQUIRE(FileUtil::CreateFullPath(nand));
+    FileUtil::UpdateUserPath(FileUtil::UserPath::NANDDir, nand);
+
+    const auto payload = MakePayload(false, false);
+    CHECK(CountArrivedNews() == 0);
+    CHECK(QueueArrivedNews(0x88D, 1, payload));
+    CHECK(QueueArrivedNews(0x962E, 1, payload));
+    CHECK_FALSE(QueueArrivedNews(0x88D, 1, payload)); // same file downloaded again
+    CHECK(CountArrivedNews() == 2);
+
+    auto first = TakeArrivedNews(1);
+    REQUIRE(first.size() == 1);
+    CHECK(first[0].ns_data_id == 0x88D);
+    CHECK(first[0].version == 1);
+    CHECK(first[0].data == payload);
+
+    // Delivered already, even after it was taken; a new version does arrive.
+    CHECK_FALSE(QueueArrivedNews(0x88D, 1, payload));
+    CHECK(QueueArrivedNews(0x88D, 2, payload));
+
+    const auto rest = TakeArrivedNews();
+    REQUIRE(rest.size() == 2);
+    CHECK(rest[0].ns_data_id == 0x962E);
+    CHECK(rest[1].ns_data_id == 0x88D);
+    CHECK(rest[1].version == 2);
+    CHECK(CountArrivedNews() == 0);
+
+    FileUtil::UpdateUserPath(FileUtil::UserPath::NANDDir, old_nand);
+    FileUtil::DeleteDirRecursively(nand);
+}
