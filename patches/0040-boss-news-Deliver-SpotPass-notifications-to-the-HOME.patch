+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <algorithm>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <fmt/format.h>
+#include "common/file_util.h"
+#include "common/logging/log.h"
+#include "common/string_util.h"
+#include "core/file_sys/archive_systemsavedata.h"
+#include "core/file_sys/directory_backend.h"
+#include "core/file_sys/errors.h"
+#include "core/file_sys/file_backend.h"
+#include "core/hle/service/news/news_arrivals.h"
+
+namespace Service::NEWS {
+
+namespace {
+
+constexpr std::size_t NewsPayloadHeaderSize = 0x20;
+constexpr std::size_t NewsPayloadTitleSize = 0x40;
+constexpr std::size_t NewsPayloadMessageSize = NewsPayloadImageOffset - NewsPayloadMessageOffset;
+
+// Where SpotPass keeps notifications for the NEWS module: the BOSS system savedata (0x00010034).
+constexpr std::array<u8, 8> BossSaveDataId{0x00, 0x00, 0x00, 0x00, 0x34, 0x00, 0x01, 0x00};
+constexpr char QueueDir[] = "/news";
+constexpr char DeliveredFile[] = "/news/delivered";
+// Remembered NsData ID + version pairs; more than any title sends.
+constexpr std::size_t MaxDelivered = 256;
+
+std::mutex queue_mutex;
+
+std::unique_ptr<FileSys::ArchiveBackend> OpenBossSaveData() {
+    const std::string& nand_directory = FileUtil::GetUserPath(FileUtil::UserPath::NANDDir);
+    FileSys::ArchiveFactory_SystemSaveData factory(nand_directory);
+    const FileSys::Path archive_path(BossSaveDataId);
+    if (auto result = factory.Open(archive_path, 0); result.Succeeded()) {
+        return std::move(result).Unwrap();
+    }
+    factory.Format(archive_path, FileSys::ArchiveFormatInfo(), 0, 0, 0);
+    if (auto result = factory.Open(archive_path, 0); result.Succeeded()) {
+        return std::move(result).Unwrap();
+    }
+    LOG_ERROR(Service_NEWS, "Could not open the BOSS savedata for SpotPass notifications");
+    return nullptr;
+}
+
+std::vector<u8> ReadFile(FileSys::ArchiveBackend& archive, const std::string& path) {
+    FileSys::Mode mode{};
+    mode.read_flag.Assign(1);
+    auto file_result = archive.OpenFile(FileSys::Path(path.c_str()), mode);
+    if (file_result.Failed()) {
+        return {};
+    }
+    auto file = std::move(file_result).Unwrap();
+    std::vector<u8> data(file->GetSize());
+    if (!data.empty()) {
+        const auto read = file->Read(0, data.size(), data.data());
+        if (read.Failed() || read.Unwrap() != data.size()) {
+            data.clear();
+        }
+    }
+    file->Close();
+    return data;
+}
+
+bool WriteFile(FileSys::ArchiveBackend& archive, const std::string& path,
+               std::span<const u8> data) {
+    const FileSys::Path file_path(path.c_str());
+    archive.DeleteFile(file_path);
+    if (archive.CreateFile(file_path, data.size()).IsError()) {
+        return false;
+    }
+    FileSys::Mode mode{};
+    mode.write_flag.Assign(1);
+    auto file_result = archive.OpenFile(file_path, mode);
+    if (file_result.Failed()) {
+        return false;
+    }
+    auto file = std::move(file_result).Unwrap();
+    const auto written = data.empty() ? ResultVal<std::size_t>(std::size_t{0})
+                                      : file->Write(0, data.size(), true, false, data.data());
+    file->Close();
+    return written.Succeeded() && written.Unwrap() == data.size();
+}
+
+std::string QueuedName(u32 ns_data_id, u32 version) {
+    return fmt::format("{:08x}_{:08x}", ns_data_id, version);
+}
+
+/// Queued file names, oldest first (the names start with a sequence number).
+std::vector<std::string> ListQueued(FileSys::ArchiveBackend& archive) {
+    std::vector<std::string> names;
+    auto dir_result = archive.OpenDirectory(FileSys::Path(QueueDir));
+    if (dir_result.Failed()) {
+        return names;
+    }
+    auto dir = std::move(dir_result).Unwrap();
+    std::vector<FileSys::Entry> entries(128);
+    while (true) {
+        const u32 count = dir->Read(static_cast<u32>(entries.size()), entries.data());
+        if (count == 0) {
+            break;
+        }
+        for (u32 i = 0; i < count; i++) {
+            if (entries[i].is_directory) {
+                continue;
+            }
+            std::string name = Common::UTF16ToUTF8(std::u16string(entries[i].filename));
+            // "<sequence>-<ns data id>_<version>"
+            if (name.size() == 8 + 1 + 17 && name[8] == '-') {
+                names.push_back(std::move(name));
+            }
+        }
+    }
+    dir->Close();
+    std::sort(names.begin(), names.end());
+    return names;
+}
+
+std::vector<std::string> ReadDelivered(FileSys::ArchiveBackend& archive) {
+    const std::vector<u8> data = ReadFile(archive, DeliveredFile);
+    std::vector<std::string> lines;
+    std::string line;
+    for (const u8 c : data) {
+        if (c == '\n') {
+            if (!line.empty()) {
+                lines.push_back(std::move(line));
+            }
+            line.clear();
+        } else {
+            line.push_back(static_cast<char>(c));
+        }
+    }
+    if (!line.empty()) {
+        lines.push_back(std::move(line));
+    }
+    return lines;
+}
+
+} // namespace
+
+std::optional<ParsedNews> ParseNewsPayload(std::span<const u8> data, u32 ns_data_id, u32 version,
+                                           u64 date_time) {
+    if (data.size() < NewsPayloadMessageOffset) {
+        return std::nullopt;
+    }
+
+    ParsedNews news;
+    std::memcpy(&news.header, data.data(), NewsPayloadHeaderSize);
+    if (!news.header.IsValid()) {
+        return std::nullopt;
+    }
+    news.header.flag_boss = 1;
+    news.header.ns_data_id = ns_data_id;
+    news.header.version = version;
+    news.header.date_time = date_time;
+    std::memcpy(news.header.title.data(), data.data() + NewsPayloadTitleOffset,
+                NewsPayloadTitleSize);
+    news.header.title.back() = 0;
+
+    // Message: UTF-16 text up to and including its NUL, then the link (UTF-8 + NUL) if any.
+    const auto message_area =
+        data.subspan(NewsPayloadMessageOffset,
+                     std::min(NewsPayloadMessageSize, data.size() - NewsPayloadMessageOffset));
+    std::size_t end = 0;
+    while (end + 1 < message_area.size() &&
+           (message_area[end] != 0 || message_area[end + 1] != 0)) {
+        end += 2;
+    }
+    end = std::min(end + 2, message_area.size() & ~std::size_t{1});
+    if (news.header.flag_url != 0) {
+        std::size_t link_end = end;
+        while (link_end < message_area.size() && message_area[link_end] != 0) {
+            ++link_end;
+        }
+        if (link_end > end) {
+            end = std::min(link_end + 1, message_area.size());
+        }
+    }
+    news.message.assign(message_area.begin(), message_area.begin() + end);
+
+    if (news.header.flag_jpeg != 0 && data.size() > NewsPayloadImageOffset) {
+        news.image.assign(data.begin() + NewsPayloadImageOffset, data.end());
+    } else {
+        news.header.flag_jpeg = 0;
+    }
+    return news;
+}
+
+bool QueueArrivedNews(u32 ns_data_id, u32 version, std::span<const u8> data) {
+    std::scoped_lock lock(queue_mutex);
+    auto archive = OpenBossSaveData();
+    if (!archive) {
+        return false;
+    }
+    archive->CreateDirectory(FileSys::Path(QueueDir));
+
+    const std::string name = QueuedName(ns_data_id, version);
+    std::vector<std::string> delivered = ReadDelivered(*archive);
+    if (std::find(delivered.begin(), delivered.end(), name) != delivered.end()) {
+        LOG_DEBUG(Service_NEWS, "SpotPass notification {} was already delivered", name);
+        return false;
+    }
+
+    const auto queued = ListQueued(*archive);
+    u32 sequence = 0;
+    if (!queued.empty()) {
+        sequence = static_cast<u32>(std::stoul(queued.back().substr(0, 8), nullptr, 16)) + 1;
+    }
+    const std::string path = fmt::format("{}/{:08x}-{}", QueueDir, sequence, name);
+    if (!WriteFile(*archive, path, data)) {
+        LOG_ERROR(Service_NEWS, "Could not store SpotPass notification {}", name);
+        return false;
+    }
+
+    delivered.push_back(name);
+    if (delivered.size() > MaxDelivered) {
+        delivered.erase(delivered.begin(), delivered.end() - MaxDelivered);
+    }
+    std::string text;
+    for (const auto& line : delivered) {
+        text += line;
+        text += '\n';
+    }
+    WriteFile(*archive, DeliveredFile,
+              std::span(reinterpret_cast<const u8*>(text.data()), text.size()));
+    LOG_INFO(Service_NEWS, "SpotPass notification {:#010x} (version {}) arrived", ns_data_id,
+             version);
+    return true;
+}
+
+std::size_t CountArrivedNews() {
+    std::scoped_lock lock(queue_mutex);
+    auto archive = OpenBossSaveData();
+    return archive ? ListQueued(*archive).size() : 0;
+}
+
+std::vector<ArrivedNews> TakeArrivedNews(std::size_t max_count) {
+    std::scoped_lock lock(queue_mutex);
+    std::vector<ArrivedNews> result;
+    auto archive = OpenBossSaveData();
+    if (!archive) {
+        return result;
+    }
+    for (const auto& name : ListQueued(*archive)) {
+        if (result.size() >= max_count) {
+            break;
+        }
+        const std::string path = fmt::format("{}/{}", QueueDir, name);
+        ArrivedNews news;
+        news.ns_data_id = static_cast<u32>(std::stoul(name.substr(9, 8), nullptr, 16));
+        news.version = static_cast<u32>(std::stoul(name.substr(18, 8), nullptr, 16));
+        news.data = ReadFile(*archive, path);
+        archive->DeleteFile(FileSys::Path(path.c_str()));
+        result.push_back(std::move(news));
+    }
+    return result;
+}
+
+} // namespace Service::NEWS
