+Result Module::SyncArrivedNotifications(std::size_t max_count) {
+    const auto arrived = TakeArrivedNews(max_count);
+    if (arrived.empty()) {
+        return ResultSuccess;
+    }
+    const u64 now = system.Kernel().GetSharedPageHandler().GetSystemTimeSince2000();
+    bool added = false;
+    for (const auto& item : arrived) {
+        const auto parsed = ParseNewsPayload(item.data, item.ns_data_id, item.version, now);
+        if (!parsed) {
+            LOG_WARNING(Service_NEWS, "SpotPass notification {:#010x} is not valid; dropped",
+                        item.ns_data_id);
+            continue;
+        }
+        const Result result = SaveNotification(&parsed->header, sizeof(NotificationHeader),
+                                               parsed->message, parsed->image);
+        if (R_FAILED(result)) {
+            LOG_ERROR(Service_NEWS, "Could not add SpotPass notification {:#010x}: {:#010x}",
+                      item.ns_data_id, result.raw);
+            continue;
+        }
+        LOG_INFO(Service_NEWS, "Added SpotPass notification \"{}\" for {:#018x}",
+                 Common::UTF16BufferToUTF8(parsed->header.title), parsed->header.program_id);
+        added = true;
+    }
+    if (added && (db.header.flags & 1) == 0) {
+        // Unread notifications: the HOME Menu shows the green dot.
+        db.header.flags |= 1;
+        return SaveNewsDBSavedata();
+    }
+    return ResultSuccess;
 }
 
