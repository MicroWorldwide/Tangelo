+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <optional>
+#include <span>
+#include <vector>
+#include "common/common_types.h"
+#include "core/hle/service/news/news.h"
+
+namespace Service::NEWS {
+
+/// Program ID of the NEWS system module; SpotPass payloads for it are HOME Menu notifications.
+constexpr u64 NewsProgramId = 0x0004013000003502;
+
+/**
+ * A SpotPass notification payload (as downloaded, after the payload content header):
+ *   0x00  0x20    the first 0x20 bytes of a NotificationHeader (flags, program ID to jump to,
+ *                 NsData ID / version / jump parameter, normally zero)
+ *   0x20  0x40    title, UTF-16LE
+ *   0x60  0x1780  message, UTF-16LE, NUL-terminated; a link (UTF-8, NUL-terminated) may follow
+ *                 when the URL flag is set
+ *   0x17E0 ...    JPEG/MPO image, when the image flag is set
+ */
+struct ParsedNews {
+    NotificationHeader header{};
+    std::vector<u8> message;
+    std::vector<u8> image;
+};
+
+constexpr std::size_t NewsPayloadTitleOffset = 0x20;
+constexpr std::size_t NewsPayloadMessageOffset = 0x60;
+constexpr std::size_t NewsPayloadImageOffset = 0x17E0;
+
+/// Turns a notification payload into what AddNotification stores. `date_time` is the arrival
+/// time (milliseconds since 2000). Returns nullopt if the payload is too small or not valid.
+std::optional<ParsedNews> ParseNewsPayload(std::span<const u8> data, u32 ns_data_id, u32 version,
+                                           u64 date_time);
+
+struct ArrivedNews {
+    u32 ns_data_id = 0;
+    u32 version = 0;
+    std::vector<u8> data;
+};
+
+/**
+ * Keeps a notification payload that SpotPass downloaded until the NEWS service collects it
+ * (SyncArrivedNotifications), in the BOSS system savedata (/news/). Each NsData ID + version is
+ * delivered once: downloading the same file again doesn't bring back a deleted notification.
+ * Returns true if the payload was queued. Safe to call from SpotPass download threads.
+ */
+bool QueueArrivedNews(u32 ns_data_id, u32 version, std::span<const u8> data);
+
+/// Number of queued notifications (GetTotalArrivedNotifications).
+std::size_t CountArrivedNews();
+
+/// Removes and returns the queued notifications, oldest first (at most `max_count`).
+std::vector<ArrivedNews> TakeArrivedNews(std::size_t max_count = SIZE_MAX);
+
+} // namespace Service::NEWS
