+void HTTP_C::CancelAllRequests() {
+    std::size_t running = 0;
+    for (auto& [handle, context] : contexts) {
+        if (context.request_future.valid() &&
+            context.request_future.wait_for(std::chrono::seconds(0)) !=
+                std::future_status::ready) {
+            ++running;
+        }
+        context.Cancel();
+    }
+    if (running > 0) {
+        LOG_INFO(Service_HTTP, "Emulation stopping: {} running request(s) stopped", running);
+    }
+}
+
 void InstallInterfaces(Core::System& system) {
     auto& service_manager = system.ServiceManager();
-    std::make_shared<HTTP_C>()->InstallAsService(service_manager);
+    auto http = std::make_shared<HTTP_C>();
+    http->InstallAsService(service_manager);
+    // Requests still running when the emulation stops would otherwise wake game threads (and
+    // use this service) after they are gone: Tangelo closed 1-3 s after stopping a game that
+    // had a request open (Mario Golf, Badge Arcade, Swapdoodle, 2026-10-17).
+    system.Kernel().AddAsyncCancelHook([weak = std::weak_ptr<HTTP_C>(http)] {
+        if (const auto service = weak.lock()) {
+            service->CancelAllRequests();
+        }
+    });
 }
