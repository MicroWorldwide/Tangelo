+void KernelSystem::AddAsyncCancelHook(std::function<void()> hook) {
+    std::scoped_lock lock{async_cancel_hooks_mutex};
+    async_cancel_hooks.push_back(std::move(hook));
+}
+
+void KernelSystem::StopAsyncOperations() {
+    {
+        std::scoped_lock lock{async_guard->mutex};
+        async_guard->alive = false;
+    }
+    std::vector<std::function<void()>> hooks;
+    {
+        std::scoped_lock lock{async_cancel_hooks_mutex};
+        hooks = std::move(async_cancel_hooks);
+        async_cancel_hooks.clear();
+    }
+    for (auto& hook : hooks) {
+        hook();
+    }
+    // The sections still use their service (an HTTP context, a socket): wait for them before
+    // the services go. HTTP requests end at once when cancelled, a socket read within seconds.
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+    while (async_guard->running > 0 && std::chrono::steady_clock::now() < deadline) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+    if (async_guard->running > 0) {
+        LOG_WARNING(Kernel, "{} async operation(s) still running at shutdown",
+                    async_guard->running.load());
+    }
+}
+
 ResourceLimitList& KernelSystem::ResourceLimit() {
     return *resource_limits;
 }
