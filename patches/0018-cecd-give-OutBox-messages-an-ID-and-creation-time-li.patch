+// Refer to the license.txt file included.
+
+#include <cstring>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include "core/hle/service/cecd/cecd.h"
+
+using Service::CECD::Module;
+
+TEST_CASE("CECD message timestamps use the real cecd layout", "[core][cecd]") {
+    // Nintendo 3DS Sound's OutBox message written by the real cecd module at
+    // 2026-09-28 22:35:00.370 (a Monday) stores: 2026, 9, 28, 1, 22, 35, 0, 370.
+    const auto t = Module::MakeMessageTime(843'950'100'370);
+    CHECK(t.year == 2026u);
+    CHECK(t.month == 9);
+    CHECK(t.day == 28);
+    CHECK(t.weekday == 1);
+    CHECK(t.hour == 22);
+    CHECK(t.minute == 35);
+    CHECK(t.second == 0);
+    CHECK(t.millisecond == 370);
+
+    const auto start = Module::MakeMessageTime(0); // 2000-01-01, a Saturday
+    CHECK((start.year == 2000u && start.month == 1 && start.day == 1 && start.weekday == 6));
+
+    const auto leap = Module::MakeMessageTime(762'480'000'000); // 2024-02-29, a Thursday
+    CHECK((leap.year == 2024u && leap.month == 2 && leap.day == 29 && leap.weekday == 4));
+
+    // The byte layout of the timestamp as the real module wrote it.
+    const u8 real_bytes[12] = {0xEA, 0x07, 0x00, 0x00, 9, 28, 1, 22, 35, 0, 0x72, 0x01};
+    CHECK(std::memcmp(&t, real_bytes, sizeof(real_bytes)) == 0);
+}
+
+TEST_CASE("CECD gives new OutBox messages an ID and creation time", "[core][cecd]") {
+    // Header as Nintendo 3DS Sound writes it: sizes and flags set, no ID, no timestamps.
+    Module::CecMessageHeader app_header{};
+    app_header.magic = 0x6060;
+    app_header.message_size = 0x1800;
+    app_header.header_size = 0xD38;
+    app_header.body_size = 0xAA8;
+    app_header.title_id = 0x20500;
+    app_header.flag = 3;
+    app_header.send_method = 3;
+    app_header.send_count = 0xFF;
+    app_header.forward_count = 1;
+
+    std::vector<u8> message(0x1800, 0xAB);
+    std::memcpy(message.data(), &app_header, sizeof(app_header));
+
+    const Module::CecMessageId new_id{0x2e, 0x7e, 0xe1, 0x1d, 0x9a, 0x6f, 0x55, 0xf7};
+    const auto now = Module::MakeMessageTime(843'950'100'370);
+    const auto id = Module::FillOutboxMessageHeader(message, new_id, now);
+    CHECK(id == new_id);
+
+    Module::CecMessageHeader result;
+    std::memcpy(&result, message.data(), sizeof(result));
+    CHECK(result.message_id == new_id);
+    CHECK(std::memcmp(&result.create_time, &now, sizeof(now)) == 0);
+    // Everything else is left as the application wrote it, like the real module does.
+    CHECK(result.message_size == 0x1800u);
+    CHECK(result.title_id == 0x20500u);
+    CHECK(result.flag == 3);
+    CHECK(result.send_count == 0xFF);
+    CHECK(result.forward_count == 1);
+    CHECK(result.sender_id == 0u);
+    CHECK(result.send_time.year == 0u);
+    CHECK(result.recv_time.year == 0u);
+    CHECK(message[sizeof(result)] == 0xAB); // body untouched
+
+    // A message that already has an ID and creation time (an update, or a NetPass import)
+    // keeps them.
+    const Module::CecMessageId other_id{1, 2, 3, 4, 5, 6, 7, 8};
+    const auto later = Module::MakeMessageTime(900'000'000'000);
+    CHECK(Module::FillOutboxMessageHeader(message, other_id, later) == new_id);
+    std::memcpy(&result, message.data(), sizeof(result));
+    CHECK(result.message_id == new_id);
+    CHECK(std::memcmp(&result.create_time, &now, sizeof(now)) == 0);
+}
