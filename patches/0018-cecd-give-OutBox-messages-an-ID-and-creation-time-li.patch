+Module::CecMessageHeader::Time Module::MakeMessageTime(u64 ms_since_2000) {
+    // Days since 2000-01-01 to a civil date (Howard Hinnant's days_from_civil, inverted).
+    const u64 days_since_2000 = ms_since_2000 / 86'400'000;
+    const u64 ms_of_day = ms_since_2000 % 86'400'000;
+    const s64 z = static_cast<s64>(days_since_2000) + 10957 + 719468; // days since 0000-03-01
+    const s64 era = z / 146097;
+    const s64 doe = z - era * 146097;
+    const s64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+    const s64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    const s64 mp = (5 * doy + 2) / 153;
+    const s64 day = doy - (153 * mp + 2) / 5 + 1;
+    const s64 month = mp < 10 ? mp + 3 : mp - 9;
+    const s64 year = yoe + era * 400 + (month <= 2 ? 1 : 0);
+
+    CecMessageHeader::Time time{};
+    time.year = static_cast<u32>(year);
+    time.month = static_cast<u8>(month);
+    time.day = static_cast<u8>(day);
+    time.weekday = static_cast<u8>((6 + days_since_2000) % 7); // 2000-01-01 was a Saturday
+    time.hour = static_cast<u8>(ms_of_day / 3'600'000);
+    time.minute = static_cast<u8>(ms_of_day / 60'000 % 60);
+    time.second = static_cast<u8>(ms_of_day / 1'000 % 60);
+    time.millisecond = static_cast<u16>(ms_of_day % 1'000);
+    return time;
+}
+
+Module::CecMessageId Module::FillOutboxMessageHeader(std::span<u8> message,
+                                                     const CecMessageId& new_id,
+                                                     const CecMessageHeader::Time& now) {
+    CecMessageHeader header;
+    std::memcpy(&header, message.data(), sizeof(CecMessageHeader));
+
+    if (std::all_of(header.message_id.begin(), header.message_id.end(),
+                    [](u8 b) { return b == 0; })) {
+        header.message_id = new_id;
+    }
+    if (header.create_time.year == 0) {
+        header.create_time = now;
+    }
+
+    std::memcpy(message.data(), &header, sizeof(CecMessageHeader));
+    return header.message_id;
+}
+
+std::vector<u8> Module::PrepareOutboxMessage(std::vector<u8>& message) {
+    constexpr u16 message_magic = 0x6060;
+    CecMessageHeader header;
+    if (message.size() < sizeof(CecMessageHeader)) {
+        return {};
+    }
+    std::memcpy(&header, message.data(), sizeof(CecMessageHeader));
+    if (header.magic != message_magic) {
+        return {};
+    }
+
+    CecMessageId new_id;
+    CryptoPP::AutoSeededRandomPool rng;
+    rng.GenerateBlock(new_id.data(), new_id.size());
+    const auto now =
+        MakeMessageTime(system.Kernel().GetSharedPageHandler().GetSystemTimeSince2000());
+    const CecMessageId id = FillOutboxMessageHeader(message, new_id, now);
+    return std::vector<u8>(id.begin(), id.end());
+}
+
