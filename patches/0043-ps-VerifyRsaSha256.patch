+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <array>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include <cryptopp/osrng.h>
+#include <cryptopp/rsa.h>
+#include <cryptopp/sha.h>
+#include "core/hle/service/ps/ps_ps.h"
+
+using Service::PS::VerifyRsaSha256Pkcs1;
+
+TEST_CASE("ps:ps RSA-SHA256 signatures are checked", "[service][ps]") {
+    CryptoPP::AutoSeededRandomPool rng;
+    CryptoPP::RSA::PrivateKey key;
+    key.GenerateRandomWithKeySize(rng, 2048);
+
+    const std::vector<u8> message{'S', 'p', 'o', 't', 'P', 'a', 's', 's'};
+    std::array<u8, 0x20> hash;
+    CryptoPP::SHA256().CalculateDigest(hash.data(), message.data(), message.size());
+
+    CryptoPP::RSASS<CryptoPP::PKCS1v15, CryptoPP::SHA256>::Signer signer(key);
+    std::vector<u8> signature(signer.MaxSignatureLength());
+    signature.resize(signer.SignMessage(rng, message.data(), message.size(), signature.data()));
+    REQUIRE(signature.size() == 0x100);
+
+    std::vector<u8> modulus(0x100);
+    std::vector<u8> exponent(0x100);
+    key.GetModulus().Encode(modulus.data(), modulus.size());
+    key.GetPublicExponent().Encode(exponent.data(), exponent.size());
+
+    CHECK(VerifyRsaSha256Pkcs1(hash, modulus, exponent, signature));
+
+    auto other_hash = hash;
+    other_hash[0] ^= 1;
+    CHECK_FALSE(VerifyRsaSha256Pkcs1(other_hash, modulus, exponent, signature));
+
+    auto bad_signature = signature;
+    bad_signature[0x80] ^= 1;
+    CHECK_FALSE(VerifyRsaSha256Pkcs1(hash, modulus, exponent, bad_signature));
+
+    CHECK_FALSE(VerifyRsaSha256Pkcs1(hash, std::vector<u8>(0x100, 0), exponent, signature));
+    CHECK_FALSE(VerifyRsaSha256Pkcs1(hash, modulus, exponent, std::vector<u8>(0x80, 1)));
+}
