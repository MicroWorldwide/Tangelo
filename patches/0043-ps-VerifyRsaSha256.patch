+#include <algorithm>
 #include <cryptopp/aes.h>
+#include <cryptopp/integer.h>
 #include <cryptopp/modes.h>
+#include <cryptopp/nbtheory.h>
 #include "common/archives.h"
 #include "common/logging/log.h"
 #include "core/core.h"
@@ -40,6 +43,70 @@ constexpr std::array<u8, 10> KeyTypes{{
     HW::AES::DLPNFCDataKey,
 }};
 
+bool VerifyRsaSha256Pkcs1(std::span<const u8, 0x20> hash, std::span<const u8> modulus,
+                          std::span<const u8> exponent, std::span<const u8> signature) {
+    // DER DigestInfo prefix for SHA-256 (RFC 8017).
+    static constexpr std::array<u8, 19> DigestInfo{0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60,
+                                                   0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02,
+                                                   0x01, 0x05, 0x00, 0x04, 0x20};
+    const std::size_t size = modulus.size();
+    if (size < DigestInfo.size() + hash.size() + 11 || signature.size() != size) {
+        return false;
+    }
+    const CryptoPP::Integer n(modulus.data(), modulus.size());
+    const CryptoPP::Integer e(exponent.data(), exponent.size());
+    const CryptoPP::Integer sig(signature.data(), signature.size());
+    if (n.IsZero() || e.IsZero() || sig >= n) {
+        return false;
+    }
+    std::vector<u8> decoded(size);
+    CryptoPP::ModularExponentiation(sig, e, n).Encode(decoded.data(), decoded.size());
+
+    // 00 01 FF..FF 00 DigestInfo hash
+    std::vector<u8> expected(size, 0xFF);
+    expected[0] = 0x00;
+    expected[1] = 0x01;
+    const std::size_t digest_start = size - hash.size() - DigestInfo.size();
+    expected[digest_start - 1] = 0x00;
+    std::copy(DigestInfo.begin(), DigestInfo.end(), expected.begin() + digest_start);
+    std::copy(hash.begin(), hash.end(), expected.end() - hash.size());
+    return decoded == expected;
+}
+
+void PS_PS::VerifyRsaSha256(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    std::array<u8, 0x20> hash;
+    rp.PopRaw(hash);
+    [[maybe_unused]] const u32 signature_size = rp.Pop<u32>();
+    const std::vector<u8> context = rp.PopStaticBuffer();
+    auto& signature_buffer = rp.PopMappedBuffer();
+
+    // RSA context: modulus (0x100), exponent (0x100), u32 key size in bits, ...
+    constexpr std::size_t RsaBlockSize = 0x100;
+    bool valid = false;
+    if (context.size() >= 2 * RsaBlockSize) {
+        std::vector<u8> signature(RsaBlockSize);
+        signature_buffer.Read(signature.data(), 0,
+                              std::min<std::size_t>(signature.size(), signature_buffer.GetSize()));
+        valid =
+            VerifyRsaSha256Pkcs1(hash, std::span(context).first(RsaBlockSize),
+                                 std::span(context).subspan(RsaBlockSize, RsaBlockSize), signature);
+    }
+
+    // BOSS uses this to check the signatures in SpotPass files. The result is only logged:
+    // files from a custom SpotPass server (edited or new content) can't carry Nintendo's
+    // signature and must still be accepted.
+    if (valid) {
+        LOG_DEBUG(Service_PS, "RSA-SHA256 signature is valid");
+    } else {
+        LOG_INFO(Service_PS, "RSA-SHA256 signature doesn't match; accepted anyway");
+    }
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
+    rb.Push(ResultSuccess);
+    rb.PushMappedBuffer(signature_buffer);
+}
+
