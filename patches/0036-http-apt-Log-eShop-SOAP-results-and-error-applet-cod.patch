+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <cstring>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include "core/hle/applets/erreula.h"
+
+using HLE::Applets::DescribeErrEulaParam;
+using HLE::Applets::ErrEula;
+
+namespace {
+std::vector<u8> MakeParam(ErrEula::DisplayType type, s32 code, std::u16string_view text = {}) {
+    ErrEula::ErrEulaParam param{};
+    param.type = type;
+    param.error_code = code;
+    std::memcpy(param.message, text.data(), text.size() * sizeof(char16_t));
+    std::vector<u8> buffer(sizeof(param));
+    std::memcpy(buffer.data(), &param, sizeof(param));
+    return buffer;
+}
+} // namespace
+
+TEST_CASE("Error applet parameters are described", "[applets][erreula]") {
+    CHECK(DescribeErrEulaParam(MakeParam(ErrEula::DisplayType::ErrorCode, 55928)) ==
+          "error code 005-5928");
+    CHECK(DescribeErrEulaParam(MakeParam(ErrEula::DisplayType::ErrorCode, 22)) ==
+          "error code 000-0022");
+    CHECK(DescribeErrEulaParam(MakeParam(ErrEula::DisplayType::Error, 0, u"Line one\nline two")) ==
+          "error text \"Line one line two\" (code 000-0000)");
+    CHECK_FALSE(DescribeErrEulaParam(MakeParam(ErrEula::DisplayType::Agree, 0)));
+
+    auto short_buffer = MakeParam(ErrEula::DisplayType::ErrorCode, 55928);
+    short_buffer.resize(0x100);
+    CHECK_FALSE(DescribeErrEulaParam(short_buffer));
+}
