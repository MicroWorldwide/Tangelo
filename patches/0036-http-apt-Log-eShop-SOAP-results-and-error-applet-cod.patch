+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace Service::HTTP {
+
+/// The parts of a SOAP reply (eShop ECS/IAS/CAS, NUS) that explain a failure.
+struct SoapResult {
+    std::string operation; ///< First element in the SOAP body, e.g. "GetRegistrationInfoResponse"
+    std::optional<long> error_code; ///< <ErrorCode>, 0 means success
+    std::string error_message;      ///< <ErrorMessage>, if present
+};
+
+/// Returns the operation, ErrorCode and ErrorMessage of a SOAP reply, or nullopt if `body` isn't a
+/// SOAP envelope. Namespace prefixes on the element names are ignored.
+std::optional<SoapResult> ParseSoapResult(std::string_view body);
+
+} // namespace Service::HTTP
