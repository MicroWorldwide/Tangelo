+
+void Context::LogSoapResult() const {
+    if (state != RequestState::ReceivingBody) {
+        return;
+    }
+    // eShop (ECS/IAS/CAS) and system update (NUS) servers answer HTTP 200 and put the real
+    // result in the SOAP body, so the status code alone doesn't show why a title gave up.
+    const auto content_type = response.get_header_value("Content-Type");
+    if (content_type.find("xml") == std::string::npos) {
+        return;
+    }
+    const auto result = ParseSoapResult(response.body);
+    if (!result) {
+        return;
+    }
+    const std::string where = Common::SplitUrl(url).path;
+    if (result->error_code.value_or(0) == 0 && result->error_message.empty()) {
+        LOG_INFO(Service_HTTP, "SOAP {} {}: HTTP {}, ErrorCode {}", where, result->operation,
+                 response.status, result->error_code.value_or(0));
+        return;
+    }
+    LOG_WARNING(Service_HTTP, "SOAP {} {}: HTTP {}, ErrorCode {}, ErrorMessage \"{}\"", where,
+                result->operation, response.status,
+                result->error_code ? std::to_string(*result->error_code) : "none",
+                result->error_message);
 }
 
 void Context::MakeRequestNonSSL(httplib::Request& request, const Common::URLInfo& url_info,
