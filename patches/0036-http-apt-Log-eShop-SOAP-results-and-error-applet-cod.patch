+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <catch2/catch_test_macros.hpp>
+#include "core/hle/service/http/soap_result.h"
+
+using Service::HTTP::ParseSoapResult;
+
+TEST_CASE("SOAP replies: success", "[service][http][soap]") {
+    const auto result = ParseSoapResult(
+        R"(<?xml version="1.0" encoding="utf-8"?>)"
+        R"(<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/">)"
+        R"(<soapenv:Body><GetAccountStatusResponse xmlns="urn:ecs.wsapi.broadon.com">)"
+        R"(<Version>2.0</Version><DeviceId>1</DeviceId><MessageId>x</MessageId>)"
+        R"(<TimeStamp>1</TimeStamp><ErrorCode>0</ErrorCode><ServiceStandbyMode>false)"
+        R"(</ServiceStandbyMode></GetAccountStatusResponse></soapenv:Body></soapenv:Envelope>)");
+    REQUIRE(result);
+    CHECK(result->operation == "GetAccountStatusResponse");
+    REQUIRE(result->error_code);
+    CHECK(*result->error_code == 0);
+    CHECK(result->error_message.empty());
+}
+
+TEST_CASE("SOAP replies: error code and message", "[service][http][soap]") {
+    const auto result = ParseSoapResult(
+        "<SOAP-ENV:Envelope xmlns:SOAP-ENV=\"http://schemas.xmlsoap.org/soap/envelope/\">\n"
+        "  <SOAP-ENV:Body>\n"
+        "    <ias:GetRegistrationInfoResponse xmlns:ias=\"urn:ias.wsapi.broadon.com\">\n"
+        "      <ias:ErrorCode> 928 </ias:ErrorCode>\n"
+        "      <ias:ErrorMessage>IAS - Device token mismatch</ias:ErrorMessage>\n"
+        "    </ias:GetRegistrationInfoResponse>\n"
+        "  </SOAP-ENV:Body>\n"
+        "</SOAP-ENV:Envelope>\n");
+    REQUIRE(result);
+    CHECK(result->operation == "GetRegistrationInfoResponse");
+    REQUIRE(result->error_code);
+    CHECK(*result->error_code == 928);
+    CHECK(result->error_message == "IAS - Device token mismatch");
+}
+
+TEST_CASE("SOAP replies: faults and odd content", "[service][http][soap]") {
+    const auto fault = ParseSoapResult(
+        "<env:Envelope><env:Body><env:Fault><faultcode>env:Server</faultcode>"
+        "<faultstring>Internal error</faultstring></env:Fault></env:Body></env:Envelope>");
+    REQUIRE(fault);
+    CHECK(fault->operation == "Fault");
+    CHECK_FALSE(fault->error_code);
+    CHECK(fault->error_message == "Internal error");
+
+    // Elements whose names only end in "ErrorCode" don't count.
+    const auto other = ParseSoapResult("<Envelope><Body><R><NotErrorCode>5</NotErrorCode>"
+                                       "<ErrorCode/></R></Body></Envelope>");
+    REQUIRE(other);
+    CHECK_FALSE(other->error_code);
+
+    CHECK_FALSE(ParseSoapResult(""));
+    CHECK_FALSE(ParseSoapResult(R"({"json": true})"));
+    CHECK_FALSE(ParseSoapResult("<html><body>Not SOAP</body></html>"));
+}
