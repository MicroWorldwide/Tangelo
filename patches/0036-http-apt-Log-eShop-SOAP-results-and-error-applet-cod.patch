new file mode 100644
index 0000000..d2e98fe
--- /dev/null
+++ b/src/core/hle/service/http/soap_result.cpp
@@ -0,0 +1,126 @@
+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <cstdlib>
+#include "core/hle/service/http/soap_result.h"
+
+namespace Service::HTTP {
+
+namespace {
+
+bool IsNameChar(char c) {
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' ||
+           c == '-' || c == '.';
+}
+
+/// Finds the opening tag <name> or <prefix:name> (or the empty element <name/>) at or after
+/// `from`. Returns the position just past the tag's '>', or npos.
+std::size_t FindOpeningTag(std::string_view body, std::string_view name, std::size_t from = 0) {
+    for (std::size_t pos = body.find(name, from); pos != std::string_view::npos;
+         pos = body.find(name, pos + 1)) {
+        if (pos == 0) {
+            continue;
+        }
+        const char before = body[pos - 1];
+        if (before == ':') {
+            // <prefix:name>
+            std::size_t p = pos - 1;
+            while (p > 0 && IsNameChar(body[p - 1])) {
+                --p;
+            }
+            if (p == 0 || p == pos - 1 || body[p - 1] != '<') {
+                continue;
+            }
+        } else if (before != '<') {
+            continue;
+        }
+        const std::size_t after = pos + name.size();
+        if (after >= body.size()) {
+            return std::string_view::npos;
+        }
+        const char next = body[after];
+        if (next != '>' && next != ' ' && next != '\t' && next != '\r' && next != '\n' &&
+            next != '/') {
+            continue;
+        }
+        const std::size_t close = body.find('>', after);
+        if (close == std::string_view::npos) {
+            return std::string_view::npos;
+        }
+        return close + 1;
+    }
+    return std::string_view::npos;
+}
+
+std::optional<std::string> ElementText(std::string_view body, std::string_view name) {
+    const std::size_t start = FindOpeningTag(body, name);
+    if (start == std::string_view::npos) {
+        return std::nullopt;
+    }
+    if (body[start - 2] == '/') {
+        return std::string{};
+    }
+    const std::size_t end = body.find('<', start);
+    if (end == std::string_view::npos) {
+        return std::nullopt;
+    }
+    std::string_view text = body.substr(start, end - start);
+    while (!text.empty() && (text.front() == ' ' || text.front() == '\n' || text.front() == '\r' ||
+                             text.front() == '\t')) {
+        text.remove_prefix(1);
+    }
+    while (!text.empty() && (text.back() == ' ' || text.back() == '\n' || text.back() == '\r' ||
+                             text.back() == '\t')) {
+        text.remove_suffix(1);
+    }
+    return std::string(text);
+}
+
+} // namespace
+
+std::optional<SoapResult> ParseSoapResult(std::string_view body) {
+    if (FindOpeningTag(body, "Envelope") == std::string_view::npos) {
+        return std::nullopt;
+    }
+    const std::size_t body_start = FindOpeningTag(body, "Body");
+    if (body_start == std::string_view::npos) {
+        return std::nullopt;
+    }
+
+    SoapResult result;
+
+    // The operation is the first element inside the Body.
+    const std::size_t op = body.find('<', body_start);
+    if (op != std::string_view::npos && op + 1 < body.size() && body[op + 1] != '/') {
+        std::size_t name_end = op + 1;
+        while (name_end < body.size() && (IsNameChar(body[name_end]) || body[name_end] == ':')) {
+            ++name_end;
+        }
+        std::string_view name = body.substr(op + 1, name_end - op - 1);
+        if (const std::size_t colon = name.rfind(':'); colon != std::string_view::npos) {
+            name.remove_prefix(colon + 1);
+        }
+        result.operation = std::string(name);
+    }
+
+    if (const auto code = ElementText(body.substr(body_start), "ErrorCode")) {
+        char* end = nullptr;
+        const long value = std::strtol(code->c_str(), &end, 10);
+        if (!code->empty() && end == code->c_str() + code->size()) {
+            result.error_code = value;
+        }
+    }
+    if (auto message = ElementText(body.substr(body_start), "ErrorMessage")) {
+        result.error_message = std::move(*message);
+    }
+    // SOAP faults carry a <faultstring> instead.
+    if (result.error_message.empty()) {
+        if (auto fault = ElementText(body.substr(body_start), "faultstring")) {
+            result.error_message = std::move(*fault);
+        }
+    }
+    return result;
+}
+
+} // namespace Service::HTTP
