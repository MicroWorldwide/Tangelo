@@ -2,6 +2,8 @@
 // Licensed under GPLv2 or any later version
 // Refer to the license.txt file included.
 
+#include <cstring>
+#include <fmt/format.h>
 #include "common/string_util.h"
 #include "core/core.h"
 #include "core/hle/applets/erreula.h"
@@ -65,4 +67,43 @@ Result ErrEula::Finalize() {
 
 void ErrEula::Update() {}
 
+std::optional<std::string> DescribeErrEulaParam(std::span<const u8> param) {
+    ErrEula::ErrEulaParam info;
+    if (param.size() < sizeof(info)) {
+        return std::nullopt;
+    }
+    std::memcpy(&info, param.data(), sizeof(info));
+
+    // Shown as "XXX-YYYY": the module number, then the description within that module.
+    const auto code = static_cast<u32>(info.error_code);
+    const std::string code_text = fmt::format("{:03}-{:04}", code / 10000 % 1000, code % 10000);
+
+    std::size_t length = 0;
+    while (length < ErrEula::ErrEulaParam::MESSAGE_SIZE && info.message[length] != u'\0') {
+        ++length;
+    }
+    constexpr std::size_t max_logged_chars = 400;
+    std::string message =
+        Common::UTF16ToUTF8(std::u16string(info.message, std::min(length, max_logged_chars)));
+    for (char& c : message) {
+        if (c == '\n' || c == '\r') {
+            c = ' ';
+        }
+    }
+
+    switch (info.type) {
+    case ErrEula::DisplayType::ErrorCode:
+        return fmt::format("error code {}", code_text);
+    case ErrEula::DisplayType::Error:
+        return fmt::format("error text \"{}\" (code {})", message, code_text);
+    default:
+        // Language-specific error codes and EULA screens use other type values.
+        if (static_cast<u8>(info.type) >= 2 && static_cast<u8>(info.type) <= 5) {
+            return std::nullopt;
+        }
+        return fmt::format("type {}, error code {}{}", static_cast<u8>(info.type), code_text,
+                           message.empty() ? "" : fmt::format(", text \"{}\"", message));
+    }
+}
+
 } // namespace HLE::Applets
