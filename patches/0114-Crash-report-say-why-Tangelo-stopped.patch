+++ b/src/common/crash_report.cpp
@@ -0,0 +1,161 @@
+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the misc/licenses/gplv2.txt file included.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <exception>
+#include <string>
+#include <thread>
+#include <fmt/format.h>
+#include "common/crash_report.h"
+#include "common/file_util.h"
+#include "common/logging/backend.h"
+#include "common/logging/log.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace Common {
+
+namespace {
+
+std::atomic_flag reporting = ATOMIC_FLAG_INIT;
+
+/// The call stack as "module+0xoffset" lines (Windows), so a crash can be matched to the code
+/// with the same tangelo.exe.
+std::string Backtrace() {
+    std::string out;
+#ifdef _WIN32
+    void* frames[48];
+    const USHORT count = RtlCaptureStackBackTrace(2, 48, frames, nullptr);
+    for (USHORT i = 0; i < count; ++i) {
+        HMODULE module = nullptr;
+        char name[MAX_PATH] = "?";
+        if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                   GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                               static_cast<LPCSTR>(frames[i]), &module) &&
+            module) {
+            char path[MAX_PATH];
+            if (GetModuleFileNameA(module, path, MAX_PATH)) {
+                const char* base = path;
+                for (const char* p = path; *p; ++p) {
+                    if (*p == '\\' || *p == '/') {
+                        base = p + 1;
+                    }
+                }
+                snprintf(name, sizeof(name), "%s", base);
+            }
+        }
+        const auto offset = reinterpret_cast<uintptr_t>(frames[i]) -
+                            reinterpret_cast<uintptr_t>(module);
+        out += fmt::format("  #{:02} {}+0x{:X}\n", i, name, module ? offset : 0);
+    }
+#else
+    out = "  (call stack only on Windows)\n";
+#endif
+    return out;
+}
+
+[[noreturn]] void Report(const std::string& what) {
+    if (!reporting.test_and_set()) {
+        const std::string text = fmt::format("Tangelo stopped: {}\nCall stack:\n{}", what,
+                                             Backtrace());
+        const std::string path =
+            FileUtil::GetUserPath(FileUtil::UserPath::LogDir) + "tangelo_crash.txt";
+        if (std::FILE* file = std::fopen(path.c_str(), "w")) {
+            std::fputs(text.c_str(), file);
+            std::fclose(file);
+        }
+        LOG_CRITICAL(Debug, "{}", text);
+        // Write out what is still queued, including the lines above; on another thread and at
+        // most 3 seconds, in case the crash left the log itself stuck.
+        std::atomic<bool> done{false};
+        std::thread([&done] {
+            Common::Log::Stop();
+            done = true;
+        }).detach();
+        for (int i = 0; i < 300 && !done; ++i) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+    }
+#ifdef _WIN32
+    TerminateProcess(GetCurrentProcess(), 3);
+#endif
+    std::_Exit(3);
+}
+
+void OnTerminate() {
+    std::string what = "std::terminate";
+    if (const auto exception = std::current_exception()) {
+        try {
+            std::rethrow_exception(exception);
+        } catch (const std::exception& e) {
+            what = fmt::format("uncaught exception: {}", e.what());
+        } catch (...) {
+            what = "uncaught exception of unknown type";
+        }
+    } else {
+        what = "std::terminate without an exception (e.g. a running std::thread destroyed)";
+    }
+    Report(what);
+}
+
+void OnAbort(int) {
+    Report("abort()");
+}
+
+#ifdef _WIN32
+void OnInvalidParameter(const wchar_t*, const wchar_t*, const wchar_t*, unsigned int, uintptr_t) {
+    Report("invalid argument passed to a C runtime function");
+}
+
+LONG WINAPI OnException(EXCEPTION_POINTERS* info) {
+    const auto* record = info->ExceptionRecord;
+    // Reached only for exceptions nobody handled (the JIT's own fast-memory faults are handled
+    // before this); C++ exceptions and debugger events pass through.
+    switch (record->ExceptionCode) {
+    case EXCEPTION_ACCESS_VIOLATION:
+    case EXCEPTION_ILLEGAL_INSTRUCTION:
+    case EXCEPTION_INT_DIVIDE_BY_ZERO:
+    case EXCEPTION_STACK_OVERFLOW:
+    case EXCEPTION_PRIV_INSTRUCTION: {
+        HMODULE module = nullptr;
+        char path[MAX_PATH] = "?";
+        GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                               GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           static_cast<LPCSTR>(record->ExceptionAddress), &module);
+        if (module) {
+            GetModuleFileNameA(module, path, MAX_PATH);
+        }
+        Report(fmt::format(
+            "exception 0x{:08X} at {}+0x{:X} (address 0x{:X})", record->ExceptionCode, path,
+            reinterpret_cast<uintptr_t>(record->ExceptionAddress) -
+                reinterpret_cast<uintptr_t>(module),
+            record->NumberParameters > 1 ? record->ExceptionInformation[1] : 0));
+    }
+    default:
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+}
+#endif
+
+} // namespace
+
+void InstallCrashHandlers() {
+    std::set_terminate(OnTerminate);
+    std::signal(SIGABRT, OnAbort);
+#ifdef _WIN32
+    _set_invalid_parameter_handler(OnInvalidParameter);
+    // Don't let abort() go straight to Windows Error Reporting before the handler runs.
+    _set_abort_behavior(0, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);
+    SetUnhandledExceptionFilter(OnException);
+#endif
+}
+
+} // namespace Common
diff --git a/src/common/crash_report.h b/src/common/crash_report.h
new file mode 100644
index 000000000..68d65f16f
--- /dev/null
+++ b/src/common/crash_report.h
@@ -0,0 +1,17 @@
+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the misc/licenses/gplv2.txt file included.
+
+#pragma once
+
+namespace Common {
+
+/// When Tangelo itself goes down (an uncaught C++ exception, std::terminate, abort, an invalid
+/// argument to a C runtime function or, on Windows, an access violation), write what happened
+/// and the call stack (module + offset) to the log and to log/tangelo_crash.txt, finish writing
+/// the log, and only then end. Without this the window just closes and the last log lines are
+/// lost (2026-10-16: crash a few seconds after a game returned to the HOME Menu, Windows only
+/// reported ucrtbase.dll 0xC0000409).
+void InstallCrashHandlers();
+
+} // namespace Common
