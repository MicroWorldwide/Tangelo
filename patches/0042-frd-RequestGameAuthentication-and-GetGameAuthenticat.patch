+namespace {
+constexpr std::string_view NascUrl = "https://nasc.nintendowifi.net/ac";
+
+/// NASC LOGIN at the Nintendo services server, if one is set for the game server login.
+/// Nintendo's own NASC isn't asked: its 3DS game servers are gone, so it answers 110 anyway.
+GameAuthenticationData RequestNascLogin(u32 game_id, u64 title_id, u32 sdk_major, u32 sdk_minor,
+                                        const std::string& ingame_name) {
+    if (!Settings::values.use_nintendo_services_server.GetValue() ||
+        !Settings::values.nintendo_services_nasc.GetValue()) {
+        LOG_INFO(Service_FRD,
+                 "Game server login for {:08X}: Nintendo's 3DS game servers are closed, "
+                 "answering 110 (set a Nintendo services server to ask it instead)",
+                 game_id);
+        return MakeFailedGameAuthentication(NascResultServerGone, 0);
+    }
+    const auto url = HTTP::RedirectNintendoServiceUrl(
+        NascUrl, Settings::values.nintendo_services_server_url.GetValue());
+    if (!url) {
+        LOG_WARNING(Service_FRD, "Nintendo services server address is empty or invalid");
+        return MakeFailedGameAuthentication(NascResultServerGone, 0);
+    }
+
+    const std::string game_id_text = fmt::format("{:08X}", game_id);
+    const std::string body = MakeNascForm({
+        {"action", "LOGIN"},
+        {"gameid", game_id_text},
+        {"sdkver", fmt::format("{:03}{:03}", sdk_major % 1000, sdk_minor % 1000)},
+        {"titleid", fmt::format("{:016X}", title_id)},
+        {"gamecd", "----"},
+        {"unitcd", "2"},
+        {"servertype", "L1"},
+        {"fpdver", "0010"},
+        {"ingamesn", ingame_name},
+    });
+
+    const Common::URLInfo info = Common::SplitUrl(*url);
+    std::unique_ptr<httplib::ClientImpl> client;
+    if (info.is_https) {
+        auto ssl_client = std::make_unique<httplib::SSLClient>(info.host, info.port);
+        ssl_client->enable_server_certificate_verification(false);
+        client = std::move(ssl_client);
+    } else {
+        client = std::make_unique<httplib::ClientImpl>(info.host, info.port);
+    }
+    client->set_connection_timeout(5);
+    client->set_read_timeout(10);
+    const httplib::Headers headers{
+        {"X-GameId", game_id_text},
+        {"User-Agent", "CTR FPD/0010"},
+        {"X-Tangelo-Original-Host", "nasc.nintendowifi.net"},
+    };
+    const auto response = client->Post(info.path.empty() ? "/ac" : info.path, headers, body,
+                                       "application/x-www-form-urlencoded");
+    if (!response) {
+        LOG_WARNING(Service_FRD, "Game server login for {:08X}: {} unreachable ({}), answering 110",
+                    game_id, *url, httplib::to_string(response.error()));
+        return MakeFailedGameAuthentication(NascResultServerGone, 0);
+    }
+    if (response->status != 200) {
+        LOG_WARNING(Service_FRD, "Game server login for {:08X}: HTTP {}", game_id,
+                    response->status);
+        return MakeFailedGameAuthentication(NascResultServerGone, response->status);
+    }
+    const auto data =
+        MakeGameAuthenticationData(ParseNascResponse(response->body), response->status);
+    if (data.result == NascResultSuccess) {
+        LOG_INFO(Service_FRD, "Game server login for {:08X}: server {}:{}", game_id,
+                 data.server_address.data(), static_cast<u16>(data.server_port));
+    } else {
+        LOG_INFO(Service_FRD, "Game server login for {:08X}: returncd {:03}", game_id,
+                 static_cast<s32>(data.result));
+    }
+    return data;
+}
+} // namespace
+
+void Module::Interface::RequestGameAuthentication(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 game_id = rp.Pop<u32>();
+    const auto ingame_sn = rp.PopRaw<std::array<u16_le, 12>>();
+    const u32 sdk_major = rp.Pop<u32>();
+    const u32 sdk_minor = rp.Pop<u32>();
+    rp.PopPID();
+    const auto event = rp.PopObject<Kernel::Event>();
+
+    struct AsyncData {
+        u32 game_id;
+        u64 title_id;
+        u32 sdk_major;
+        u32 sdk_minor;
+        std::string ingame_name;
+        std::shared_ptr<Kernel::Event> event;
+        GameAuthenticationData data{};
+    };
+    auto async_data = std::make_shared<AsyncData>();
+    async_data->game_id = game_id;
+    async_data->title_id = frd->system.Kernel().GetCurrentProcess()->codeset->program_id;
+    async_data->sdk_major = sdk_major;
+    async_data->sdk_minor = sdk_minor;
+    async_data->ingame_name = Common::UTF16BufferToUTF8(ingame_sn);
+    async_data->event = event;
+
+    LOG_DEBUG(Service_FRD, "called, game_id={:08X}, title_id={:016X}", game_id,
+              async_data->title_id);
+
+    ctx.RunAsync(
+        [async_data](Kernel::HLERequestContext&) {
+            async_data->data =
+                RequestNascLogin(async_data->game_id, async_data->title_id, async_data->sdk_major,
+                                 async_data->sdk_minor, async_data->ingame_name);
+            return 0;
+        },
+        [this, async_data](Kernel::HLERequestContext& ctx) {
+            frd->game_authentication_data = async_data->data;
+            if (async_data->event) {
+                async_data->event->Signal();
+            }
+            IPC::RequestBuilder rb(ctx, 1, 0);
+            rb.Push(ResultSuccess);
+        },
+        true);
+}
+
+void Module::Interface::GetGameAuthenticationData(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+
+    std::vector<u8> buffer(sizeof(GameAuthenticationData));
+    std::memcpy(buffer.data(), &frd->game_authentication_data, buffer.size());
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
+    rb.Push(ResultSuccess);
+    rb.PushStaticBuffer(std::move(buffer), 0);
+
+    LOG_DEBUG(Service_FRD, "called, result={}",
+              static_cast<s32>(frd->game_authentication_data.result));
+}
+
 Module::Module(Core::System& system) : system(system) {};
 Module::~Module() = default;
 
