@@ -0,0 +1,197 @@
+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <algorithm>
+#include <cctype>
+#include <cstdlib>
+#include <cstring>
+#include "core/hle/service/frd/nasc_client.h"
+
+namespace Service::FRD {
+
+namespace {
+constexpr std::string_view Alphabet =
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.-";
+
+int AlphabetIndex(char c) {
+    // Accept standard base64 too.
+    if (c == '+') {
+        return 62;
+    }
+    if (c == '/') {
+        return 63;
+    }
+    const auto pos = Alphabet.find(c);
+    return pos == std::string_view::npos ? -1 : static_cast<int>(pos);
+}
+
+std::string UrlEncode(std::string_view text) {
+    static constexpr char hex[] = "0123456789ABCDEF";
+    std::string out;
+    for (const unsigned char c : text) {
+        if (std::isalnum(c) || c == '-' || c == '.' || c == '_' || c == '~') {
+            out.push_back(static_cast<char>(c));
+        } else {
+            out.push_back('%');
+            out.push_back(hex[c >> 4]);
+            out.push_back(hex[c & 0xF]);
+        }
+    }
+    return out;
+}
+
+std::string UrlDecode(std::string_view text) {
+    std::string out;
+    for (std::size_t i = 0; i < text.size(); i++) {
+        if (text[i] == '%' && i + 2 < text.size()) {
+            const std::string hex(text.substr(i + 1, 2));
+            char* end = nullptr;
+            const long value = std::strtol(hex.c_str(), &end, 16);
+            if (end == hex.c_str() + 2) {
+                out.push_back(static_cast<char>(value));
+                i += 2;
+                continue;
+            }
+        }
+        out.push_back(text[i] == '+' ? ' ' : text[i]);
+    }
+    return out;
+}
+
+template <std::size_t N>
+void CopyString(std::array<char, N>& out, std::string_view text) {
+    out.fill(0);
+    std::memcpy(out.data(), text.data(), std::min(text.size(), N - 1));
+}
+} // namespace
+
+std::string NascEncode(std::string_view value) {
+    std::string out;
+    std::size_t i = 0;
+    for (; i + 2 < value.size(); i += 3) {
+        const u32 n = (static_cast<u8>(value[i]) << 16) | (static_cast<u8>(value[i + 1]) << 8) |
+                      static_cast<u8>(value[i + 2]);
+        out += Alphabet[(n >> 18) & 63];
+        out += Alphabet[(n >> 12) & 63];
+        out += Alphabet[(n >> 6) & 63];
+        out += Alphabet[n & 63];
+    }
+    const std::size_t rest = value.size() - i;
+    if (rest == 1) {
+        const u32 n = static_cast<u8>(value[i]) << 16;
+        out += Alphabet[(n >> 18) & 63];
+        out += Alphabet[(n >> 12) & 63];
+        out += "**";
+    } else if (rest == 2) {
+        const u32 n = (static_cast<u8>(value[i]) << 16) | (static_cast<u8>(value[i + 1]) << 8);
+        out += Alphabet[(n >> 18) & 63];
+        out += Alphabet[(n >> 12) & 63];
+        out += Alphabet[(n >> 6) & 63];
+        out += '*';
+    }
+    return out;
+}
+
+std::string NascDecode(std::string_view value) {
+    std::string out;
+    u32 buffer = 0;
+    int bits = 0;
+    for (const char c : value) {
+        if (c == '*' || c == '=') {
+            break;
+        }
+        const int index = AlphabetIndex(c);
+        if (index < 0) {
+            continue;
+        }
+        buffer = (buffer << 6) | static_cast<u32>(index);
+        bits += 6;
+        if (bits >= 8) {
+            bits -= 8;
+            out.push_back(static_cast<char>((buffer >> bits) & 0xFF));
+        }
+    }
+    return out;
+}
+
+std::string MakeNascForm(const std::map<std::string, std::string>& fields) {
+    std::string out;
+    for (const auto& [key, value] : fields) {
+        if (!out.empty()) {
+            out += '&';
+        }
+        out += key;
+        out += '=';
+        out += UrlEncode(NascEncode(value));
+    }
+    return out;
+}
+
+std::map<std::string, std::string> ParseNascResponse(std::string_view body) {
+    std::map<std::string, std::string> fields;
+    while (!body.empty()) {
+        const auto amp = body.find('&');
+        const std::string_view pair = body.substr(0, amp);
+        const auto eq = pair.find('=');
+        if (eq != std::string_view::npos) {
+            std::string key(pair.substr(0, eq));
+            key.erase(std::remove_if(key.begin(), key.end(),
+                                     [](unsigned char c) { return std::isspace(c); }),
+                      key.end());
+            fields[key] = NascDecode(UrlDecode(pair.substr(eq + 1)));
+        }
+        if (amp == std::string_view::npos) {
+            break;
+        }
+        body.remove_prefix(amp + 1);
+    }
+    return fields;
+}
+
+GameAuthenticationData MakeFailedGameAuthentication(s32 result, s32 http_status) {
+    GameAuthenticationData data{};
+    data.result = result;
+    data.http_status_code = http_status;
+    return data;
+}
+
+GameAuthenticationData MakeGameAuthenticationData(const std::map<std::string, std::string>& fields,
+                                                  s32 http_status) {
+    const auto returncd = fields.find("returncd");
+    s32 result = NascResultServerGone;
+    if (returncd != fields.end()) {
+        char* end = nullptr;
+        const long value = std::strtol(returncd->second.c_str(), &end, 10);
+        if (end != returncd->second.c_str()) {
+            result = static_cast<s32>(value);
+        }
+    }
+    GameAuthenticationData data = MakeFailedGameAuthentication(result, http_status);
+    if (result != NascResultSuccess) {
+        return data;
+    }
+
+    const auto locator = fields.find("locator");
+    if (locator != fields.end()) {
+        const std::string& text = locator->second;
+        const auto colon = text.rfind(':');
+        CopyString(data.server_address, text.substr(0, colon));
+        if (colon != std::string::npos) {
+            data.server_port =
+                static_cast<u16>(std::strtoul(text.c_str() + colon + 1, nullptr, 10));
+        }
+    }
+    const auto token = fields.find("token");
+    if (token != fields.end()) {
+        CopyString(data.token, token->second);
+    }
+    const auto datetime = fields.find("datetime");
+    if (datetime != fields.end()) {
+        // "%Y%m%d%H%M%S"; kept as that number (how the real module stores it is unverified).
+        data.server_time = std::strtoull(datetime->second.c_str(), nullptr, 10);
+    }
+    return data;
+}
+
+} // namespace Service::FRD
