+
+#include <string>
+#include <catch2/catch_test_macros.hpp>
+#include "core/hle/service/frd/nasc_client.h"
+
+using namespace Service::FRD;
+
+// Examples from https://github.com/kinnay/NintendoClients/wiki/NASC-Server
+TEST_CASE("NASC values use base64 with .-*", "[service][frd][nasc]") {
+    CHECK(NascEncode("00030600") == "MDAwMzA2MDA*");
+    CHECK(NascEncode("LOGIN") == "TE9HSU4*");
+    CHECK(NascEncode("0004000000030700") == "MDAwNDAwMDAwMDAzMDcwMA**");
+    CHECK(NascEncode("000") == "MDAw");
+    CHECK(NascDecode("MzUuMTYzLjIuODk6NDA0NjA*") == "35.163.2.89:40460");
+    CHECK(NascDecode(NascEncode(std::string("\xFB\xEF\xBE", 3))) == "\xFB\xEF\xBE");
+    CHECK(NascEncode(std::string("\xFB\xEF\xBE", 3)) == "...."); // "++++" in base64
+    CHECK(NascEncode(std::string("\xFF\xFF\xFF", 3)) == "----"); // "////"
+    CHECK(MakeNascForm({{"action", "LOGIN"}, {"gameid", "00030600"}}) ==
+          "action=TE9HSU4%2A&gameid=MDAwMzA2MDA%2A");
+}
+
+TEST_CASE("NASC LOGIN responses", "[service][frd][nasc]") {
+    const auto ok = ParseNascResponse(
+        "locator=MzUuMTYzLjIuODk6NDA0NjA*&retry=MA**&returncd=MDAx&token=dGVzdA**&datetime="
+        "MjAyMjAxMTgxMDUwMzc*");
+    CHECK(ok.at("locator") == "35.163.2.89:40460");
+    CHECK(ok.at("returncd") == "001");
+    CHECK(ok.at("datetime") == "20220118105037");
+
+    const auto data = MakeGameAuthenticationData(ok, 200);
+    CHECK(data.result == NascResultSuccess);
+    CHECK(data.http_status_code == 200);
+    CHECK(std::string(data.server_address.data()) == "35.163.2.89");
+    CHECK(data.server_port == 40460);
+    CHECK(std::string(data.token.data()) == "test");
+    CHECK(data.server_time == 20220118105037ULL);
+
+    // "Game server no longer available" (what the Tangelo server answers by default).
+    const auto gone = MakeGameAuthenticationData(
+        ParseNascResponse("retry=MA**&returncd=MTEw&datetime=MjAyNjA5MzAxOTI4MTk*"), 200);
+    CHECK(gone.result == NascResultServerGone);
+    CHECK(gone.server_address[0] == 0);
+    CHECK(gone.server_port == 0);
+
+    // No returncd at all: treated as gone.
+    CHECK(MakeGameAuthenticationData({}, 200).result == NascResultServerGone);
+
+    const auto failed = MakeFailedGameAuthentication(NascResultServerGone, 0);
+    CHECK(failed.result == 110);
+    CHECK(failed.http_status_code == 0);
+}
