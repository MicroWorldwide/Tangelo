+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <array>
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+#include "common/common_funcs.h"
+#include "common/common_types.h"
+#include "common/swap.h"
+
+namespace Service::FRD {
+
+/// NASC "game server not available any more", the answer since Nintendo's 3DS servers closed.
+constexpr s32 NascResultServerGone = 110;
+constexpr s32 NascResultSuccess = 1;
+
+/// frd GetGameAuthenticationData output (libctru GameAuthenticationData).
+struct GameAuthenticationData {
+    s32_le result;           ///< NASC returncd (1 = success, 110 = game server gone, ...)
+    s32_le http_status_code; ///< HTTP status of the NASC request, 0 if none was made
+    std::array<char, 0x20> server_address;
+    u16_le server_port;
+    INSERT_PADDING_BYTES(2);
+    INSERT_PADDING_BYTES(4);
+    std::array<char, 0x100> token;
+    u64_le server_time;
+};
+static_assert(sizeof(GameAuthenticationData) == 0x138, "GameAuthenticationData has the wrong size");
+
+/// NASC form values: base64 with "+/=" replaced by ".-*".
+std::string NascEncode(std::string_view value);
+std::string NascDecode(std::string_view value);
+
+/// URL-encoded NASC request body for these fields.
+std::string MakeNascForm(const std::map<std::string, std::string>& fields);
+
+/// Decodes a NASC response ("locator=...&returncd=...&...").
+std::map<std::string, std::string> ParseNascResponse(std::string_view body);
+
+/// Turns a decoded NASC LOGIN response into what the game reads.
+GameAuthenticationData MakeGameAuthenticationData(const std::map<std::string, std::string>& fields,
+                                                  s32 http_status);
+
+/// A failed login with this NASC result (e.g. 110) and HTTP status.
+GameAuthenticationData MakeFailedGameAuthentication(s32 result, s32 http_status);
+
+} // namespace Service::FRD
