+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <cstring>
+#include <catch2/catch_test_macros.hpp>
+#include "core/hle/service/boss/boss_storage.h"
+
+using namespace Service::BOSS;
+
+namespace {
+constexpr u64 Dmw1 = 0x00040000000EA900;
+constexpr u64 Other = 0x0004000000055D00;
+
+template <typename T>
+T At(const std::vector<u8>& db, std::size_t offset) {
+    T value;
+    std::memcpy(&value, db.data() + offset, sizeof(T));
+    return value;
+}
+} // namespace
+
+TEST_CASE("BOSS_A.db: registering storage creates a documented entry", "[service][boss]") {
+    std::vector<u8> db;
+    const StorageInfo info{.extdata_id = 0xEA9, .size = 0x100000, .media_type = 1};
+
+    CHECK_FALSE(BossA::FindStorage(db, Dmw1));
+    REQUIRE(BossA::SetStorage(db, Dmw1, info));
+    REQUIRE(db.size() == BossA::HeaderSize + BossA::EntrySize);
+
+    // Header and layout from https://www.3dbrew.org/wiki/BOSS_Savegame
+    CHECK(At<u32>(db, 0) == 0x12348000);
+    constexpr std::size_t e = BossA::HeaderSize;
+    CHECK(At<u64>(db, e + 0x0) == Dmw1);  // entry header: program ID
+    CHECK(db[e + 0x8] == 1);              // valid
+    CHECK(db[e + 0x9] == 3);              // version
+    CHECK(At<u64>(db, e + 0x10) == Dmw1); // title info: program ID
+    CHECK(db[e + 0x18] == 1);             // session maker: user
+    CHECK(db[e + 0x20] == 1);             // storage: registered
+    CHECK(db[e + 0x21] == 1);             // media type SD
+    CHECK(At<u32>(db, e + 0x24) == 0x100000);
+    CHECK(At<u64>(db, e + 0x28) == 0xEA9);
+
+    CHECK(BossA::FindStorage(db, Dmw1) == info);
+    CHECK_FALSE(BossA::FindStorage(db, Other));
+}
+
+TEST_CASE("BOSS_A.db: updating, unregistering and several titles", "[service][boss]") {
+    std::vector<u8> db;
+    REQUIRE(BossA::SetStorage(db, Dmw1, StorageInfo{.extdata_id = 0xEA9, .size = 0x1000}));
+    REQUIRE(BossA::SetStorage(db, Other, StorageInfo{.extdata_id = 0x55D, .size = 0x2000}));
+    CHECK(db.size() == BossA::HeaderSize + 2 * BossA::EntrySize);
+
+    // Same value again: nothing changes.
+    CHECK_FALSE(BossA::SetStorage(db, Dmw1, StorageInfo{.extdata_id = 0xEA9, .size = 0x1000}));
+    // New size updates the existing entry instead of adding one.
+    CHECK(BossA::SetStorage(db, Dmw1, StorageInfo{.extdata_id = 0xEA9, .size = 0x3000}));
+    CHECK(db.size() == BossA::HeaderSize + 2 * BossA::EntrySize);
+    CHECK(BossA::FindStorage(db, Dmw1)->size == 0x3000);
+
+    // Unregister keeps the entry but clears its storage.
+    CHECK(BossA::SetStorage(db, Dmw1, std::nullopt));
+    CHECK_FALSE(BossA::FindStorage(db, Dmw1));
+    CHECK(BossA::FindStorage(db, Other)->extdata_id == 0x55D);
+    CHECK(db.size() == BossA::HeaderSize + 2 * BossA::EntrySize);
+}
+
+TEST_CASE("BOSS_A.db: invalid entries and malformed files", "[service][boss]") {
+    std::vector<u8> db;
+    REQUIRE(BossA::SetStorage(db, Dmw1, StorageInfo{.extdata_id = 0xEA9, .size = 0x1000}));
+
+    // An entry marked invalid is ignored.
+    db[BossA::HeaderSize + 0x8] = 0;
+    CHECK_FALSE(BossA::FindStorage(db, Dmw1));
+
+    // Unregistering something that isn't there changes nothing.
+    std::vector<u8> empty;
+    CHECK_FALSE(BossA::SetStorage(empty, Dmw1, std::nullopt));
+    CHECK(empty.empty());
+
+    // A malformed file (wrong magic or size) isn't read, and is recreated on write.
+    std::vector<u8> bad(BossA::HeaderSize + 10, 0xFF);
+    CHECK_FALSE(BossA::FindStorage(bad, Dmw1));
+    REQUIRE(BossA::SetStorage(bad, Dmw1, StorageInfo{.extdata_id = 0xEA9, .size = 0x1000}));
+    CHECK(bad.size() == BossA::HeaderSize + BossA::EntrySize);
+    CHECK(BossA::FindStorage(bad, Dmw1)->size == 0x1000);
+}
