+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <optional>
+#include <span>
+#include <vector>
+#include "common/common_types.h"
+
+namespace Service::BOSS {
+
+/// SpotPass storage registered by a title with SetStorageInfo (the StorageEntry in BOSS_A.db).
+struct StorageInfo {
+    u64 extdata_id = 0;
+    u32 size = 0;
+    u8 media_type = 1; ///< 0: NAND, 1: SD
+
+    bool operator==(const StorageInfo&) const = default;
+
+    template <class Archive>
+    void serialize(Archive& ar, const unsigned int) {
+        ar & extdata_id;
+        ar & size;
+        ar & media_type;
+    }
+};
+
+/**
+ * Reading and updating BOSS_A.db, the per-title database of the BOSS module
+ * (https://www.3dbrew.org/wiki/BOSS_Savegame): a u32 magic 0x12348000 followed by 0x800-byte
+ * entries. Each entry starts with {u64 program ID, bool valid, u8 version} and holds the title
+ * information at 0x10: {u64 program ID, u8 session maker, bool opt-out, bool arrival, ...,
+ * StorageEntry at +0x10}. StorageEntry: {bool registered, u8 media type, u16 entry ID,
+ * u32 storage size, u64 extdata ID, ...}.
+ */
+namespace BossA {
+
+constexpr u32 Magic = 0x12348000;
+constexpr std::size_t HeaderSize = 4;
+constexpr std::size_t EntrySize = 0x800;
+
+/// The storage registered for `program_id`, if the database has a valid entry with one.
+std::optional<StorageInfo> FindStorage(std::span<const u8> db, u64 program_id);
+
+/**
+ * Registers (`storage` set) or unregisters (`storage` empty) the storage of `program_id`.
+ * Updates the title's entry, or appends a new one; an empty or malformed database is recreated.
+ * Returns true if `db` changed.
+ */
+bool SetStorage(std::vector<u8>& db, u64 program_id, const std::optional<StorageInfo>& storage);
+
+} // namespace BossA
+
+} // namespace Service::BOSS
