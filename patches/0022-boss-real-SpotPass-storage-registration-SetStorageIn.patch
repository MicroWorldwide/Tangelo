+std::unique_ptr<FileSys::ArchiveBackend> OnlineService::OpenBossSystemSaveData() {
+    const std::string& nand_directory = FileUtil::GetUserPath(FileUtil::UserPath::NANDDir);
+    FileSys::ArchiveFactory_SystemSaveData systemsavedata_factory(nand_directory);
+
+    // Open the SystemSaveData archive 0x00010034
+    const FileSys::Path archive_path(boss_system_savedata_id);
+    auto archive_result = systemsavedata_factory.Open(archive_path, 0);
+    if (archive_result.Succeeded()) {
+        return std::move(archive_result).Unwrap();
+    }
+    if (archive_result.Code() == FileSys::ResultNotFound) {
+        // If the archive didn't exist, create the files inside
+        systemsavedata_factory.Format(archive_path, FileSys::ArchiveFormatInfo(), 0, 0, 0);
+
+        // Open it again to get a valid archive now that the folder exists
+        auto create_archive_result = systemsavedata_factory.Open(archive_path, 0);
+        if (create_archive_result.Succeeded()) {
+            return std::move(create_archive_result).Unwrap();
+        }
+    }
+    LOG_ERROR(Service_BOSS, "Could not open BOSS savedata");
+    return nullptr;
+}
+
+namespace {
+constexpr std::string_view BossADbPath = "/BOSS_A.db";
+
+std::vector<u8> ReadWholeFile(FileSys::ArchiveBackend& archive, std::string_view path) {
+    FileSys::Mode mode{};
+    mode.read_flag.Assign(1);
+    auto file_result = archive.OpenFile(FileSys::Path(std::string(path).c_str()), mode);
+    if (!file_result.Succeeded()) {
+        return {};
+    }
+    auto file = std::move(file_result).Unwrap();
+    std::vector<u8> data(file->GetSize());
+    if (!data.empty()) {
+        const auto read = file->Read(0, data.size(), data.data());
+        if (!read.Succeeded() || read.Unwrap() != data.size()) {
+            return {};
+        }
+    }
+    return data;
+}
+} // namespace
+
+void OnlineService::LoadStorageInfo(FileSys::ArchiveBackend& archive) {
+    const std::vector<u8> db = ReadWholeFile(archive, BossADbPath);
+    storage = BossA::FindStorage(db, session_program_id);
+    if (storage) {
+        extdata_id = storage->extdata_id;
+        LOG_INFO(Service_BOSS,
+                 "SpotPass storage for {:#018x}: extdata {:#018x}, size {:#x}, media type {}",
+                 session_program_id, storage->extdata_id, storage->size, storage->media_type);
+    }
+}
+
+bool OnlineService::SaveStorageInfo() {
+    auto archive = OpenBossSystemSaveData();
+    if (!archive) {
+        return false;
+    }
+    std::vector<u8> db = ReadWholeFile(*archive, BossADbPath);
+    if (!BossA::SetStorage(db, session_program_id, storage)) {
+        return true;
+    }
+
+    FileSys::Mode mode{};
+    mode.write_flag.Assign(1);
+    mode.create_flag.Assign(1);
+    auto file_result = archive->OpenFile(FileSys::Path(std::string(BossADbPath).c_str()), mode);
+    if (!file_result.Succeeded()) {
+        LOG_ERROR(Service_BOSS, "Could not open BOSS_A.db for writing");
+        return false;
+    }
+    auto file = std::move(file_result).Unwrap();
+    file->SetSize(db.size());
+    const auto written = file->Write(0, db.size(), true, false, db.data());
+    file->Close();
+    if (!written.Succeeded() || written.Unwrap() != db.size()) {
+        LOG_ERROR(Service_BOSS, "Could not write BOSS_A.db");
+        return false;
+    }
+    return true;
+}
+
+Result OnlineService::SetStorageInfo(const StorageInfo& info) {
+    if (session_program_id == 0) {
+        session_program_id = program_id;
+    }
+    storage = info;
+    extdata_id = info.extdata_id;
+    if (info.media_type != 1) {
+        LOG_WARNING(Service_BOSS, "SpotPass storage on media type {} (only SD is read)",
+                    info.media_type);
+    }
+    SaveStorageInfo();
+    return ResultSuccess;
+}
+
+Result OnlineService::UnregisterStorage() {
+    if (session_program_id == 0) {
+        session_program_id = program_id;
+    }
+    storage.reset();
+    SaveStorageInfo();
+    return ResultSuccess;
+}
+
+u32 OnlineService::GetStorageSize() const {
+    return storage ? storage->size : 0;
+}
+
+Result OnlineService::DeleteNsData(u32 ns_data_id) {
+    // Deleting data that isn't there is treated as done, as the old stub did: games call this
+    // for cleanup (e.g. DMW1 deletes 0x0B right after turning SpotPass on).
+    const auto entry = GetNsDataEntryFromId(ns_data_id);
+    if (!entry) {
+        return ResultSuccess;
+    }
+    auto boss_archive = OpenBossExtData();
+    if (!boss_archive) {
+        return ResultSuccess;
+    }
+    const Result result = boss_archive->DeleteFile(FileSys::Path(("/" + entry->filename).c_str()));
+    if (result.IsError()) {
+        LOG_WARNING(Service_BOSS, "Could not delete SpotPass file '{}' (NsData {:#010x})",
+                    entry->filename, ns_data_id);
+    }
+    return result;
+}
