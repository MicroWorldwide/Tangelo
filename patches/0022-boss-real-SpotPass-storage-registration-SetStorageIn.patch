@@ -0,0 +1,117 @@
+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <cstring>
+#include "core/hle/service/boss/boss_storage.h"
+
+namespace Service::BOSS::BossA {
+
+namespace {
+
+// Entry header
+constexpr std::size_t EntryProgramId = 0x0;
+constexpr std::size_t EntryValid = 0x8;
+constexpr std::size_t EntryVersion = 0x9;
+constexpr u8 LatestVersion = 3;
+// Title information
+constexpr std::size_t TitleInfo = 0x10;
+constexpr std::size_t TitleProgramId = TitleInfo + 0x0;
+constexpr std::size_t TitleSessionMaker = TitleInfo + 0x8;
+constexpr u8 SessionMakerUser = 1;
+// StorageEntry
+constexpr std::size_t Storage = TitleInfo + 0x10;
+constexpr std::size_t StorageRegistered = Storage + 0x0;
+constexpr std::size_t StorageMediaType = Storage + 0x1;
+constexpr std::size_t StorageSize = Storage + 0x4;
+constexpr std::size_t StorageExtdataId = Storage + 0x8;
+
+template <typename T>
+T Get(std::span<const u8> data, std::size_t offset) {
+    T value;
+    std::memcpy(&value, data.data() + offset, sizeof(T));
+    return value;
+}
+
+template <typename T>
+void Put(std::span<u8> data, std::size_t offset, T value) {
+    std::memcpy(data.data() + offset, &value, sizeof(T));
+}
+
+bool IsWellFormed(std::span<const u8> db) {
+    return db.size() >= HeaderSize && (db.size() - HeaderSize) % EntrySize == 0 &&
+           Get<u32>(db, 0) == Magic;
+}
+
+std::optional<std::size_t> FindEntry(std::span<const u8> db, u64 program_id) {
+    for (std::size_t offset = HeaderSize; offset + EntrySize <= db.size(); offset += EntrySize) {
+        const auto entry = db.subspan(offset, EntrySize);
+        if (entry[EntryValid] != 0 && Get<u64>(entry, EntryProgramId) == program_id) {
+            return offset;
+        }
+    }
+    return std::nullopt;
+}
+
+} // namespace
+
+std::optional<StorageInfo> FindStorage(std::span<const u8> db, u64 program_id) {
+    if (!IsWellFormed(db)) {
+        return std::nullopt;
+    }
+    const auto offset = FindEntry(db, program_id);
+    if (!offset) {
+        return std::nullopt;
+    }
+    const auto entry = db.subspan(*offset, EntrySize);
+    if (entry[StorageRegistered] == 0) {
+        return std::nullopt;
+    }
+    return StorageInfo{
+        .extdata_id = Get<u64>(entry, StorageExtdataId),
+        .size = Get<u32>(entry, StorageSize),
+        .media_type = entry[StorageMediaType],
+    };
+}
+
+bool SetStorage(std::vector<u8>& db, u64 program_id, const std::optional<StorageInfo>& storage) {
+    if (!IsWellFormed(db)) {
+        if (!storage) {
+            return false;
+        }
+        db.assign(HeaderSize, 0);
+        Put<u32>(db, 0, Magic);
+    }
+
+    auto offset = FindEntry(db, program_id);
+    if (!offset) {
+        if (!storage) {
+            return false;
+        }
+        offset = db.size();
+        db.resize(db.size() + EntrySize, 0);
+        std::span<u8> entry(db.data() + *offset, EntrySize);
+        Put<u64>(entry, EntryProgramId, program_id);
+        entry[EntryValid] = 1;
+        entry[EntryVersion] = LatestVersion;
+        Put<u64>(entry, TitleProgramId, program_id);
+        entry[TitleSessionMaker] = SessionMakerUser;
+    }
+
+    std::span<u8> entry(db.data() + *offset, EntrySize);
+    const std::vector<u8> before(entry.begin() + Storage, entry.begin() + Storage + 0x10);
+    if (storage) {
+        entry[StorageRegistered] = 1;
+        entry[StorageMediaType] = storage->media_type;
+        Put<u32>(entry, StorageSize, storage->size);
+        Put<u64>(entry, StorageExtdataId, storage->extdata_id);
+    } else {
+        entry[StorageRegistered] = 0;
+        entry[StorageMediaType] = 0;
+        Put<u32>(entry, StorageSize, 0);
+        Put<u64>(entry, StorageExtdataId, 0);
+    }
+    return !std::equal(before.begin(), before.end(), entry.begin() + Storage);
+}
+
+} // namespace Service::BOSS::BossA
