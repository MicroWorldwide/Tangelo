+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <filesystem>
+#include <string>
+#include <catch2/catch_test_macros.hpp>
+#include "common/file_util.h"
+#include "core/file_sys/archive_extsavedata.h"
+
+TEST_CASE("ExtSaveData IDs are listed from the host folders", "[file_sys]") {
+    const std::string root =
+        (std::filesystem::temp_directory_path() / "tangelo-extdata-list").string() + "/";
+    FileUtil::DeleteDirRecursively(root);
+
+    const std::string sd = FileSys::GetExtDataContainerPath(root, false) + "00000000/";
+    const std::string nand = FileSys::GetExtDataContainerPath(root, true) + "00048000/";
+    for (const char* id : {"00000228", "00000EA9", "0000198f"}) {
+        REQUIRE(FileUtil::CreateFullPath(sd + id + "/user/"));
+    }
+    REQUIRE(FileUtil::CreateFullPath(sd + "notanid/"));
+    REQUIRE(FileUtil::CreateFullPath(nand + "f000000b/user/"));
+    FileUtil::WriteStringToFile(false, sd + "12345678", "a file, not a folder");
+
+    CHECK(FileSys::ListExtSaveDataIds(root, false) == std::vector<u64>{0x228, 0xEA9, 0x198F});
+    CHECK(FileSys::ListExtSaveDataIds(root, true) == std::vector<u64>{0x00048000F000000BULL});
+
+    FileUtil::DeleteDirRecursively(root);
+    CHECK(FileSys::ListExtSaveDataIds(root, false).empty());
+}
