+std::vector<u64> ListExtSaveDataIds(std::string_view mount_point, bool shared) {
+    constexpr u32 SharedExtDataHigh = 0x00048000;
+    const u32 high = shared ? SharedExtDataHigh : 0;
+    const std::string directory =
+        fmt::format("{}{:08x}/", GetExtDataContainerPath(mount_point, shared), high);
+
+    std::vector<u64> ids;
+    FileUtil::ForeachDirectoryEntry(
+        nullptr, directory, [&](u64*, const std::string& parent, const std::string& name) {
+            if (name.size() != 8 || !FileUtil::IsDirectory(parent + "/" + name) ||
+                !std::all_of(name.begin(), name.end(),
+                             [](char c) { return std::isxdigit(static_cast<unsigned char>(c)); })) {
+                return true;
+            }
+            const u32 low = static_cast<u32>(std::stoul(name, nullptr, 16));
+            ids.push_back((static_cast<u64>(high) << 32) | low);
+            return true;
+        });
+    std::sort(ids.begin(), ids.end());
+    return ids;
+}
