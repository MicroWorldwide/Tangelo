+void FS_USER::EnumerateExtSaveDataImpl(IPC::RequestParser& rp, u32 max_count, MediaType media_type,
+                                       u32 entry_size, bool shared) {
+    auto& buffer = rp.PopMappedBuffer();
+
+    // Shared extdata lives on the NAND, the others on the SD card.
+    shared = shared || media_type == MediaType::NAND;
+    const std::string mount_point =
+        FileUtil::GetUserPath(shared ? FileUtil::UserPath::NANDDir : FileUtil::UserPath::SDMCDir);
+    const std::vector<u64> ids = FileSys::ListExtSaveDataIds(mount_point, shared);
+
+    if (entry_size != 4 && entry_size != 8) {
+        entry_size = 8;
+    }
+    const std::size_t count =
+        std::min<std::size_t>({ids.size(), max_count, buffer.GetSize() / entry_size});
+    for (std::size_t i = 0; i < count; ++i) {
+        if (entry_size == 4) {
+            const u32 low = static_cast<u32>(ids[i]);
+            buffer.Write(&low, i * 4, 4);
+        } else {
+            buffer.Write(&ids[i], i * 8, 8);
+        }
+    }
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(2, 2);
+    rb.Push(ResultSuccess);
+    rb.Push<u32>(static_cast<u32>(count));
+    rb.PushMappedBuffer(buffer);
+    LOG_DEBUG(Service_FS, "media_type={}, shared={}, entry_size={}, count={}", media_type, shared,
+              entry_size, count);
+}
+
+void FS_USER::EnumerateExtSaveData(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 output_size = rp.Pop<u32>();
+    const auto media_type = static_cast<MediaType>(rp.Pop<u32>() & 0xFF);
+    const u32 entry_size = rp.Pop<u32>();
+    const bool shared = (rp.Pop<u32>() & 0xFF) != 0;
+    const u32 max_count =
+        (entry_size == 4 || entry_size == 8) ? output_size / entry_size : output_size / 8;
+    EnumerateExtSaveDataImpl(rp, max_count, media_type, entry_size, shared);
+}
+
+void FS_USER::ObsoletedEnumerateExtSaveData(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 max_count = rp.Pop<u32>();
+    const auto media_type = static_cast<MediaType>(rp.Pop<u32>() & 0xFF);
+    EnumerateExtSaveDataImpl(rp, max_count, media_type, 8, false);
+}
