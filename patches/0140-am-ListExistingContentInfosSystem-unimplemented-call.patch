 #include <fmt/format.h>
 #include "common/assert.h"
 #include "common/hacks/hack_manager.h"
@@ -169,7 +172,30 @@ void ServiceFrameworkBase::ReportUnimplementedFunction(u32* cmd_buf, const Funct
 
     result.push_back('}');
 
-    LOG_ERROR(Service, "unknown / unimplemented {}", result);
+    // Tangelo: a program that keeps calling the same unimplemented function (the eShop's
+    // "Repair software" check did ~14,000 a second) would fill the whole log file. Log the
+    // first few calls of each service + command, then only a count now and then.
+    static std::mutex unimplemented_mutex;
+    static std::map<std::pair<std::string, u32>, u64> unimplemented_counts;
+    u64 count;
+    {
+        std::scoped_lock lock(unimplemented_mutex);
+        count = ++unimplemented_counts[{service_name, header.command_id.Value()}];
+    }
+    constexpr u64 LOG_FIRST = 10;
+    constexpr u64 LOG_EVERY = 10000;
+    if (count <= LOG_FIRST) {
+        LOG_ERROR(Service, "unknown / unimplemented {}", result);
+        if (count == LOG_FIRST) {
+            LOG_ERROR(Service,
+                      "port='{}' command 0x{:04X}: further calls are counted, logged every {}",
+                      service_name, header.command_id.Value(), LOG_EVERY);
+        }
+    } else if (count % LOG_EVERY == 0) {
+        LOG_ERROR(Service, "unknown / unimplemented function: port='{}' command 0x{:04X} called {} times "
+                  "(last: {})",
+                  service_name, header.command_id.Value(), count, result);
+    }
     // TODO(bunnei): Hack - ignore error
     header.normal_params_size.Assign(1);
     header.translate_params_size.Assign(0);
