+}
+
+namespace {
+/// Titles the play history logs: applications (games, system applications like Mii Plaza) and
+/// applets (HOME Menu, Activity Log, ...), not system modules, updates or DLC.
+bool IsLoggedTitle(u64 program_id) {
+    const u32 high = static_cast<u32>(program_id >> 32);
+    return high == 0x00040000 || high == 0x00040010 || high == 0x00040030;
+}
+} // namespace
+
+void Module::OnProcessEvent(u64 program_id, bool started) {
+    if (!IsLoggedTitle(program_id)) {
+        return;
     }
-    if (running_title_id != 0) {
-        launch_ms_since_2000 = system.Kernel().GetSharedPageHandler().GetSystemTimeSince2000();
-        launch_host_time = std::chrono::steady_clock::now();
-        const u8 event = PlayHistory::IsApplet(running_title_id) ? PlayHistory::Applet : 0;
-        play_history.Add(running_title_id, event, launch_ms_since_2000);
-        SavePlayHistory();
-        LOG_INFO(Service_PTM, "Play history: {:016X} launched", running_title_id);
+    const u64 now = system.Kernel().GetSharedPageHandler().GetSystemTimeSince2000();
+    const u8 applet = PlayHistory::IsApplet(program_id) ? PlayHistory::Applet : 0;
+    if (started) {
+        running_titles[program_id] = {now, std::chrono::steady_clock::now()};
+        play_history.Add(program_id, applet, now);
+        LOG_INFO(Service_PTM, "Play history: {:016X} launched", program_id);
+    } else {
+        running_titles.erase(program_id);
+        play_history.Add(program_id, PlayHistory::Close | applet, now);
+        LOG_INFO(Service_PTM, "Play history: {:016X} closed", program_id);
     }
+    SavePlayHistory();
 }
 
 Module::~Module() {
-    if (running_title_id == 0) {
+    if (running_titles.empty()) {
         return;
     }
     // The kernel may already be gone here; the close time is the launch time plus the time
     // that has passed since.
-    const auto played = std::chrono::duration_cast<std::chrono::milliseconds>(
-        std::chrono::steady_clock::now() - launch_host_time);
-    const u8 event =
-        PlayHistory::Close | (PlayHistory::IsApplet(running_title_id) ? PlayHistory::Applet : 0);
-    play_history.Add(running_title_id, event,
-                     launch_ms_since_2000 + static_cast<u64>(played.count()));
+    const auto host_now = std::chrono::steady_clock::now();
+    for (const auto& [program_id, title] : running_titles) {
+        const auto played = std::chrono::duration_cast<std::chrono::milliseconds>(
+            host_now - title.launch_host_time);
+        const u8 applet = PlayHistory::IsApplet(program_id) ? PlayHistory::Applet : 0;
+        play_history.Add(program_id, PlayHistory::Close | applet,
+                         title.launch_ms_since_2000 + static_cast<u64>(played.count()));
+        LOG_INFO(Service_PTM, "Play history: {:016X} closed after {} min", program_id,
+                 played.count() / 60000);
+    }
     SavePlayHistory();
-    LOG_INFO(Service_PTM, "Play history: {:016X} closed after {} min", running_title_id,
-             played.count() / 60000);
 }
 
 namespace {
@@ -517,6 +534,12 @@ Module::Interface::Interface(std::shared_ptr<Module> ptm, const char* name, u32
 void InstallInterfaces(Core::System& system) {
     auto& service_manager = system.ServiceManager();
     auto ptm = std::make_shared<Module>(system);
+    system.Kernel().SetProcessListener(
+        [weak_ptm = std::weak_ptr<Module>(ptm)](u64 program_id, bool started) {
+            if (const auto ptm = weak_ptm.lock()) {
+                ptm->OnProcessEvent(program_id, started);
+            }
+        });
     std::make_shared<PTM_Gets>(ptm)->InstallAsService(service_manager);
     std::make_shared<PTM_Play>(ptm)->InstallAsService(service_manager);
     std::make_shared<PTM_Sets>(ptm)->InstallAsService(service_manager);
