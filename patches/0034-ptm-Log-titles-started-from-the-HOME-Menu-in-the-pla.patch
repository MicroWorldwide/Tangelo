     std::shared_ptr<Process> CreateProcess(std::shared_ptr<CodeSet> code_set);
 
+    /// Called with a process's program ID when it starts running (true) or exits (false), e.g.
+    /// for PTM's play history. Not saved in save states.
+    using ProcessListener = std::function<void(u64 program_id, bool started)>;
+    void SetProcessListener(ProcessListener listener) {
+        process_listener = std::move(listener);
+    }
+    void NotifyProcessListener(u64 program_id, bool started) const {
+        if (process_listener) {
+            process_listener(program_id, started);
+        }
+    }
