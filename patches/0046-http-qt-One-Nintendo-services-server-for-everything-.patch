+bool IsNintendoHost(std::string_view host) {
+    const std::string name = GetUrlHost(host);
+    for (const std::string_view domain : {"nintendo.net", "nintendowifi.net", "nintendo.com"}) {
+        if (name == domain || (name.size() > domain.size() && name.ends_with(domain) &&
+                               name[name.size() - domain.size() - 1] == '.')) {
+            return true;
+        }
+    }
+    return false;
+}
+
+std::optional<NintendoRedirect> RedirectNintendoUrl(std::string_view url, std::string_view server) {
+    if (IsSpotPassUrl(url)) {
+        const auto wrapped = UnwrapAkamai(url);
+        std::string rest(wrapped ? wrapped->second : SplitAuthority(url).second);
+        if (!wrapped && GetUrlHost(url) == NetPassHost) {
+            rest.erase(0, NetPassSpotPassPrefix.size());
+        }
+        auto redirected = JoinServer(server, std::move(rest), "http");
+        if (!redirected) {
+            return std::nullopt;
+        }
+        return NintendoRedirect{std::move(*redirected), GetSpotPassHost(url)};
+    }
+    if (!IsNintendoHost(GetUrlHost(url))) {
+        return std::nullopt;
+    }
+    auto redirected = JoinServer(server, std::string(SplitAuthority(url).second), "http");
+    if (!redirected) {
+        return std::nullopt;
+    }
+    return NintendoRedirect{std::move(*redirected), GetUrlHost(url)};
+}
