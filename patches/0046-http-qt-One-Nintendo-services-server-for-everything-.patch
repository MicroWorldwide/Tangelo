+
+TEST_CASE("Everything meant for Nintendo goes to the custom server", "[service][http][spotpass]") {
+    using Service::HTTP::IsNintendoHost;
+    using Service::HTTP::RedirectNintendoUrl;
+
+    CHECK(IsNintendoHost("nasc.nintendowifi.net"));
+    CHECK(IsNintendoHost("account.nintendo.net:443"));
+    CHECK(IsNintendoHost("samurai-ctr.cdn.nintendo.net"));
+    CHECK(IsNintendoHost("nintendo.com"));
+    CHECK_FALSE(IsNintendoHost("notnintendo.net"));
+    CHECK_FALSE(IsNintendoHost("nintendo.net.example.com"));
+    CHECK_FALSE(IsNintendoHost("api.netpass.cafe"));
+
+    const auto login = RedirectNintendoUrl("https://nasc.nintendowifi.net/ac", "localhost:8080");
+    REQUIRE(login);
+    CHECK(login->url == "http://localhost:8080/ac");
+    CHECK(login->original_host == "nasc.nintendowifi.net");
+
+    const auto catalogue = RedirectNintendoUrl(
+        "https://samurai-ctr.cdn.nintendo.net/samurai/ws/NL/news?lang=en", "http://srv:9000/n/");
+    REQUIRE(catalogue);
+    CHECK(catalogue->url == "http://srv:9000/n/samurai/ws/NL/news?lang=en");
+
+    // SpotPass: Akamai and the NetPass mirror keep working, with the Nintendo host as origin.
+    const auto akamai = RedirectNintendoUrl(
+        "https://a248.e.akamai.net/f/248/103046/10m/npdl.c.app.nintendowifi.net/p01/nsa/a/b/c",
+        "localhost:8080");
+    REQUIRE(akamai);
+    CHECK(akamai->url == "http://localhost:8080/p01/nsa/a/b/c");
+    CHECK(akamai->original_host == "npdl.c.app.nintendowifi.net");
+    const auto mirror =
+        RedirectNintendoUrl("https://api.netpass.cafe/npdl/p01/nsa/a/b/c?tm=4", "localhost:8080");
+    REQUIRE(mirror);
+    CHECK(mirror->url == "http://localhost:8080/p01/nsa/a/b/c?tm=4");
+    CHECK(mirror->original_host == "api.netpass.cafe");
+
+    // NetPass's own API and other sites are left alone.
+    CHECK_FALSE(RedirectNintendoUrl("https://api.netpass.cafe/api/inbox", "localhost:8080"));
+    CHECK_FALSE(RedirectNintendoUrl("https://example.com/", "localhost:8080"));
+    CHECK_FALSE(RedirectNintendoUrl("https://nasc.nintendowifi.net/ac", ""));
+}
