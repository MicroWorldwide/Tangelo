+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the misc/licenses/gplv2.txt file included.
+
+//? #version 430 core
+
+// A 16-bit depth buffer read back as an RG8 texture (DEAD OR ALIVE Dimensions does this).
+// In 3DS memory both are two bytes per pixel: D16 is a little-endian u16 (low byte first) and
+// RG8 is stored [G, R], so R gets the high byte of the depth and G the low byte.
+
+precision highp int;
+precision highp float;
+
+layout(location = 0) in mediump vec2 tex_coord;
+layout(location = 0) out lowp vec4 frag_color;
+
+layout(binding = 0) uniform highp sampler2D depth;
+
+void main() {
+    mediump vec2 coord = tex_coord * vec2(textureSize(depth, 0));
+    mediump ivec2 tex_icoord = ivec2(coord);
+    highp uint depth_val = uint(texelFetch(depth, tex_icoord, 0).x * (exp2(16.0) - 1.0) + 0.5);
+    highp uvec2 components = uvec2(depth_val >> 8u, depth_val) & 0x000000FFu;
+    frag_color = vec4(vec2(components) / (exp2(8.0) - 1.0), 0.0, 1.0);
+}
