     System.getenv("TANGELO_BUILD_NUMBER")?.takeIf { it.isNotBlank() }?.let { return it.trim() }
-    val root = "2ff2af57139673621a047ed9baa4c591e0694b47"
-    val count = runGitCommand(ProcessBuilder("git", "rev-list", "--count", "$root..HEAD"))
-        ?.toIntOrNull() ?: return "?"
-    return (count + 1).toString()
+    val file = project.rootDir.resolve("../../BUILD-NUMBER")
+    return if (file.exists()) file.readText().trim().ifEmpty { "?" } else "?"
 }
 
