+/// For an Akamai-wrapped URL, returns the wrapped host and its path ("/p01/..."), else nullopt.
+std::optional<std::pair<std::string, std::string_view>> UnwrapAkamai(std::string_view url) {
+    const auto [authority, rest_with_query] = SplitAuthority(url);
+    std::string_view host = authority;
+    if (const auto colon = host.find(':'); colon != std::string_view::npos) {
+        host = host.substr(0, colon);
+    }
+    if (ToLower(host) != AkamaiHost) {
+        return std::nullopt;
+    }
+    std::string_view rest = rest_with_query;
+    // Skip "/f", two numbers and the cache time: four path segments.
+    for (int i = 0; i < 4; i++) {
+        if (rest.empty() || rest.front() != '/') {
+            return std::nullopt;
+        }
+        const auto next = rest.find('/', 1);
+        if (next == std::string_view::npos || next == 1) {
+            return std::nullopt;
+        }
+        rest.remove_prefix(next);
+    }
+    // Now "/<origin host>/<origin path>".
+    const auto path_start = rest.find('/', 1);
+    if (path_start == std::string_view::npos || path_start == 1) {
+        return std::nullopt;
+    }
+    return std::make_pair(ToLower(rest.substr(1, path_start - 1)), rest.substr(path_start));
+}
