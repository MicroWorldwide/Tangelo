+++ b/src/core/hle/service/ptm/ptm.cpp
@@ -397,6 +397,12 @@ Module::Module(Core::System& system_) : system(system_) {
     }
 
     LoadPlayHistory();
+    // A session that ended without a power off entry (crash, killed emulator) is closed at its
+    // last entry, so the Activity Log doesn't count the time since as play time.
+    play_history.EndUnfinishedSession();
+    SavePlayHistory();
+    clock_anchor_ms = system.Kernel().GetSharedPageHandler().GetSystemTimeSince2000();
+    clock_anchor_host = std::chrono::steady_clock::now();
 }
 
 namespace {
@@ -413,36 +419,29 @@ void Module::OnProcessEvent(u64 program_id, bool started) {
         return;
     }
     const u64 now = system.Kernel().GetSharedPageHandler().GetSystemTimeSince2000();
-    const u8 applet = PlayHistory::IsApplet(program_id) ? PlayHistory::Applet : 0;
+    clock_anchor_ms = now;
+    clock_anchor_host = std::chrono::steady_clock::now();
     if (started) {
-        running_titles[program_id] = {now, std::chrono::steady_clock::now()};
-        play_history.Add(program_id, applet, now);
+        play_history.LogLaunch(program_id, now);
         LOG_INFO(Service_PTM, "Play history: {:016X} launched", program_id);
     } else {
-        running_titles.erase(program_id);
-        play_history.Add(program_id, PlayHistory::Close | applet, now);
+        play_history.LogClose(program_id, now);
         LOG_INFO(Service_PTM, "Play history: {:016X} closed", program_id);
     }
     SavePlayHistory();
 }
 
 Module::~Module() {
-    if (running_titles.empty()) {
+    if (clock_anchor_ms == 0) {
         return;
     }
-    // The kernel may already be gone here; the close time is the launch time plus the time
-    // that has passed since.
-    const auto host_now = std::chrono::steady_clock::now();
-    for (const auto& [program_id, title] : running_titles) {
-        const auto played = std::chrono::duration_cast<std::chrono::milliseconds>(
-            host_now - title.launch_host_time);
-        const u8 applet = PlayHistory::IsApplet(program_id) ? PlayHistory::Applet : 0;
-        play_history.Add(program_id, PlayHistory::Close | applet,
-                         title.launch_ms_since_2000 + static_cast<u64>(played.count()));
-        LOG_INFO(Service_PTM, "Play history: {:016X} closed after {} min", program_id,
-                 played.count() / 60000);
-    }
+    // The kernel may already be gone here: the stop time is the last known emulated time plus
+    // the time that has passed since.
+    const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - clock_anchor_host);
+    play_history.LogSystemStop(clock_anchor_ms + static_cast<u64>(elapsed.count()));
     SavePlayHistory();
+    LOG_INFO(Service_PTM, "Play history: system stopped");
 }
 
