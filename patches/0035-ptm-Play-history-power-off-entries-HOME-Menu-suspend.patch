diff --git a/src/core/hle/service/ptm/ptm_play_history.cpp b/src/core/hle/service/ptm/ptm_play_history.cpp
index 5d8b2c3..949f276 100644
--- a/src/core/hle/service/ptm/ptm_play_history.cpp
+++ b/src/core/hle/service/ptm/ptm_play_history.cpp
@@ -56,6 +56,82 @@ void PlayHistory::Add(u64 title_id, u8 event, u64 ms_since_2000) {
     entries.push_back(MakeEntry(title_id, event, ms_since_2000));
 }
 
+bool PlayHistory::IsHomeMenu(u64 title_id) {
+    switch (title_id) {
+    case 0x0004003000008202: // JPN
+    case 0x0004003000008F02: // USA
+    case 0x0004003000009802: // EUR
+    case 0x000400300000A102: // CHN
+    case 0x000400300000A902: // KOR
+    case 0x000400300000B102: // TWN
+        return true;
+    default:
+        return false;
+    }
+}
+
+void PlayHistory::LogLaunch(u64 title_id, u64 ms_since_2000) {
+    if (running.contains(title_id)) {
+        LogClose(title_id, ms_since_2000);
+    }
+    const bool applet = IsApplet(title_id);
+    if (!applet) {
+        // Starting an application suspends the HOME Menu.
+        for (const auto& [id, is_running] : running) {
+            if (IsHomeMenu(id) && !home_suspended) {
+                Add(id, Close | Applet | ResumeSuspend, ms_since_2000);
+                home_suspended = true;
+            }
+        }
+    } else if (IsHomeMenu(title_id)) {
+        home_suspended = false;
+    }
+    Add(title_id, applet ? Applet : 0, ms_since_2000);
+    running[title_id] = true;
+}
+
+void PlayHistory::LogClose(u64 title_id, u64 ms_since_2000) {
+    const bool applet = IsApplet(title_id);
+    Add(title_id, Close | (applet ? Applet : 0), ms_since_2000);
+    running.erase(title_id);
+    if (IsHomeMenu(title_id)) {
+        home_suspended = false;
+        return;
+    }
+    if (!applet && home_suspended) {
+        // Back to the HOME Menu.
+        for (const auto& [id, is_running] : running) {
+            if (IsHomeMenu(id)) {
+                Add(id, Applet | ResumeSuspend, ms_since_2000);
+            }
+        }
+        home_suspended = false;
+    }
+}
+
+void PlayHistory::LogSystemStop(u64 ms_since_2000) {
+    // Applications still running are logged as closed; the HOME Menu never is.
+    for (const auto& [id, is_running] : running) {
+        if (!IsHomeMenu(id)) {
+            Add(id, Close | (IsApplet(id) ? Applet : 0), ms_since_2000);
+        }
+    }
+    running.clear();
+    home_suspended = false;
+    Add(SpecialTitleId, SpecialSystemStopped, ms_since_2000);
+}
+
+void PlayHistory::EndUnfinishedSession() {
+    if (entries.empty()) {
+        return;
+    }
+    const Entry& last = entries.back();
+    if (last.TitleId() == SpecialTitleId && last.Event() == SpecialSystemStopped) {
+        return;
+    }
+    Add(SpecialTitleId, SpecialSystemStopped, static_cast<u64>(last.Minutes()) * 60000);
+}
+
 bool PlayHistory::IsApplet(u64 title_id) {
     return (title_id >> 32) == 0x00040030;
 }
diff --git a/src/core/hle/service/ptm/ptm_play_history.h b/src/core/hle/service/ptm/ptm_play_history.h
index ba00842..5dfea0a 100644
--- a/src/core/hle/service/ptm/ptm_play_history.h
+++ b/src/core/hle/service/ptm/ptm_play_history.h
@@ -4,6 +4,7 @@
 
 #pragma once
 
+#include <map>
 #include <span>
 #include <vector>
 #include "common/common_types.h"
@@ -54,6 +55,31 @@ public:
     /// Adds an entry; the oldest entry is dropped when the log is full.
     void Add(u64 title_id, u8 event, u64 ms_since_2000);
 
+    /// Title ID of special (system-wide) entries; their event is a number, not flags.
+    static constexpr u64 SpecialTitleId = 0xFFFFFFFFFFFFFFFF;
+    /// Special event: 3DS services stopped (power off). The Activity Log treats every title
+    /// as closed at this point.
+    static constexpr u8 SpecialSystemStopped = 0b1010;
+
+    /**
+     * Logs a title starting, the way the console does: an application started while the HOME
+     * Menu runs is preceded by "HOME Menu suspended"; a title that is already running is logged
+     * as closed first.
+     */
+    void LogLaunch(u64 title_id, u64 ms_since_2000);
+    /// Logs a title exiting; the HOME Menu is logged as resumed after an application closes.
+    void LogClose(u64 title_id, u64 ms_since_2000);
+    /// Logs a power off: open applications closed, then "3DS services stopped".
+    void LogSystemStop(u64 ms_since_2000);
+    /**
+     * Ends a session that stopped without a power off entry (e.g. the emulator was closed
+     * unexpectedly): adds "3DS services stopped" at the time of the last entry, so the Activity
+     * Log doesn't count the time since as play time.
+     */
+    void EndUnfinishedSession();
+    /// HOME Menu title IDs (all regions).
+    static bool IsHomeMenu(u64 title_id);
+
     static Entry MakeEntry(u64 title_id, u8 event, u64 ms_since_2000);
     /// Whether a title is logged as an applet (HOME Menu, Activity Log, ...) rather than an
     /// application: system applets have title ID high 0x00040030.
@@ -65,6 +91,9 @@ public:
 
 private:
     std::vector<Entry> entries; // oldest first
+    /// Titles running now (not saved), and whether the HOME Menu is suspended.
+    std::map<u64, bool> running;
+    bool home_suspended = false;
 };
 
 } // namespace Service::PTM
diff --git a/src/tests/core/hle/service/ptm_play_history.cpp b/src/tests/core/hle/service/ptm_play_history.cpp
index c838c98..664d440 100644
--- a/src/tests/core/hle/service/ptm_play_history.cpp
+++ b/src/tests/core/hle/service/ptm_play_history.cpp
@@ -3,6 +3,7 @@
 // Refer to the license.txt file included.
 
 #include <cstring>
+#include <utility>
 #include <vector>
 #include <catch2/catch_test_macros.hpp>
 #include "core/hle/service/ptm/ptm_play_history.h"
@@ -63,3 +64,50 @@ TEST_CASE("Play history is saved oldest first and loaded from a ring buffer", "[
     CHECK_FALSE(loaded.Load(std::vector<u8>{1, 2, 3}));
     CHECK(loaded.Entries().empty());
 }
+
+TEST_CASE("Play history follows the console's launch and power off pattern", "[service][ptm]") {
+    constexpr u64 Home = 0x0004003000009802;
+    constexpr u64 ActivityLog = 0x0004001000022200;
+    constexpr u64 Min = 60'000;
+    PlayHistory history;
+    history.LogLaunch(Home, 1 * Min);
+    history.LogLaunch(ActivityLog, 2 * Min);
+    history.LogClose(ActivityLog, 5 * Min);
+    history.LogLaunch(ActivityLog, 6 * Min);
+    history.LogSystemStop(9 * Min);
+
+    std::vector<std::pair<u64, u8>> got;
+    for (const auto& e : history.Entries()) {
+        got.emplace_back(e.TitleId(), e.Event());
+    }
+    const std::vector<std::pair<u64, u8>> expected{
+        {Home, 0b0010},        // HOME Menu launched
+        {Home, 0b0111},        // HOME Menu suspended
+        {ActivityLog, 0b0000}, // application launched
+        {ActivityLog, 0b0001}, // application closed
+        {Home, 0b0110},        // HOME Menu resumed
+        {Home, 0b0111},
+        {ActivityLog, 0b0000},
+        {ActivityLog, 0b0001}, // closed at power off
+        {PlayHistory::SpecialTitleId, PlayHistory::SpecialSystemStopped},
+    };
+    CHECK(got == expected);
+    CHECK(history.Entries().back().Minutes() == 9);
+
+    // A session without a power off entry is ended at its last entry.
+    PlayHistory unfinished;
+    unfinished.Add(ActivityLog, 0, 30 * Min);
+    unfinished.EndUnfinishedSession();
+    REQUIRE(unfinished.Entries().size() == 2);
+    CHECK(unfinished.Entries()[1].TitleId() == PlayHistory::SpecialTitleId);
+    CHECK(unfinished.Entries()[1].Minutes() == 30);
+    unfinished.EndUnfinishedSession(); // already ended: nothing added
+    CHECK(unfinished.Entries().size() == 2);
+
+    // The same title started again without an exit in between is closed first.
+    PlayHistory twice;
+    twice.LogLaunch(0x000400000F717100, 1 * Min);
+    twice.LogLaunch(0x000400000F717100, 2 * Min);
+    REQUIRE(twice.Entries().size() == 3);
+    CHECK(twice.Entries()[1].Event() == PlayHistory::Close);
+}
