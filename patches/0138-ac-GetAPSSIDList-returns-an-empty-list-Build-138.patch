+void Module::Interface::GetAPSSIDList(Kernel::HLERequestContext& ctx) {
+    // The StreetPass module (cecd) asks for this list (0xE14 bytes) when NDM resumes StreetPass
+    // after a game (seen with Nintendogs + Cats, 2026-10-30). It holds the names of access points
+    // it should know about, most likely for StreetPass relay points; the emulated console has none
+    // saved, so the list is returned empty (all zero: a count of 0).
+    IPC::RequestParser rp(ctx);
+    const u32 size = rp.Pop<u32>();
+    auto& buffer = rp.PopMappedBuffer();
+
+    const std::vector<u8> empty(std::min<std::size_t>(size, buffer.GetSize()), 0);
+    buffer.Write(empty.data(), 0, empty.size());
+
+    static std::atomic<bool> logged{false};
+    if (!logged.exchange(true)) {
+        LOG_INFO(Service_AC, "GetAPSSIDList: no saved access points (buffer of {} bytes)", size);
+    } else {
+        LOG_DEBUG(Service_AC, "GetAPSSIDList: no saved access points (buffer of {} bytes)", size);
+    }
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
+    rb.Push(ResultSuccess);
+    rb.PushMappedBuffer(buffer);
+}
+
 void Module::Interface::ScanAPs(Kernel::HLERequestContext& ctx) {
     IPC::RequestParser rp(ctx);
     const u32 size = rp.Pop<u32>();
