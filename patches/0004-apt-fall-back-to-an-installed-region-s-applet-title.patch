-                            GetTitleIdForApplet(applet_id, cfg->GetRegionValue(is_setup)));
+        auto process = LaunchAppletTitle(system, applet_id, cfg->GetRegionValue(is_setup));
         if (process) {
             return ResultSuccess;
         }
@@ -881,9 +912,7 @@ Result AppletManager::StartSystemApplet(AppletId applet_id, std::shared_ptr<Kern
     if (!GetAppletSlot(slot_id)->registered) {
         bool is_setup = system.GetAppLoader().DoingInitialSetup();
