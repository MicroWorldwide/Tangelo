+void GMainWindow::OnDumpProcessMemory() {
+    // Writes the memory of the running game (every readable region of each application process)
+    // to <user>/dump/memory/<title id>-<date-time>.bin, with a .txt list of the regions next to it
+    // (address, size, file offset). Some games only build settings such as their NEX game-server ID
+    // and access key while they run (Governor of Poker), so they can't be read from the .code dump;
+    // dump after the game has tried to go online. Nothing leaves the machine.
+    if (!emulation_running) {
+        return;
+    }
+    const auto dir = fmt::format("{}memory", FileUtil::GetUserPath(FileUtil::UserPath::DumpDir));
+    FileUtil::CreateFullPath(dir + "/");
+    const std::string stamp =
+        QDateTime::currentDateTime().toString(QStringLiteral("yyyyMMdd-HHmmss")).toStdString();
+
+    std::vector<std::string> written;
+    u64 total = 0;
+    {
+        std::scoped_lock lock{system.Kernel().GetHLELock()};
+        for (const auto& process : system.Kernel().GetProcessList()) {
+            if (!process || !process->codeset) {
+                continue;
+            }
+            const u64 program_id = process->codeset->program_id;
+            if ((program_id >> 32) != 0x00040000) { // games only, not system modules or applets
+                continue;
+            }
+            const auto base = fmt::format("{}/{:016X}-{}", dir, program_id, stamp);
+            FileUtil::IOFile bin(base + ".bin", "wb");
+            FileUtil::IOFile map(base + ".txt", "w");
+            if (!bin.IsOpen() || !map.IsOpen()) {
+                continue;
+            }
+            const std::string header = fmt::format(
+                "Tangelo memory dump of {} ({:016X}), process {}\n"
+                "address    size       file offset  state  permissions\n",
+                process->codeset->name, program_id, process->process_id);
+            map.WriteString(header);
+            std::vector<u8> buffer;
+            u64 offset = 0;
+            for (const auto& [address, vma] : process->vm_manager.vma_map) {
+                if (vma.type != Kernel::VMAType::BackingMemory ||
+                    vma.meminfo_state == Kernel::MemoryState::IO ||
+                    (static_cast<u8>(vma.permissions) &
+                     static_cast<u8>(Kernel::VMAPermission::Read)) == 0 ||
+                    vma.size == 0) {
+                    continue;
+                }
+                buffer.resize(vma.size);
+                system.Memory().ReadBlock(*process, vma.base, buffer.data(), buffer.size());
+                bin.WriteBytes(buffer.data(), buffer.size());
+                map.WriteString(fmt::format("{:08X}   {:08X}   {:08X}     {:<6} {}\n", vma.base,
+                                            vma.size, offset,
+                                            static_cast<int>(vma.meminfo_state),
+                                            static_cast<int>(vma.permissions)));
+                offset += vma.size;
+            }
+            total += offset;
+            written.push_back(base + ".bin");
+            LOG_INFO(Frontend, "Dumped {} bytes of process memory of {:016X} to {}.bin", offset,
+                     program_id, base);
+        }
+    }
+
+    if (written.empty()) {
+        QMessageBox::critical(this, QStringLiteral("Tangelo"),
+                              tr("No running game found to dump.\nRefer to the log for details."));
+        return;
+    }
+    QMessageBox::information(
+        this, QStringLiteral("Tangelo"),
+        tr("Dumped %1 MB of game memory to:\n%2")
+            .arg(total / (1024 * 1024))
+            .arg(QString::fromStdString(written.front())));
+    QDesktopServices::openUrl(QUrl::fromLocalFile(QString::fromStdString(dir)));
+}
