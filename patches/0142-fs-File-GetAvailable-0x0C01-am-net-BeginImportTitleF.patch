+// am:net 0x0828: like BeginImportTitle, without the database byte. Used by the eShop's "Repair
+// software" to download a title again over the installed one; the import writes the contents
+// over the existing files as a normal import does.
+void Module::Interface::BeginImportTitleForOverWrite(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const auto media_type = static_cast<FS::MediaType>(rp.Pop<u8>());
+    const u64 title_id = rp.Pop<u64>();
+
+    LOG_INFO(Service_AM, "BeginImportTitleForOverWrite: title {:016X} media {}", title_id,
+             static_cast<u32>(media_type));
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    if (!IsInstallableMediaType(media_type)) {
+        rb.Push(ResultInvalidMediaType);
+        return;
+    }
+
+    am->importing_title =
+        std::make_shared<CurrentImportingTitle>(Core::System::GetInstance(), title_id, media_type);
+
+    std::scoped_lock lock(am->am_lists_mutex);
+    auto entries = am->am_ticket_list.find(title_id);
+    if (entries == am->am_ticket_list.end()) {
+        rb.Push(ResultUnknown);
+        return;
+    }
+    FileSys::Ticket ticket;
+    if (ticket.Load(title_id, (*entries).second) != Loader::ResultStatus::Success) {
+        rb.Push(ResultUnknown);
+        return;
+    }
+    Result res = am->importing_title->cia_file.ProvideTicket(ticket);
+    if (res.IsError()) {
+        rb.Push(res);
+        return;
+    }
+    AuthorizeCIAFileDecryption(&am->importing_title->cia_file, ctx);
+    rb.Push(ResultSuccess);
+}
+
