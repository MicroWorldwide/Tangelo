-// Tangelo: the eShop's "Repair software" check sends command 0x0C01 (4 words) on a file
-// session after ListExistingContentInfosSystem. Its meaning is unknown; answered with
-// "not implemented" (not the generic "success"), so the caller stops instead of looping, and
-// logged with the file's path so it can be identified.
-void File::UnknownCommand0C01(Kernel::HLERequestContext& ctx) {
+// FSFile:GetAvailable (0x0C010100): how much of [offset, offset + size) the file actually has.
+// Inputs: u64 offset, u64 size. Outputs: result, u64 available. Used by the eShop's "Repair
+// software" check, which walks a title's content in 1 MiB steps with it (before Build 142 the
+// generic "success" answer without a size made it loop forever). A file here is never sparse,
+// so this is the part of the range that lies inside the file.
+void File::GetAvailable(Kernel::HLERequestContext& ctx) {
     IPC::RequestParser rp(ctx);
-    const u32 w1 = rp.Pop<u32>();
-    const u32 w2 = rp.Pop<u32>();
-    const u32 w3 = rp.Pop<u32>();
-    const u32 w4 = rp.Pop<u32>();
+    const u64 offset = rp.Pop<u64>();
+    const u64 size = rp.Pop<u64>();
+
+    const FileSessionSlot* file = GetSessionData(ctx.Session());
+    u64 file_size = backend ? backend->GetSize() : 0;
+    if (file->subfile) {
+        file_size = file->size;
+    } else if (file_size > file->offset) {
+        file_size -= file->offset;
+    }
+    const u64 available = offset >= file_size ? 0 : std::min(size, file_size - offset);
+
     static u64 calls = 0;
-    if (++calls <= 5 || calls % 1000 == 0) {
-        LOG_WARNING(Service_FS,
-                    "File command 0x0C01 on {} ({} call(s)): {:#x} {:#x} {:#x} {:#x}; answered "
-                    "not implemented",
-                    GetName(), calls, w1, w2, w3, w4);
+    if (++calls <= 3) {
+        LOG_INFO(Service_FS, "GetAvailable {}: offset=0x{:x} size=0x{:x} -> 0x{:x}", GetName(),
+                 offset, size, available);
     }
-    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
-    rb.Push(Result(ErrorDescription::NotImplemented, ErrorModule::FS, ErrorSummary::NotSupported,
-                   ErrorLevel::Permanent));
+    IPC::RequestBuilder rb = rp.MakeBuilder(3, 0);
+    rb.Push(ResultSuccess);
+    rb.Push<u64>(available);
 }
 
 } // namespace Service::FS
