diff --git a/src/tests/core/hle/kernel/cpu_limiter.cpp b/src/tests/core/hle/kernel/cpu_limiter.cpp
new file mode 100644
index 0000000..a3ab3f5
--- /dev/null
+++ b/src/tests/core/hle/kernel/cpu_limiter.cpp
@@ -0,0 +1,55 @@
+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <catch2/catch_test_macros.hpp>
+#include "core/core_timing.h"
+#include "core/hle/kernel/kernel.h"
+#include "core/hle/kernel/thread.h"
+
+using Kernel::CpuLimiterMulti;
+using State = CpuLimiterMulti::SchedState;
+
+TEST_CASE("CpuLimiter only preempts for 1..89", "[kernel]") {
+    REQUIRE_FALSE(CpuLimiterMulti::IsPreemptiveCpuTime(Kernel::Core1CpuTime::PREEMPTION_DISABLED));
+    REQUIRE(CpuLimiterMulti::IsPreemptiveCpuTime(1));
+    REQUIRE(CpuLimiterMulti::IsPreemptiveCpuTime(25));
+    REQUIRE(CpuLimiterMulti::IsPreemptiveCpuTime(89));
+    REQUIRE_FALSE(CpuLimiterMulti::IsPreemptiveCpuTime(90));
+    // 1.0 titles such as Nintendo 3DS Sound are exempted, which must not starve sysmodules.
+    REQUIRE_FALSE(
+        CpuLimiterMulti::IsPreemptiveCpuTime(Kernel::Core1CpuTime::PREEMPTION_EXCEMPTED));
+}
+
+TEST_CASE("CpuLimiter Multi mode alternates within 2ms", "[kernel]") {
+    const s64 base = static_cast<s64>(nsToCycles(2'000'000));
+    REQUIRE(CpuLimiterMulti::NextState(false, State::APP) == State::SYS);
+    REQUIRE(CpuLimiterMulti::NextState(false, State::SYS) == State::APP);
+    const s64 app = CpuLimiterMulti::PhaseLength(false, State::APP, 25);
+    const s64 sys = CpuLimiterMulti::PhaseLength(false, State::SYS, 25);
+    REQUIRE(app == base * 25 / 100);
+    REQUIRE(app + sys == base);
+}
+
+TEST_CASE("CpuLimiter Single mode uses 25ms slices", "[kernel]") {
+    const s64 slice = static_cast<s64>(nsToCycles(25'000'000));
+    REQUIRE(CpuLimiterMulti::NextState(true, State::APP) == State::SYS);
+    REQUIRE(CpuLimiterMulti::NextState(true, State::SYS) == State::OTHER);
+    REQUIRE(CpuLimiterMulti::NextState(true, State::OTHER) == State::APP);
+    // Default for 1.0 titles: 25% application, 65% sysmodules, 10% other.
+    const s64 app = CpuLimiterMulti::PhaseLength(true, State::APP, 25);
+    const s64 sys = CpuLimiterMulti::PhaseLength(true, State::SYS, 25);
+    const s64 other = CpuLimiterMulti::PhaseLength(true, State::OTHER, 25);
+    REQUIRE(app == slice * 25 / 100);
+    REQUIRE(sys == slice * 65 / 100);
+    REQUIRE(other == slice * 10 / 100);
+    REQUIRE(app + sys + other <= slice);
+    REQUIRE(app + sys + other > slice - 3);
+    // Every phase has a positive length, even at the edges of the valid range.
+    for (s32 cpu : {1, 30, 89}) {
+        for (bool single : {false, true}) {
+            REQUIRE(CpuLimiterMulti::PhaseLength(single, State::APP, cpu) > 0);
+            REQUIRE(CpuLimiterMulti::PhaseLength(single, State::SYS, cpu) > 0);
+        }
+    }
+}
