diff --git a/src/core/hle/kernel/thread.cpp b/src/core/hle/kernel/thread.cpp
index 4b9fabc..82b2af2 100644
--- a/src/core/hle/kernel/thread.cpp
+++ b/src/core/hle/kernel/thread.cpp
@@ -601,15 +601,49 @@ CpuLimiter::~CpuLimiter() {}
 
 CpuLimiterMulti::CpuLimiterMulti(Kernel::KernelSystem& _kernel) : kernel(_kernel) {}
 
-void CpuLimiterMulti::Initialize(bool is_single) {
-    // TODO(PabloMK7): The is_single variable is needed to prevent
-    // registering an event twice with the same name. Once CpuLimiterSingle
-    // is implemented we can remove it.
+void CpuLimiterMulti::Initialize(bool is_single_) {
+    // is_single also keeps the two limiters from registering an event with the same name.
+    is_single = is_single_;
     tick_event = kernel.timing.RegisterEvent(
         fmt::format("Kernel::{}::tick_event", is_single ? "CpuLimiterSingle" : "CpuLimiterMulti"),
         [this](u64, s64 cycles_late) { this->OnTick(cycles_late); });
 }
 
+bool CpuLimiterMulti::IsPreemptiveCpuTime(s32 cpu_time) {
+    return cpu_time >= 1 && cpu_time <= 89;
+}
+
+CpuLimiterMulti::SchedState CpuLimiterMulti::NextState(bool is_single, SchedState state) {
+    switch (state) {
+    case SchedState::APP:
+        return SchedState::SYS;
+    case SchedState::SYS:
+        return is_single ? SchedState::OTHER : SchedState::APP;
+    case SchedState::OTHER:
+    default:
+        return SchedState::APP;
+    }
+}
+
+s64 CpuLimiterMulti::PhaseLength(bool is_single, SchedState state, s32 app_cpu_time) {
+    const s64 cpu_time = std::clamp<s64>(app_cpu_time, 1, 89);
+    if (is_single) {
+        const s64 slice = static_cast<s64>(single_slice_interval);
+        switch (state) {
+        case SchedState::APP:
+            return slice * cpu_time / 100;
+        case SchedState::SYS:
+            return slice * (90 - cpu_time) / 100;
+        case SchedState::OTHER:
+        default:
+            return slice * 10 / 100;
+        }
+    }
+    const s64 base = static_cast<s64>(base_tick_interval);
+    const s64 app_time = base * cpu_time / 100;
+    return state == SchedState::APP ? app_time : base - app_time;
+}
+
 void CpuLimiterMulti::Start() {
     if (ready) {
         return;
@@ -638,8 +672,8 @@ void CpuLimiterMulti::UpdateAppCpuLimit() {
     app_cpu_time = static_cast<u32>(kernel.ResourceLimit()
                                         .GetForCategory(Kernel::ResourceLimitCategory::Application)
                                         ->GetCurrentValue(Kernel::ResourceLimitType::CpuTime));
-    if (app_cpu_time == Core1CpuTime::PREEMPTION_DISABLED) {
-        // No preemption, disable event
+    if (!IsPreemptiveCpuTime(app_cpu_time)) {
+        // No preemption (disabled, or the application is exempted), disable event
         active = false;
         kernel.timing.UnscheduleEvent(tick_event, 0);
         WakeupSleepingThreads();
@@ -674,10 +708,15 @@ bool CpuLimiterMulti::DoTimeLimit(Thread* thread) {
     // thread needs to be time limited. This properly uses the resource limit
     // value to check if it is a sysmodule or not. We can do this instead and
     // it should be good enough. TODO(PabloMK7): fix?
-    if (thread->resource_limit_category == ResourceLimitCategory::Application &&
-            curr_state == SchedState::SYS ||
-        thread->resource_limit_category == ResourceLimitCategory::Other &&
-            curr_state == SchedState::APP) {
+    SchedState allowed_state;
+    if (thread->resource_limit_category == ResourceLimitCategory::Application) {
+        allowed_state = SchedState::APP;
+    } else if (thread->resource_limit_category == ResourceLimitCategory::Other) {
+        allowed_state = SchedState::SYS;
+    } else {
+        return false;
+    }
+    if (curr_state != allowed_state) {
         // Block thread as not in the current mode
         thread->status = ThreadStatus::WaitSleep;
         sleeping_thread_ids.push(thread->thread_id);
@@ -692,12 +731,9 @@ void CpuLimiterMulti::OnTick(s64 cycles_late) {
 }
 
 void CpuLimiterMulti::ChangeState(s64 cycles_late) {
-    curr_state = (curr_state == SchedState::SYS) ? SchedState::APP : SchedState::SYS;
+    curr_state = NextState(is_single, curr_state);
 
-    s64 next_timer = base_tick_interval * (app_cpu_time / 100.f);
-    if (curr_state == SchedState::SYS) {
-        next_timer = base_tick_interval - next_timer;
-    }
+    s64 next_timer = PhaseLength(is_single, curr_state, app_cpu_time);
     if (next_timer > cycles_late) {
         next_timer -= cycles_late;
     }
@@ -773,9 +809,6 @@ std::shared_ptr<Thread> ThreadManager::GetThreadByID(u32 thread_id) const {
 void ThreadManager::SetScheduleMode(Core1ScheduleMode mode) {
     GetCpuLimiter()->End();
     current_schedule_mode = mode;
-    if (mode == Core1ScheduleMode::Single) {
-        LOG_WARNING(Kernel, "Unimplemented \"Single\" schedule mode.");
-    }
     GetCpuLimiter()->Start();
 }
 
diff --git a/src/core/hle/kernel/thread.h b/src/core/hle/kernel/thread.h
index dd83874..2ea6884 100644
--- a/src/core/hle/kernel/thread.h
+++ b/src/core/hle/kernel/thread.h
@@ -96,8 +96,22 @@ public:
     virtual bool DoTimeLimit(Thread* thread) = 0;
 };
 
+/**
+ * Core 1 preemption, as done by the 3DS kernel.
+ * - Multi mode: alternates between sysmodule-only and application-only phases every
+ *   2ms * (cpuTime / 100).
+ * - Single mode (1.0-era titles): 25ms slices. The application gets cpuTime% of the slice,
+ *   sysmodules get (90 - cpuTime)%, and the remaining 10% goes to other (exempted) threads.
+ * See https://github.com/LumaTeam/Luma3DS/blob/e35972ea/sysmodules/pm/source/reslimit.c#L144
+ */
 class CpuLimiterMulti : public CpuLimiter {
 public:
+    enum class SchedState : u32 {
+        APP,
+        SYS,
+        OTHER, ///< Single mode only: neither application nor sysmodule threads may run.
+    };
+
     CpuLimiterMulti(Kernel::KernelSystem& kernel);
     ~CpuLimiterMulti() override = default;
 
@@ -110,23 +124,30 @@ public:
 
     bool DoTimeLimit(Thread* thread) override;
 
-private:
-    enum class SchedState : u32 {
-        APP,
-        SYS,
-    };
+    /// Whether an application CPU time value turns preemption on. Only 1..89 does: 0 disables
+    /// preemption and 10000 (and above) means the application is exempted from it.
+    static bool IsPreemptiveCpuTime(s32 cpu_time);
 
+    /// The phase that follows `state`.
+    static SchedState NextState(bool is_single, SchedState state);
+
+    /// How long `state` lasts, in cycles, for a preemptive application CPU time.
+    static s64 PhaseLength(bool is_single, SchedState state, s32 app_cpu_time);
+
+private:
     void OnTick(s64 cycles_late);
 
     void ChangeState(s64 cycles_late);
 
     void WakeupSleepingThreads();
 
-    static constexpr u64 base_tick_interval = nsToCycles(2'000'000); // 2ms
+    static constexpr u64 base_tick_interval = nsToCycles(2'000'000);    // 2ms
+    static constexpr u64 single_slice_interval = nsToCycles(25'000'000); // 25ms
 
     Kernel::KernelSystem& kernel;
     Core::TimingEventType* tick_event{};
 
+    bool is_single = false;
     bool ready = false;
     bool active = false;
     Core1CpuTime app_cpu_time = Core1CpuTime::PREEMPTION_DISABLED;
@@ -138,7 +159,7 @@ private:
     void serialize(Archive& ar, const unsigned int);
 };
 
-// TODO(PabloMK7): Replace with proper implementation
+// Both modes share one implementation; the mode is chosen in Initialize().
 using CpuLimiterSingle = CpuLimiterMulti;
 
 class ThreadManager {
