+++ b/src/core/hle/service/am/am.h
@@ -505,6 +505,12 @@ Result GetTitleInfoFromList(Core::System& system, std::span<const u64> title_id_
  */
 Result UninstallProgram(const FS::MediaType media_type, const u64 title_id);
 
+/**
+ * Makes the next title scan check every installed title again. Called by anything that
+ * installs, deletes or uninstalls a title outside the AM service.
+ */
+void ForgetScannedTitles();
+
 class Module final {
 public:
     explicit Module(Core::System& system);
@@ -1214,8 +1220,10 @@ private:
 
     /**
      * Scans all storage mediums for titles for listing.
+     * @param forget_scanned false keeps the titles earlier scans found readable (a new module
+     *        at game start); true checks every title again (after an install or delete)
      */
-    void ScanForAllTitles();
+    void ScanForAllTitles(bool forget_scanned = true);
 
     Core::System& system;
     bool cia_installing = false;
