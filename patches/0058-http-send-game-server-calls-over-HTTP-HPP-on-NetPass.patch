From bb0214ff3e8589311b64f9c0efd767ea3b641e02 Mon Sep 17 00:00:00 2001
From: Tangelo Dev <tangelo-dev@noreply.invalid>
Date: Tue, 6 Oct 2026 14:06:41 +0200
Subject: [PATCH] http: send game server calls over HTTP (HPP) on NetPass to
 the custom server

Swapdoodle calls its game server (001A2C00) over HTTP at
hpp-<id>-<env>.n.app.nintendo.net/hpp/, which NetPass replaces with
hpp-<id>-<env>.api.netpass.cafe. That host isn't a Nintendo host, so it
wasn't redirected and Swapdoodle showed 004-7006 on an offline network.
Both forms now go to the custom server, with Nintendo's host name as the
original host.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FYz3krf43qKGY6aS2Z5snz
---
 .../hle/service/http/spotpass_redirect.cpp    | 20 +++++++++++++++++--
 src/core/hle/service/http/spotpass_redirect.h |  4 +++-
 .../core/hle/service/spotpass_redirect.cpp    | 14 +++++++++++++
 3 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/src/core/hle/service/http/spotpass_redirect.cpp b/src/core/hle/service/http/spotpass_redirect.cpp
index 04b8982..c5e28db 100644
--- a/src/core/hle/service/http/spotpass_redirect.cpp
+++ b/src/core/hle/service/http/spotpass_redirect.cpp
@@ -204,6 +204,20 @@ bool IsNintendoHost(std::string_view host) {
     return false;
 }
 
+namespace {
+/// NetPass's stand-in for a game server called over HTTP ("HPP", e.g. Swapdoodle):
+/// hpp-<game server id>-<environment>.api.netpass.cafe in place of
+/// hpp-<game server id>-<environment>.n.app.nintendo.net. Returns the Nintendo host name.
+std::optional<std::string> NetPassHppHost(std::string_view host) {
+    const std::string name = GetUrlHost(host);
+    const std::string suffix = "." + std::string(NetPassHost);
+    if (!name.starts_with("hpp-") || name.size() <= suffix.size() || !name.ends_with(suffix)) {
+        return std::nullopt;
+    }
+    return name.substr(0, name.size() - suffix.size()) + ".n.app.nintendo.net";
+}
+} // namespace
+
 std::optional<NintendoRedirect> RedirectNintendoUrl(std::string_view url, std::string_view server) {
     if (IsSpotPassUrl(url)) {
         const auto wrapped = UnwrapAkamai(url);
@@ -217,14 +231,16 @@ std::optional<NintendoRedirect> RedirectNintendoUrl(std::string_view url, std::s
         }
         return NintendoRedirect{std::move(*redirected), GetSpotPassHost(url)};
     }
-    if (!IsNintendoHost(GetUrlHost(url))) {
+    auto hpp_host = NetPassHppHost(GetUrlHost(url));
+    if (!hpp_host && !IsNintendoHost(GetUrlHost(url))) {
         return std::nullopt;
     }
     auto redirected = JoinServer(server, std::string(SplitAuthority(url).second), "http");
     if (!redirected) {
         return std::nullopt;
     }
-    return NintendoRedirect{std::move(*redirected), GetUrlHost(url)};
+    return NintendoRedirect{std::move(*redirected),
+                            hpp_host ? std::move(*hpp_host) : GetUrlHost(url)};
 }
 
 std::optional<NintendoService> GetNintendoService(std::string_view url) {
diff --git a/src/core/hle/service/http/spotpass_redirect.h b/src/core/hle/service/http/spotpass_redirect.h
index d332a71..da48da3 100644
--- a/src/core/hle/service/http/spotpass_redirect.h
+++ b/src/core/hle/service/http/spotpass_redirect.h
@@ -77,7 +77,9 @@ struct NintendoRedirect {
  * Rewrites any request meant for Nintendo to the custom server `server` ("[scheme://]host[:port]
  * [/base/path]", http when no scheme is given), keeping path and query. Covers Nintendo's own
  * hosts, Akamai-wrapped SpotPass addresses and SpotPass on NetPass's mirror (see
- * RedirectSpotPassUrl for those two). Returns nullopt for other addresses or an empty server.
+ * RedirectSpotPassUrl for those two), and game servers called over HTTP on NetPass
+ * (hpp-<id>-<env>.api.netpass.cafe, e.g. Swapdoodle; original_host is then Nintendo's
+ * hpp-<id>-<env>.n.app.nintendo.net). Returns nullopt for other addresses or an empty server.
  */
 std::optional<NintendoRedirect> RedirectNintendoUrl(std::string_view url, std::string_view server);
 
diff --git a/src/tests/core/hle/service/spotpass_redirect.cpp b/src/tests/core/hle/service/spotpass_redirect.cpp
index 80d7c2b..b9b703d 100644
--- a/src/tests/core/hle/service/spotpass_redirect.cpp
+++ b/src/tests/core/hle/service/spotpass_redirect.cpp
@@ -161,6 +161,20 @@ TEST_CASE("Everything meant for Nintendo goes to the custom server", "[service][
     CHECK(mirror->url == "http://localhost:8080/p01/nsa/a/b/c?tm=4");
     CHECK(mirror->original_host == "api.netpass.cafe");
 
+    // Game servers called over HTTP (HPP): Nintendo's host and NetPass's stand-in for it.
+    const auto hpp = RedirectNintendoUrl("https://hpp-001a2c00-l1.n.app.nintendo.net/hpp/",
+                                         "localhost:8080");
+    REQUIRE(hpp);
+    CHECK(hpp->url == "http://localhost:8080/hpp/");
+    CHECK(hpp->original_host == "hpp-001a2c00-l1.n.app.nintendo.net");
+    const auto netpass_hpp =
+        RedirectNintendoUrl("https://hpp-001a2c00-l1.api.netpass.cafe/hpp/", "localhost:8080");
+    REQUIRE(netpass_hpp);
+    CHECK(netpass_hpp->url == "http://localhost:8080/hpp/");
+    CHECK(netpass_hpp->original_host == "hpp-001a2c00-l1.n.app.nintendo.net");
+    CHECK_FALSE(RedirectNintendoUrl("https://hpp-.api.netpass.cafe.example.com/hpp/",
+                                    "localhost:8080"));
+
     // NetPass's own API and other sites are left alone.
     CHECK_FALSE(RedirectNintendoUrl("https://api.netpass.cafe/api/inbox", "localhost:8080"));
     CHECK_FALSE(RedirectNintendoUrl("https://example.com/", "localhost:8080"));
