+std::map<u64, GameList::TitleEntry> GameList::GetTitles() const {
+    std::map<u64, TitleEntry> titles;
+    std::function<void(const QStandardItem*)> walk = [&](const QStandardItem* item) {
+        if (item == nullptr) {
+            return;
+        }
+        if (item->type() == static_cast<int>(GameListItemType::Game)) {
+            const u64 program_id = item->data(GameListItemPath::ProgramIdRole).toULongLong();
+            if (!titles.contains(program_id)) {
+                titles[program_id] = {item->data(GameListItemPath::TitleRole).toString(),
+                                      item->icon()};
+            }
+        }
+        for (int row = 0; row < item->rowCount(); ++row) {
+            walk(item->child(row, 0));
+        }
+    };
+    walk(item_model->invisibleRootItem());
+    return titles;
+}
