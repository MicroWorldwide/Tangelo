+using MBoxInfoHeader = Service::CECD::Module::CecMBoxInfoHeader;
+using MBoxListHeader = Service::CECD::Module::CecMBoxListHeader;
+
+constexpr u16 MBoxInfoMagic = 0x6363; // 'cc'
+constexpr u16 MBoxListMagic = 0x6868; // 'hh'
+
+std::string ToLower(std::string text) {
+    std::transform(text.begin(), text.end(), text.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return text;
+}
+
+std::string GetMBoxListPath() {
+    return GetCecPath() + DIR_SEP + "MBoxList____";
+}
+
+std::string GetNotSharedPath() {
+    return GetZipPassPath("not_shared.txt");
+}
+
+template <typename T>
+bool ReadHeader(const std::string& path, T& out) {
+    FileUtil::IOFile file(path, "rb");
+    if (!file.IsOpen() || file.GetSize() < sizeof(T)) {
+        return false;
+    }
+    return file.ReadBytes(&out, sizeof(T)) == sizeof(T);
+}
+
+std::string FormatTime(const MBoxInfoHeader::Time& time) {
+    if (time.year == 0 || time.month == 0 || time.month > 12 || time.day == 0 || time.day > 31) {
+        return {};
+    }
+    return fmt::format("{:04}-{:02}-{:02} {:02}:{:02}", u32{time.year}, time.month, time.day,
+                       time.hour, time.minute);
+}
+
+/// The CEC IDs listed in MBoxList____, in list order (empty if the file is missing or broken).
+std::vector<std::string> ReadMBoxList() {
+    MBoxListHeader list{};
+    if (!ReadHeader(GetMBoxListPath(), list) || list.magic != MBoxListMagic) {
+        return {};
+    }
+    std::vector<std::string> ids;
+    const std::size_t count = std::min<std::size_t>(list.num_boxes, list.box_names.size());
+    for (std::size_t i = 0; i < count; ++i) {
+        const auto& raw = list.box_names[i];
+        std::string name(reinterpret_cast<const char*>(raw.data()),
+                         strnlen(reinterpret_cast<const char*>(raw.data()), raw.size()));
+        ids.push_back(ToLower(name));
+    }
+    return ids;
+}
+
+std::set<std::string> ReadNotShared() {
+    std::set<std::string> ids;
+    std::string text;
+    if (!FileUtil::ReadFileToString(true, GetNotSharedPath(), text)) {
+        return ids;
+    }
+    std::istringstream lines(text);
+    std::string line;
+    while (std::getline(lines, line)) {
+        line.erase(std::remove_if(line.begin(), line.end(),
+                                  [](unsigned char c) { return std::isspace(c); }),
+                   line.end());
+        if (IsHexTitleId(line)) {
+            ids.insert(ToLower(line));
+        }
+    }
+    return ids;
+}
+
+/// sysdata/cecIds.txt: "<16-hex title ID>:<8-hex CEC ID>" lines that Tangelo writes the first
+/// time a game writes its outbox. A game's CEC ID isn't always part of its title ID (Nintendogs
+/// + Cats Toy Poodle 0004000000031600 uses box 00030b00), so this names the boxes.
+std::map<std::string, std::vector<u64>> ReadCecIdTitles() {
+    std::map<std::string, std::vector<u64>> titles;
+    std::string text;
+    if (!FileUtil::ReadFileToString(
+            true, FileUtil::GetUserPath(FileUtil::UserPath::SysDataDir) + "cecIds.txt", text)) {
+        return titles;
+    }
+    std::istringstream lines(text);
+    std::string line;
+    while (std::getline(lines, line)) {
+        if (!line.empty() && line.back() == '\r') {
+            line.pop_back();
+        }
+        line = ToLower(line);
+        if (line.size() != 25 || line[16] != ':' || line.starts_with("#") ||
+            !IsHexTitleId(line.substr(17, 8))) {
+            continue;
+        }
+        const u64 title_id = std::strtoull(line.substr(0, 16).c_str(), nullptr, 16);
+        auto& list = titles[line.substr(17, 8)];
+        if (std::find(list.begin(), list.end(), title_id) == list.end()) {
+            list.push_back(title_id);
+        }
+    }
+    return titles;
+}
+
+bool AddTreeToZip(zip_t* za, const FileUtil::FSTEntry& dir, const std::string& zip_dir,
+                  int& files) {
+    for (const auto& entry : dir.children) {
+        const std::string zip_path = zip_dir + "/" + entry.virtualName;
+        if (entry.isDirectory) {
+            if (zip_dir_add(za, zip_path.c_str(), ZIP_FL_ENC_UTF_8) < 0) {
+                return false;
+            }
+            if (!AddTreeToZip(za, entry, zip_path, files)) {
+                return false;
+            }
+            continue;
+        }
+        std::string real_path = entry.physicalName;
+#ifdef ANDROID
+        real_path = AndroidUtils::TranslateFilePath(real_path);
+#endif
+        if (!AddFileToZip(za, zip_path, FileUtil::SanitizePath(real_path))) {
+            LOG_WARNING(Frontend, "StreetPass zip: could not add {}", entry.physicalName);
+            continue;
+        }
+        files++;
+    }
+    return true;
+}
+
 } // namespace
 
