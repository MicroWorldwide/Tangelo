+    CHECK(fx.Messages(fx.Inbox()).empty());
+    const BoxInfoHeader info = fx.ReadBoxInfo();
+    CHECK(info.message_num == 0);
+    CHECK(info.box_size == 0);
+    CHECK(info.box_info_size == sizeof(BoxInfoHeader));
+    CHECK(info.max_message_num == 10); // limits kept
+    CHECK(FileUtil::GetSize(fx.Inbox() + "BoxInfo_____") == sizeof(BoxInfoHeader));
+
+    CHECK(Core::removeStreetPassBox(TitleDir) == 0);
+    CHECK_FALSE(FileUtil::IsDirectory(fx.Cec() + TitleDir));
+    const MBoxListHeader list = ReadMBoxList(fx);
+    CHECK(list.num_boxes == 2);
+    CHECK(std::string(reinterpret_cast<const char*>(list.box_names[0].data())) == "00020800");
+    CHECK(std::string(reinterpret_cast<const char*>(list.box_names[1].data())) == "00030b00");
+    CHECK(list.box_names[2][0] == 0);
+
+    CHECK(Core::removeStreetPassBox("not-hex!") == -1);
+}
