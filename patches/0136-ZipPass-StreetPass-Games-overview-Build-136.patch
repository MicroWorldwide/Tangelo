+StreetPassOverview::GameInfo StreetPassOverview::FindGame(const Core::StreetPassBox& box) const {
+    if (!lookup) {
+        return {};
+    }
+    // Games seen writing to the box first, then the usual title ID forms of the box owner.
+    std::vector<u64> candidates = box.title_ids;
+    const u32 cec = static_cast<u32>(std::strtoul(box.cec_id.c_str(), nullptr, 16));
+    for (const u32 low : {box.program_id, cec}) {
+        if (low != 0) {
+            candidates.push_back(0x0004000000000000ULL | low);
+        }
+    }
+    for (const u64 title_id : candidates) {
+        GameInfo info = lookup(title_id);
+        if (!info.name.isEmpty()) {
+            return info;
+        }
+    }
+    return {};
+}
+
+void StreetPassOverview::Refresh() {
+    const QString selected = SelectedCecId();
+    filling = true;
+    tree->setSortingEnabled(false);
+    tree->clear();
+
+    const auto boxes = Core::listStreetPassBoxes();
+    int complete = 0;
+    int shared = 0;
+    for (const auto& box : boxes) {
+        const GameInfo game = FindGame(box);
+        auto* item = new QTreeWidgetItem;
+        const QString cec_id = QString::fromStdString(box.cec_id);
+        item->setData(ColumnShared, CecIdRole, cec_id);
+        item->setFlags(item->flags() | Qt::ItemIsUserCheckable);
+        item->setCheckState(ColumnShared, box.shared ? Qt::Checked : Qt::Unchecked);
+        item->setText(ColumnGame, game.name.isEmpty() ? tr("(not in the game list)") : game.name);
+        item->setIcon(ColumnGame, game.icon);
+        if (!box.title_ids.empty()) {
+            item->setToolTip(ColumnGame,
+                             QString::fromStdString(fmt::format("{:016X}", box.title_ids.front())));
+        }
+        item->setText(ColumnCecId, cec_id);
+        QString inbox = Count(box.has_inbox, box.inbox_messages, box.inbox_max);
+        if (box.parked_messages > 0) {
+            inbox += tr(" (+%1 waiting)").arg(box.parked_messages);
+        }
+        item->setText(ColumnInbox, inbox);
+        item->setText(ColumnOutbox, Count(box.has_outbox, box.outbox_messages, box.outbox_max));
+        item->setText(ColumnLastOpened, box.last_opened.empty()
+                                            ? QStringLiteral("–")
+                                            : QString::fromStdString(box.last_opened));
+        item->setText(ColumnLastReceived, box.last_received.empty()
+                                              ? QStringLiteral("–")
+                                              : QString::fromStdString(box.last_received));
+        item->setText(ColumnStatus, StatusText(box));
+        if (!box.IsComplete()) {
+            item->setForeground(ColumnStatus, QColor(0xC0, 0x50, 0x00));
+        }
+        tree->addTopLevelItem(item);
+        if (cec_id == selected) {
+            item->setSelected(true);
+        }
+        complete += box.IsComplete() ? 1 : 0;
+        shared += box.shared ? 1 : 0;
+    }
+
+    tree->setSortingEnabled(true);
+    tree->sortByColumn(ColumnGame, Qt::AscendingOrder);
+    for (int column = 0; column < ColumnCount - 1; ++column) {
+        tree->resizeColumnToContents(column);
+    }
+    filling = false;
+
+    QString text = boxes.empty()
+                       ? tr("No StreetPass boxes yet. A game creates its box when you turn "
+                            "StreetPass on in it.")
+                       : tr("%1 game(s): %2 set up, %3 shared. Box list: %4")
+                             .arg(boxes.size())
+                             .arg(complete)
+                             .arg(shared)
+                             .arg(QString::fromStdString(Core::getStreetPassPath()));
+    if (game_running) {
+        text += tr("\nA game is running: emptying or removing boxes is only possible after "
+                   "stopping it.");
+    }
+    summary->setText(text);
+    UpdateButtons();
+}
+
+void StreetPassOverview::UpdateButtons() {
+    const bool has_selection = !SelectedCecId().isEmpty();
+    open_button->setEnabled(has_selection);
+    empty_button->setEnabled(has_selection && !game_running);
+    remove_button->setEnabled(has_selection && !game_running);
+}
+
+QString StreetPassOverview::SelectedCecId() const {
+    const auto items = tree->selectedItems();
+    return items.isEmpty() ? QString() : items.front()->data(ColumnShared, CecIdRole).toString();
+}
+
+void StreetPassOverview::OnItemChanged(QTreeWidgetItem* item, int column) {
+    if (filling || column != ColumnShared) {
+        return;
+    }
+    Core::setStreetPassShared(item->data(ColumnShared, CecIdRole).toString().toStdString(),
+                              item->checkState(ColumnShared) == Qt::Checked);
+}
+
+void StreetPassOverview::OpenSelectedFolder() {
+    const QString cec_id = SelectedCecId();
+    if (cec_id.isEmpty()) {
+        return;
+    }
+    const QString path =
+        QString::fromStdString(Core::getStreetPassPath() + "/" + cec_id.toStdString());
+    if (!FileUtil::IsDirectory(path.toStdString())) {
+        QMessageBox::warning(this, windowTitle(),
+                             tr("The box folder of %1 doesn't exist.").arg(cec_id));
+        return;
+    }
+    QDesktopServices::openUrl(QUrl::fromLocalFile(path));
+}
+
+void StreetPassOverview::EmptySelectedInbox() {
+    const QString cec_id = SelectedCecId();
+    if (cec_id.isEmpty() ||
+        QMessageBox::question(this, windowTitle(),
+                              tr("Delete every message in the inbox of %1?\nThe game won't show "
+                                 "them any more. This can't be undone.")
+                                  .arg(tree->selectedItems().front()->text(ColumnGame)),
+                              QMessageBox::Yes | QMessageBox::No,
+                              QMessageBox::No) != QMessageBox::Yes) {
+        return;
+    }
+    const int result = Core::clearStreetPassInbox(cec_id.toStdString());
+    if (result == -4) {
+        QMessageBox::critical(this, windowTitle(), tr("Stop the running game first."));
+    } else if (result < 0) {
+        QMessageBox::critical(this, windowTitle(),
+                              tr("Could not empty the inbox.\nRefer to the log for details."));
+    }
+    Refresh();
+}
+
+void StreetPassOverview::RemoveSelectedBox() {
+    const QString cec_id = SelectedCecId();
+    if (cec_id.isEmpty() ||
+        QMessageBox::question(
+            this, windowTitle(),
+            tr("Remove the StreetPass data of %1?\nIts box folder is deleted and it's taken out "
+               "of the StreetPass list, like System Settings' \"Delete StreetPass data\". The "
+               "game will ask to set StreetPass up again. This can't be undone; use Zip CEC "
+               "Folder first to keep a copy.")
+                .arg(tree->selectedItems().front()->text(ColumnGame)),
+            QMessageBox::Yes | QMessageBox::No, QMessageBox::No) != QMessageBox::Yes) {
+        return;
+    }
+    const int result = Core::removeStreetPassBox(cec_id.toStdString());
+    if (result == -4) {
+        QMessageBox::critical(this, windowTitle(), tr("Stop the running game first."));
+    } else if (result < 0) {
+        QMessageBox::critical(this, windowTitle(),
+                              tr("Could not remove the box.\nRefer to the log for details."));
+    }
+    Refresh();
+}
+
+void StreetPassOverview::OpenCecFolder() {
+    const std::string path = Core::getStreetPassPath();
+    if (!FileUtil::IsDirectory(path)) {
+        QMessageBox::warning(this, windowTitle(),
+                             tr("There is no CEC folder yet (no game has set up StreetPass)."));
+        return;
+    }
+    QDesktopServices::openUrl(QUrl::fromLocalFile(QString::fromStdString(path)));
+}
+
+void StreetPassOverview::ZipCecFolder() {
+    const QString suggested = QString::fromStdString(
+        FileUtil::GetUserPath(FileUtil::UserPath::UserDir) + "CEC-" +
+        QDateTime::currentDateTime().toString(QStringLiteral("yyyyMMdd-HHmm")).toStdString() +
+        ".zip");
+    const QString path = QFileDialog::getSaveFileName(this, tr("Zip CEC Folder"), suggested,
+                                                      tr("Zip file (*.zip)"));
+    if (path.isEmpty()) {
+        return;
+    }
+    const int files = Core::zipStreetPassFolder(path.toStdString());
+    if (files < 0) {
+        QMessageBox::critical(this, windowTitle(),
+                              tr("Could not write the zip file.\nRefer to the log for details."));
+        return;
+    }
+    QMessageBox::information(this, windowTitle(),
+                             tr("%1 file(s) from the CEC folder zipped to:\n%2")
+                                 .arg(files)
+                                 .arg(path));
+}
