+};
+
+constexpr int CecIdRole = Qt::UserRole + 1;
+
+QString StatusText(const Core::StreetPassBox& box) {
+    if (box.IsComplete()) {
+        return QObject::tr("Set up");
+    }
+    if (!box.has_folder) {
+        return QObject::tr("Listed, but the box folder is missing");
+    }
+    QStringList missing;
+    if (!box.in_box_list) {
+        missing << QObject::tr("not in MBoxList");
+    }
+    if (!box.has_box_info) {
+        missing << QStringLiteral("MBoxInfo");
+    }
+    if (!box.has_inbox) {
+        missing << QObject::tr("inbox");
+    }
+    if (!box.has_outbox) {
+        missing << QObject::tr("outbox");
+    }
+    return QObject::tr("Incomplete: %1").arg(missing.join(QStringLiteral(", ")));
+}
+
+QString Count(bool present, u32 messages, u32 max) {
+    if (!present) {
+        return QStringLiteral("–");
+    }
+    return max != 0 ? QStringLiteral("%1 / %2").arg(messages).arg(max) : QString::number(messages);
+}
