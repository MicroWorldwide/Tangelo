+std::string getStreetPassPath() {
+    return GetCecPath();
+}
+
+std::vector<StreetPassBox> listStreetPassBoxes() {
+    std::lock_guard lock(zip_pass_mutex);
+    const std::string cec = GetCecPath();
+    const std::vector<std::string> listed = ReadMBoxList();
+    const std::set<std::string> not_shared = ReadNotShared();
+    const auto cec_titles = ReadCecIdTitles();
+
+    std::set<std::string> ids(listed.begin(), listed.end());
+    FileUtil::ForeachDirectoryEntry(
+        nullptr, cec, [&ids](u64*, const std::string& directory, const std::string& name) {
+            if (IsHexTitleId(name) && FileUtil::IsDirectory(directory + DIR_SEP + name)) {
+                ids.insert(ToLower(name));
+            }
+            return true;
+        });
+
+    std::vector<StreetPassBox> boxes;
+    for (const std::string& id : ids) {
+        StreetPassBox box;
+        box.cec_id = id;
+        box.path = cec + DIR_SEP + id;
+        box.in_box_list = std::find(listed.begin(), listed.end(), id) != listed.end();
+        box.has_folder = FileUtil::IsDirectory(box.path);
+        box.shared = !not_shared.contains(id);
+        if (const auto it = cec_titles.find(id); it != cec_titles.end()) {
+            box.title_ids = it->second;
+        }
+
+        MBoxInfoHeader info{};
+        if (ReadHeader(box.path + DIR_SEP + "MBoxInfo____", info) && info.magic == MBoxInfoMagic) {
+            box.has_box_info = true;
+            box.program_id = info.program_id;
+            box.last_opened = FormatTime(info.last_accessed);
+            box.last_received = FormatTime(info.last_received);
+        }
+        BoxInfoHeader inbox{};
+        if (ReadHeader(box.path + DIR_SEP + "InBox___" + DIR_SEP + "BoxInfo_____", inbox) &&
+            inbox.magic == BoxInfoMagic) {
+            box.has_inbox = true;
+            box.inbox_messages = inbox.message_num;
+            box.inbox_max = inbox.max_message_num;
+        }
+        BoxInfoHeader outbox{};
+        if (ReadHeader(box.path + DIR_SEP + "OutBox__" + DIR_SEP + "BoxInfo_____", outbox) &&
+            outbox.magic == BoxInfoMagic) {
+            box.has_outbox = true;
+            box.outbox_messages = outbox.message_num;
+            box.outbox_max = outbox.max_message_num;
+        }
+        const std::string parked = GetZipPassPath("inboxes/" + id + "/");
+        if (FileUtil::IsDirectory(parked)) {
+            box.parked_messages = CountFiles(parked);
+        }
+        boxes.push_back(std::move(box));
+    }
+    return boxes;
+}
+
+int clearStreetPassInbox(const std::string& cec_id_in) {
+    std::lock_guard lock(zip_pass_mutex);
+    const std::string cec_id = ToLower(cec_id_in);
+    if (!IsHexTitleId(cec_id)) {
+        return -1;
+    }
+    if (isEmulationRunning()) {
+        return -4;
+    }
+    const std::string inbox = GetInboxPath(cec_id);
+    const std::string box_info_path = inbox + DIR_SEP + "BoxInfo_____";
+    FileUtil::IOFile box_file(box_info_path, "rb");
+    BoxInfoHeader info{};
+    if (!ReadBoxInfo(box_file, info)) {
+        LOG_WARNING(Frontend, "StreetPass: no valid inbox for {}", cec_id);
+        return -1;
+    }
+    box_file.Close();
+
+    int removed = 0;
+    FileUtil::ForeachDirectoryEntry(
+        nullptr, inbox, [&removed](u64*, const std::string& directory, const std::string& name) {
+            if (IsMessageFileName(name) && FileUtil::Delete(directory + DIR_SEP + name)) {
+                removed++;
+            }
+            return true;
+        });
+
+    // An empty box: header only, no message entries.
+    info.message_num = 0;
+    info.box_size = 0;
+    info.box_info_size = sizeof(BoxInfoHeader);
+    FileUtil::IOFile out(box_info_path, "wb");
+    if (!out.IsOpen() || out.WriteBytes(&info, sizeof(info)) != sizeof(info)) {
+        LOG_ERROR(Frontend, "StreetPass: failed to reset {}", box_info_path);
+        return -1;
+    }
+    out.Close();
+
+    const std::string parked = GetZipPassPath("inboxes/" + cec_id + "/");
+    if (FileUtil::IsDirectory(parked)) {
+        removed += static_cast<int>(CountFiles(parked));
+        FileUtil::DeleteDirRecursively(parked);
+    }
+    LOG_INFO(Frontend, "StreetPass: emptied the inbox of {} ({} message(s))", cec_id, removed);
+    return removed;
+}
+
+int removeStreetPassBox(const std::string& cec_id_in) {
+    std::lock_guard lock(zip_pass_mutex);
+    const std::string cec_id = ToLower(cec_id_in);
+    if (!IsHexTitleId(cec_id)) {
+        return -1;
+    }
+    if (isEmulationRunning()) {
+        return -4;
+    }
+
+    // Take it out of MBoxList____ first, keeping the other entries in order.
+    const std::string list_path = GetMBoxListPath();
+    MBoxListHeader list{};
+    if (ReadHeader(list_path, list) && list.magic == MBoxListMagic) {
+        const std::size_t count = std::min<std::size_t>(list.num_boxes, list.box_names.size());
+        std::size_t kept = 0;
+        decltype(list.box_names) names{};
+        for (std::size_t i = 0; i < count; ++i) {
+            const auto& raw = list.box_names[i];
+            const std::string name(reinterpret_cast<const char*>(raw.data()),
+                                   strnlen(reinterpret_cast<const char*>(raw.data()), raw.size()));
+            if (ToLower(name) != cec_id) {
+                names[kept++] = raw;
+            }
+        }
+        if (kept != count) {
+            list.box_names = names;
+            list.num_boxes = static_cast<u16>(kept);
+            FileUtil::IOFile out(list_path, "rb+");
+            if (!out.IsOpen() || out.WriteBytes(&list, sizeof(list)) != sizeof(list)) {
+                LOG_ERROR(Frontend, "StreetPass: failed to update {}", list_path);
+                return -1;
+            }
+        }
+    }
+
+    const std::string box = GetCecPath() + DIR_SEP + cec_id;
+    if (FileUtil::IsDirectory(box) && !FileUtil::DeleteDirRecursively(box)) {
+        LOG_ERROR(Frontend, "StreetPass: failed to delete {}", box);
+        return -1;
+    }
+    const std::string parked = GetZipPassPath("inboxes/" + cec_id + "/");
+    if (FileUtil::IsDirectory(parked)) {
+        FileUtil::DeleteDirRecursively(parked);
+    }
+    LOG_INFO(Frontend, "StreetPass: removed the box of {}", cec_id);
+    return 0;
+}
+
+int zipStreetPassFolder(const std::string& path) {
+    std::lock_guard lock(zip_pass_mutex);
+    const std::string cec = GetCecPath();
+    if (!FileUtil::IsDirectory(cec)) {
+        LOG_ERROR(Frontend, "StreetPass zip: no CEC folder at {}", cec);
+        return -1;
+    }
+    int err = 0;
+    zip_t* za = zip_open(path.c_str(), ZIP_CREATE | ZIP_TRUNCATE, &err);
+    if (za == nullptr) {
+        LOG_ERROR(Frontend, "StreetPass zip: cannot create {} (libzip error {})", path, err);
+        return -1;
+    }
+    FileUtil::FSTEntry root;
+    FileUtil::ScanDirectoryTree(cec, root, 16);
+    int files = 0;
+    const bool ok = zip_dir_add(za, "CEC", ZIP_FL_ENC_UTF_8) >= 0 &&
+                    AddTreeToZip(za, root, "CEC", files);
+    if (!ok || zip_close(za) < 0) {
+        LOG_ERROR(Frontend, "StreetPass zip: failed to write {}: {}", path, zip_strerror(za));
+        zip_discard(za);
+        return -1;
+    }
+    LOG_INFO(Frontend, "StreetPass zip: {} file(s) to {}", files, path);
+    return files;
+}
+
+bool isStreetPassShared(const std::string& cec_id) {
+    std::lock_guard lock(zip_pass_mutex);
+    return !ReadNotShared().contains(ToLower(cec_id));
+}
+
+void setStreetPassShared(const std::string& cec_id_in, bool shared) {
+    std::lock_guard lock(zip_pass_mutex);
+    const std::string cec_id = ToLower(cec_id_in);
+    if (!IsHexTitleId(cec_id)) {
+        return;
+    }
+    std::set<std::string> ids = ReadNotShared();
+    if (shared ? ids.erase(cec_id) == 0 : !ids.insert(cec_id).second) {
+        return; // no change
+    }
+    std::string text = "# StreetPass games kept on this console (not exported by ZipPass, not\n"
+                       "# sent by NetPass). One CEC ID per line; edit in ZipPass > StreetPass "
+                       "Games.\n";
+    for (const auto& id : ids) {
+        text += id + "\n";
+    }
+    FileUtil::CreateFullPath(GetZipPassPath(""));
+    FileUtil::WriteStringToFile(true, GetNotSharedPath(), text);
+    LOG_INFO(Frontend, "StreetPass: {} is {}", cec_id,
+             shared ? "shared again" : "kept on this console");
+}
+
 } // namespace Core
