From cf1a0b0dab123b94fcf3643db0bf562852216c14 Mon Sep 17 00:00:00 2001
From: Tangelo Dev <tangelo-dev@noreply.invalid>
Date: Thu, 15 Oct 2026 21:07:52 +0200
Subject: [PATCH] ac: SetInfraPriority, SetPowerSaveMode and SetZoneMacFilter

With Nintendo's own NDM module (LLE), NDM calls ac:u SetInfraPriority
(0x0026), SetPowerSaveMode (0x0028) and SetZoneMacFilter (0x003D) over and
over; they were unimplemented. They now succeed and hand the connection
config back as it came in, like SetFromApplication.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FYz3krf43qKGY6aS2Z5snz
---
 src/core/hle/service/ac/ac.cpp   | 43 ++++++++++++++++++++++++++++++++
 src/core/hle/service/ac/ac.h     | 21 ++++++++++++++++
 src/core/hle/service/ac/ac_i.cpp |  3 +++
 src/core/hle/service/ac/ac_u.cpp |  3 +++
 4 files changed, 70 insertions(+)

diff --git a/src/core/hle/service/ac/ac.cpp b/src/core/hle/service/ac/ac.cpp
index c6a458f0b..99c448373 100644
--- a/src/core/hle/service/ac/ac.cpp
+++ b/src/core/hle/service/ac/ac.cpp
@@ -161,6 +161,49 @@ void Module::Interface::GetInfraPriority(Kernel::HLERequestContext& ctx) {
     LOG_WARNING(Service_AC, "(STUBBED) called");
 }
 
+void Module::Interface::SetInfraPriority(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+
+    const u32 priority = rp.Pop<u32>();
+    const std::vector<u8>& ac_config = rp.PopStaticBuffer();
+
+    // Called by NDM (with the real NDM module) before its connection checks. Like
+    // SetFromApplication, the setting only matters to the real connection logic, so the config
+    // goes back as it came in.
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
+    rb.Push(ResultSuccess);
+    rb.PushStaticBuffer(std::move(ac_config), 0);
+
+    LOG_DEBUG(Service_AC, "called, priority={}", priority);
+}
+
+void Module::Interface::SetPowerSaveMode(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+
+    const u32 mode = rp.Pop<u32>();
+    const std::vector<u8>& ac_config = rp.PopStaticBuffer();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
+    rb.Push(ResultSuccess);
+    rb.PushStaticBuffer(std::move(ac_config), 0);
+
+    LOG_DEBUG(Service_AC, "called, mode={}", mode);
+}
+
+void Module::Interface::SetZoneMacFilter(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+
+    const u32 filter = rp.Pop<u32>();
+    const std::vector<u8>& ac_config = rp.PopStaticBuffer();
+
+    // NDM sets it (0xC1) at start; only the real Nintendo Zone scan uses it.
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
+    rb.Push(ResultSuccess);
+    rb.PushStaticBuffer(std::move(ac_config), 0);
+
+    LOG_DEBUG(Service_AC, "called, filter={:#x}", filter);
+}
+
 void Module::Interface::SetFromApplication(Kernel::HLERequestContext& ctx) {
     IPC::RequestParser rp(ctx);
 
