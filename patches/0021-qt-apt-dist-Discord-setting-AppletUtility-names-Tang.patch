+namespace {
+/// Names of the AppletUtility commands documented on 3dbrew (APT:AppletUtility).
+std::string_view AppletUtilityName(u32 command) {
+    switch (command) {
+    case 0x0:
+        return "ClearPowerButtonState";
+    case 0x2:
+        return "SetCurrentAppletSlotToHomeMenu";
+    case 0x3:
+        return "ClearExclusiveControl";
+    case 0x4:
+        return "SleepIfShellClosed";
+    case 0x5:
+        return "LockTransition";
+    case 0x6:
+        return "TryLockTransition";
+    case 0x7:
+        return "UnlockTransition";
+    case 0xA:
+        return "StartExitTask";
+    case 0xB:
+        return "SetInitialSenderId";
+    case 0xC:
+        return "SetPowerButtonClick";
+    case 0x10:
+        return "UnlockCartAndSdSlot";
+    default:
+        return {};
+    }
+}
+} // namespace
+
 void Module::APTInterface::AppletUtility(Kernel::HLERequestContext& ctx) {
     IPC::RequestParser rp(ctx);
 
-    // These are from 3dbrew - I'm not really sure what they're used for.
     const auto utility_command = rp.Pop<u32>();
     const auto input_size = rp.Pop<u32>();
     const auto output_size = rp.Pop<u32>();
     [[maybe_unused]] const auto input = rp.PopStaticBuffer();
 
-    LOG_WARNING(Service_APT,
-                "(STUBBED) called command={:#010X}, input_size={:#010X}, output_size={:#010X}",
-                utility_command, input_size, output_size);
+    // The documented commands need no emulation: the shell (lid) is never closed, and there is
+    // no transition locking or exclusive control to release, so they only have to succeed.
+    const std::string_view name = AppletUtilityName(utility_command);
+    if (!name.empty()) {
+        LOG_DEBUG(Service_APT, "called {} (command={:#x}), input_size={:#x}, output_size={:#x}",
+                  name, utility_command, input_size, output_size);
+    } else {
+        LOG_WARNING(Service_APT,
+                    "(STUBBED) called command={:#010X}, input_size={:#010X}, output_size={:#010X}",
+                    utility_command, input_size, output_size);
+    }
 
     std::vector<u8> out(output_size);
     if (utility_command == 0x6 && output_size > 0) {
