diff --git a/src/core/tangelo_report.cpp b/src/core/tangelo_report.cpp
new file mode 100644
index 0000000..70aba36
--- /dev/null
+++ b/src/core/tangelo_report.cpp
@@ -0,0 +1,162 @@
+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <algorithm>
+#include <memory>
+#include <thread>
+#include <fmt/format.h>
+#include <httplib.h>
+#include "common/file_util.h"
+#include "common/logging/log.h"
+#include "common/scm_rev.h"
+#include "common/settings.h"
+#include "common/web_util.h"
+#include "core/core.h"
+#include "core/hle/service/am/am.h"
+#include "core/hle/service/cfg/cfg.h"
+#include "core/hle/service/fs/archive.h"
+#include "core/tangelo_report.h"
+
+namespace Core {
+
+namespace {
+// Title ID high halves worth reporting: applications, demos, updates and DLC.
+constexpr u32 ReportedTitleTypes[] = {0x00040000, 0x00040002, 0x0004000E, 0x0004008C};
+
+std::string JsonString(std::string_view text) {
+    std::string out = "\"";
+    for (const char c : text) {
+        if (c == '"' || c == '\\') {
+            out += '\\';
+            out += c;
+        } else if (static_cast<unsigned char>(c) < 0x20) {
+            out += fmt::format("\\u{:04x}", static_cast<unsigned char>(c));
+        } else {
+            out += c;
+        }
+    }
+    return out + "\"";
+}
+
+constexpr std::string_view Platform() {
+#if defined(ANDROID)
+    return "android";
+#elif defined(_WIN32)
+    return "windows";
+#elif defined(__APPLE__)
+    return "macos";
+#else
+    return "linux";
+#endif
+}
+
+void ListTitleFolder(const std::string& title_path, std::vector<u64>& out) {
+    FileUtil::FSTEntry entries;
+    FileUtil::ScanDirectoryTree(title_path, entries, 1);
+    for (const FileUtil::FSTEntry& high_dir : entries.children) {
+        u32 high = 0;
+        try {
+            high = static_cast<u32>(std::stoul(high_dir.virtualName, nullptr, 16));
+        } catch (...) {
+            continue;
+        }
+        if (high_dir.virtualName.size() != 8 ||
+            std::find(std::begin(ReportedTitleTypes), std::end(ReportedTitleTypes), high) ==
+                std::end(ReportedTitleTypes)) {
+            continue;
+        }
+        for (const FileUtil::FSTEntry& low_dir : high_dir.children) {
+            if (low_dir.virtualName.size() != 8 ||
+                !FileUtil::IsDirectory(fmt::format("{}{}/{}/content", title_path,
+                                                   high_dir.virtualName, low_dir.virtualName))) {
+                continue;
+            }
+            try {
+                const u64 low = std::stoull(low_dir.virtualName, nullptr, 16);
+                out.push_back((static_cast<u64>(high) << 32) | low);
+            } catch (...) {
+            }
+        }
+    }
+}
+} // namespace
+
+std::vector<u64> ListInstalledGames() {
+    std::vector<u64> titles;
+    for (const auto media : {Service::FS::MediaType::SDMC, Service::FS::MediaType::NAND}) {
+        ListTitleFolder(Service::AM::GetMediaTitlePath(media), titles);
+    }
+    std::sort(titles.begin(), titles.end());
+    titles.erase(std::unique(titles.begin(), titles.end()), titles.end());
+    return titles;
+}
+
+std::string MakeGameReport(u64 console_id, u64 started_title, const std::vector<u64>& installed) {
+    std::string list;
+    for (const u64 title : installed) {
+        list += fmt::format("{}\"{:016X}\"", list.empty() ? "" : ",", title);
+    }
+    return fmt::format("{{\"console_id\":\"{:016X}\",\"started\":\"{:016X}\","
+                       "\"installed\":[{}],\"tangelo\":{},\"platform\":\"{}\"}}",
+                       console_id, started_title, list, JsonString(Common::g_scm_desc),
+                       Platform());
+}
+
+std::string GameReportUrl(const std::string& server) {
+    std::string url = server;
+    while (!url.empty() && (url.back() == '/' || url.back() == ' ')) {
+        url.pop_back();
+    }
+    if (url.empty()) {
+        return "";
+    }
+    if (url.find("://") == std::string::npos) {
+        url = "http://" + url;
+    }
+    return url + "/tangelo/v1/games";
+}
+
+void ReportGameStart(System& system, u64 started_title) {
+    if (!Settings::values.share_games_with_server.GetValue() ||
+        !Settings::values.use_custom_nintendo_server.GetValue() || started_title == 0) {
+        return;
+    }
+    const std::string url = GameReportUrl(Settings::values.nintendo_server_url.GetValue());
+    if (url.empty()) {
+        return;
+    }
+    u64 console_id = 0;
+    if (const auto cfg = Service::CFG::GetModule(system)) {
+        console_id = cfg->GetConsoleUniqueId();
+    }
+    // Everything the thread needs is copied: it may outlive this game.
+    std::thread([url, console_id, started_title] {
+        const std::vector<u64> installed = ListInstalledGames();
+        const std::string body = MakeGameReport(console_id, started_title, installed);
+        const Common::URLInfo info = Common::SplitUrl(url);
+        std::unique_ptr<httplib::ClientImpl> client;
+        if (info.is_https) {
+            auto ssl_client = std::make_unique<httplib::SSLClient>(info.host, info.port);
+            ssl_client->enable_server_certificate_verification(false);
+            client = std::move(ssl_client);
+        } else {
+            client = std::make_unique<httplib::ClientImpl>(info.host, info.port);
+        }
+        client->set_connection_timeout(5);
+        client->set_read_timeout(10);
+        const httplib::Headers headers{{"X-Tangelo-Original-Host", "tangelo"}};
+        const auto response = client->Post(info.path, headers, body, "application/json");
+        if (!response) {
+            LOG_WARNING(Core, "Game report for {:016X}: {} unreachable ({})", started_title, url,
+                        httplib::to_string(response.error()));
+        } else if (response->status != 200) {
+            LOG_WARNING(Core, "Game report for {:016X}: HTTP {}", started_title, response->status);
+        } else {
+            LOG_INFO(Core, "Game report sent: started {:016X}, {} installed title(s)",
+                     started_title, installed.size());
+        }
+    }).detach();
+}
+
+} // namespace Core
