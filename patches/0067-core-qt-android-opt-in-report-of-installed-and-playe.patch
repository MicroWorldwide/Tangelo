+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <string>
+#include <vector>
+#include "common/common_types.h"
+
+namespace Core {
+
+class System;
+
+/// The installed titles worth reporting (games, demos, updates, DLC) on the virtual SD card and
+/// in the NAND, read from their title folders.
+std::vector<u64> ListInstalledGames();
+
+/// The JSON body of a game report (see ReportGameStart).
+std::string MakeGameReport(u64 console_id, u64 started_title, const std::vector<u64>& installed);
+
+/// The address a game report goes to: the custom Nintendo server ("[scheme://]host[:port]
+/// [/base]", http when no scheme is given) with "/tangelo/v1/games" added to its path.
+/// Empty if the server address is empty.
+std::string GameReportUrl(const std::string& server);
+
+/**
+ * Opt-in (Settings::values.share_games_with_server, only with the custom Nintendo server):
+ * tells the server that `started_title` was started, and which games are installed, under this
+ * install's Console ID. Sent from a background thread so starting the game never waits for it;
+ * the server links the Console ID to the friends account that signed in from the same address.
+ */
+void ReportGameStart(System& system, u64 started_title);
+
+} // namespace Core
