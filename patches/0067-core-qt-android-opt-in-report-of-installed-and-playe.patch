+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <catch2/catch_test_macros.hpp>
+#include "core/tangelo_report.h"
+
+TEST_CASE("GameReportUrl adds the report path to the custom server", "[core][tangelo_report]") {
+    REQUIRE(Core::GameReportUrl("10.10.15.25:8080") == "http://10.10.15.25:8080/tangelo/v1/games");
+    REQUIRE(Core::GameReportUrl("http://server/") == "http://server/tangelo/v1/games");
+    REQUIRE(Core::GameReportUrl("https://server/base") == "https://server/base/tangelo/v1/games");
+    REQUIRE(Core::GameReportUrl("").empty());
+    REQUIRE(Core::GameReportUrl("  ").empty());
+}
+
+TEST_CASE("MakeGameReport lists the started and installed titles", "[core][tangelo_report]") {
+    const std::string body =
+        Core::MakeGameReport(0x1234ABCD5678EF00, 0x000400000014F200,
+                             {0x000400000014F200, 0x0004000E00030700});
+    REQUIRE(body.find("\"console_id\":\"1234ABCD5678EF00\"") != std::string::npos);
+    REQUIRE(body.find("\"started\":\"000400000014F200\"") != std::string::npos);
+    REQUIRE(body.find("\"installed\":[\"000400000014F200\",\"0004000E00030700\"]") !=
+            std::string::npos);
+    REQUIRE(body.find("\"platform\":") != std::string::npos);
+    REQUIRE(body.front() == '{');
+    REQUIRE(body.back() == '}');
+
+    const std::string empty = Core::MakeGameReport(1, 2, {});
+    REQUIRE(empty.find("\"installed\":[]") != std::string::npos);
+}
