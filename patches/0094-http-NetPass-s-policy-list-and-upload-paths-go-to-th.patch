From 928a83edb84e039d88b8d12742ddbe675dca0473 Mon Sep 17 00:00:00 2001
From: Tangelo Dev <tangelo-dev@noreply.invalid>
Date: Thu, 15 Oct 2026 21:33:53 +0200
Subject: [PATCH] http: NetPass's policy list and upload paths go to the server
 too

NetPass's patch for the SpotPass module points the policy list at
https://api.netpass.cafe/nppl/p01/policylist/... and uploads at /npul/.
Only /npdl/ was redirected, so with a custom Nintendo server the SpotPass
module asked NetPass for its policy list every ~14 seconds and never got
one. /nppl/ and /npul/ now go to the server like /npdl/ (prefix dropped).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FYz3krf43qKGY6aS2Z5snz
---
 .../hle/service/http/spotpass_redirect.cpp    | 37 +++++++++++++------
 .../core/hle/service/spotpass_redirect.cpp    |  7 ++++
 2 files changed, 32 insertions(+), 12 deletions(-)

diff --git a/src/core/hle/service/http/spotpass_redirect.cpp b/src/core/hle/service/http/spotpass_redirect.cpp
index 1d5a26dc6..63370f91b 100644
--- a/src/core/hle/service/http/spotpass_redirect.cpp
+++ b/src/core/hle/service/http/spotpass_redirect.cpp
@@ -19,10 +19,12 @@ constexpr std::array<std::string_view, 4> SpotPassHosts{
     "npul.c.app.nintendowifi.net", // SpotPass uploads (/p01/recv/...)
 };
 
-// NetPass rewrites SpotPass task URLs to its own mirror, which answers with a redirect to
-// Nintendo when it doesn't have a file. Only its /npdl/ paths are SpotPass.
+// NetPass rewrites SpotPass URLs to its own mirror (its patch for the SpotPass module), which
+// answers with a redirect to Nintendo when it doesn't have a file: /npdl/ = content, /nppl/ =
+// the policy list (asked every few seconds until it gets one), /npul/ = uploads. The rest of
+// its API (StreetPass relay, inbox, ...) isn't SpotPass.
 constexpr std::string_view NetPassHost = "api.netpass.cafe";
-constexpr std::string_view NetPassSpotPassPrefix = "/npdl";
+constexpr std::array<std::string_view, 3> NetPassSpotPassPrefixes{"/npdl", "/nppl", "/npul"};
 
 // Some titles (e.g. the eShop's BGM tasks) use Akamai URLs that wrap the Nintendo address:
 // https://a248.e.akamai.net/f/248/103046/10m/npdl.c.app.nintendowifi.net/p01/nsa/...
@@ -89,6 +91,22 @@ std::optional<std::pair<std::string, std::string_view>> UnwrapAkamai(std::string
     return std::make_pair(ToLower(rest.substr(1, path_start - 1)), rest.substr(path_start));
 }
 
+/// The length of the NetPass mirror prefix ("/npdl", "/nppl", "/npul") of a URL on NetPass's
+/// host, or 0 when it isn't one.
+std::size_t NetPassPrefixLength(std::string_view url) {
+    if (GetUrlHost(url) != NetPassHost) {
+        return 0;
+    }
+    const std::string_view rest = SplitAuthority(url).second;
+    for (const std::string_view prefix : NetPassSpotPassPrefixes) {
+        if (rest.starts_with(prefix) &&
+            (rest.size() == prefix.size() || rest[prefix.size()] == '/')) {
+            return prefix.size();
+        }
+    }
+    return 0;
+}
+
 } // namespace
 
 std::string GetSpotPassHost(std::string_view url) {
@@ -122,10 +140,7 @@ bool IsSpotPassUrl(std::string_view url) {
     }
     const std::string host = GetUrlHost(url);
     if (host == NetPassHost) {
-        const std::string_view rest = SplitAuthority(url).second;
-        return rest.starts_with(NetPassSpotPassPrefix) &&
-               (rest.size() == NetPassSpotPassPrefix.size() ||
-                rest[NetPassSpotPassPrefix.size()] == '/');
+        return NetPassPrefixLength(url) != 0;
     }
     return IsSpotPassHost(host);
 }
@@ -147,9 +162,7 @@ bool IsSpotPassUploadUrl(std::string_view url) {
         path = wrapped->second;
     } else {
         path = SplitAuthority(url).second;
-        if (GetUrlHost(url) == NetPassHost) {
-            path.remove_prefix(NetPassSpotPassPrefix.size());
-        }
+        path.remove_prefix(NetPassPrefixLength(url));
     }
     return path.starts_with("/p01/recv/");
 }
@@ -189,7 +202,7 @@ std::optional<std::string> RedirectSpotPassUrl(std::string_view url, std::string
     std::string rest(wrapped ? wrapped->second : SplitAuthority(url).second);
     if (!wrapped && GetUrlHost(url) == NetPassHost) {
         // NetPass's SpotPass mirror: https://api.netpass.cafe/npdl/p01/... -> <server>/p01/...
-        rest.erase(0, NetPassSpotPassPrefix.size());
+        rest.erase(0, NetPassPrefixLength(url));
     }
     return JoinServer(server, std::move(rest), "https");
 }
@@ -224,7 +237,7 @@ std::optional<NintendoRedirect> RedirectNintendoUrl(std::string_view url, std::s
         const auto wrapped = UnwrapAkamai(url);
         std::string rest(wrapped ? wrapped->second : SplitAuthority(url).second);
         if (!wrapped && GetUrlHost(url) == NetPassHost) {
-            rest.erase(0, NetPassSpotPassPrefix.size());
+            rest.erase(0, NetPassPrefixLength(url));
         }
         auto redirected = JoinServer(server, std::move(rest), "http");
         if (!redirected) {
diff --git a/src/tests/core/hle/service/spotpass_redirect.cpp b/src/tests/core/hle/service/spotpass_redirect.cpp
index 1941b8285..85a46215f 100644
--- a/src/tests/core/hle/service/spotpass_redirect.cpp
+++ b/src/tests/core/hle/service/spotpass_redirect.cpp
@@ -59,6 +59,13 @@ TEST_CASE("NetPass SpotPass mirror URLs are redirected too", "[service][http][sp
     CHECK(RedirectSpotPassUrl(mirror, "http://localhost:8080") ==
           "http://localhost:8080/p01/nsa/V04RWTNqtHWfOaEB/FGONLYT/NINTENDOZONE?tm=4");
 
+    // Its policy list and upload paths are SpotPass too.
+    CHECK(IsSpotPassUrl("https://api.netpass.cafe/nppl/p01/policylist/3/NL?ap="));
+    CHECK(RedirectSpotPassUrl("https://api.netpass.cafe/nppl/p01/policylist/3/NL?ap=",
+                              "http://s:8080") == "http://s:8080/p01/policylist/3/NL?ap=");
+    CHECK(IsSpotPassUploadUrl("https://api.netpass.cafe/npul/p01/recv/abc/sendmgn"));
+    CHECK_FALSE(IsSpotPassUrl("https://api.netpass.cafe/npplx/p01"));
+
     // The rest of NetPass's API is not SpotPass and stays untouched.
     CHECK_FALSE(IsSpotPassUrl("https://api.netpass.cafe/outbox/slot"));
     CHECK_FALSE(IsSpotPassUrl("https://api.netpass.cafe/npdlx/p01"));
