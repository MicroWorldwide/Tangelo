+void FS_USER::ReadExtSaveDataIcon(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const auto info = rp.PopRaw<ExtSaveDataInfo>();
+    const u32 size = rp.Pop<u32>();
+    auto& buffer = rp.PopMappedBuffer();
+
+    const auto icon = archives.ReadExtSaveDataIcon(static_cast<MediaType>(info.media_type),
+                                                   info.save_id_high, info.save_id_low);
+    IPC::RequestBuilder rb = rp.MakeBuilder(2, 2);
+    if (icon.Failed()) {
+        rb.Push(icon.Code());
+        rb.Push<u32>(0);
+    } else {
+        const u32 bytes = static_cast<u32>(
+            std::min<std::size_t>({icon->size(), size, buffer.GetSize()}));
+        buffer.Write(icon->data(), 0, bytes);
+        rb.Push(ResultSuccess);
+        rb.Push<u32>(bytes);
+    }
+    rb.PushMappedBuffer(buffer);
+
+    LOG_DEBUG(Service_FS, "called, media_type={} save_id={:08X}{:08X} size={:#x} result={:#x}",
+              info.media_type, info.save_id_high, info.save_id_low, size, icon.Code().raw);
+}
