+ResultVal<std::vector<u8>> ArchiveFactory_ExtSaveData::ReadExtDataIcon(const Path& path) {
+    if (IsUsingArtic()) {
+        return ResultUnknown;
+    }
+    const std::string extdata_path = GetExtSaveDataPath(mount_point, GetCorrectedPath(path));
+    if (!FileUtil::Exists(extdata_path)) {
+        return ResultNotFoundInvalidState;
+    }
+    FileUtil::IOFile icon_file(extdata_path + "icon", "rb");
+    if (!icon_file.IsOpen()) {
+        return ResultNotFound;
+    }
+    std::vector<u8> icon(icon_file.GetSize());
+    if (icon_file.ReadBytes(icon.data(), icon.size()) != icon.size()) {
+        return ResultUnknown;
+    }
+    return icon;
+}
