+void Module::Interface::ConfigureNew3DSCPU(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    // Bit 0 selects the 804 MHz clock, bit 1 the L2 cache. The emulated CPU speed is set in the
+    // emulator's own settings, so there is nothing to switch here.
+    const u8 value = rp.Pop<u8>();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push(ResultSuccess);
+
+    LOG_DEBUG(Service_PTM, "called, value={:#04x} (804 MHz: {}, L2 cache: {})", value,
+              (value & 1) != 0, (value & 2) != 0);
 }
 
