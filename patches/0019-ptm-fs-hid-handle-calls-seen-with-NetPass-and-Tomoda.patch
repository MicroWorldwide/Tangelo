+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <numeric>
+#include <catch2/catch_test_macros.hpp>
+#include "common/settings.h"
+#include "core/hle/service/ptm/ptm.h"
+
+using Service::PTM::Module;
+
+namespace {
+constexpr u64 MsPerHour = 60 * 60 * 1000;
+constexpr u64 Midnight = 843'868'800'000; // 2026-09-28 00:00, as Tomodachi Life asks for it
+} // namespace
+
+TEST_CASE("PTM step history follows the virtual step counter", "[core][ptm]") {
+    const auto old_steps = Settings::values.steps_per_hour.GetValue();
+    Settings::values.steps_per_hour = 1000;
+
+    // 10.5 hours into the day: ten full hours, half of the current one, nothing after that.
+    const u64 now = Midnight + 10 * MsPerHour + MsPerHour / 2;
+    const auto history = Module::VirtualStepHistory(Midnight, 24, now);
+    REQUIRE(history.size() == 24);
+    for (int i = 0; i < 10; i++) {
+        CHECK(history[i] == 1000);
+    }
+    CHECK(history[10] == 500);
+    for (int i = 11; i < 24; i++) {
+        CHECK(history[i] == 0);
+    }
+
+    // The hours add up to exactly what the total step count advanced by.
+    const u64 sum = std::accumulate(history.begin(), history.end(), u64{0});
+    CHECK(sum == Module::VirtualStepsAt(now) - Module::VirtualStepsAt(Midnight));
+
+    // A 0 setting means no walking at all.
+    Settings::values.steps_per_hour = 0;
+    const auto still = Module::VirtualStepHistory(Midnight, 24, now);
+    CHECK(std::accumulate(still.begin(), still.end(), u64{0}) == 0);
+
+    // The setting is 16-bit, like a history entry, so even its maximum fits in one hour.
+    Settings::values.steps_per_hour = 0xFFFF;
+    CHECK(Module::VirtualStepHistory(Midnight, 1, now)[0] == 0xFFFF);
+
+    Settings::values.steps_per_hour = old_steps;
+}
