-// Calls from the real (LLE) SpotPass module to the HLE services (http:C, ac:i, fs, ...): the
-// kernel IPC log only sees calls between LLE modules. Service_BOSS:Info; each (service, function)
-// is logged the first 20 times, then every 200th.
-static void LogBossHleCall(const std::string& service, const char* function,
-                           Kernel::HLERequestContext& context) {
-    const auto thread = context.ClientThread();
-    const auto process = thread ? thread->owner_process.lock() : nullptr;
-    if (!process || process->GetName() != "boss") {
-        return;
-    }
-    static std::mutex mutex;
-    static std::map<std::pair<std::string, std::string>, u64> counts;
-    {
-        std::scoped_lock lock{mutex};
-        const u64 n = ++counts[{service, function}];
-        if (n > 20 && n % 200 != 0) {
-            return;
-        }
-    }
-    LOG_INFO(Service_BOSS, "boss thread {} -> {}: {}", thread->thread_id, service, function);
-}
-
