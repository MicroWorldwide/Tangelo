From 5820ea54870071540385a345202039ddf243396d Mon Sep 17 00:00:00 2001
From: Tangelo Dev <tangelo-dev@noreply.invalid>
Date: Fri, 16 Oct 2026 20:26:32 +0200
Subject: [PATCH] Remove the SpotPass hang diagnostics

The Badge Arcade hang is solved (policy list, server build 2026-10-16.19), so
the diagnostics from 0107 and 0108 go: boss thread waits, address arbiter and
sleep logging, and boss's calls to HLE services. The boss/ndm call log from
0105/0106 stays, at Service_BOSS:Debug, except NDM pausing and resuming
SpotPass (ndm -> boss), which stays at Info to show whether background
SpotPass runs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FYz3krf43qKGY6aS2Z5snz
---
 BUILD-NUMBER                     |  2 +-
 src/core/hle/kernel/ipc.cpp      | 17 +++++--
 src/core/hle/kernel/svc.cpp      | 87 ++------------------------------
 src/core/hle/service/service.cpp | 26 ----------
 4 files changed, 16 insertions(+), 116 deletions(-)

diff --git a/BUILD-NUMBER b/BUILD-NUMBER
index 58c9bdf9d..194b81caa 100644
--- a/BUILD-NUMBER
+++ b/BUILD-NUMBER
@@ -1 +1 @@
-111
+112
diff --git a/src/core/hle/kernel/ipc.cpp b/src/core/hle/kernel/ipc.cpp
index fe4db4788..2d16ecb1c 100644
--- a/src/core/hle/kernel/ipc.cpp
+++ b/src/core/hle/kernel/ipc.cpp
@@ -44,7 +44,7 @@ void LogFailedReply(const std::string& server, const std::string& client, u32 he
 }
 
 // Calls to and from the real (LLE) SpotPass module (boss) and the network daemon manager
-// (ndm, which suspends and resumes boss while the HOME Menu starts applications): one line per request and reply, so a stuck
+// (ndm, which pauses and resumes boss and StreetPass): one line per request and reply, so a stuck
 // SpotPass download can be followed (which game asked for what, what boss answered). With the
 // online LLE modules boss logs nothing itself; before this, only failed replies were visible.
 // Repeats of the same call are cut down (the first 20, then every 100th).
@@ -63,9 +63,15 @@ static void LogBossCall(Memory::MemorySystem& memory, Process& src, Process& dst
             return;
         }
     }
+    // Service_BOSS:Debug, except NDM pausing and resuming SpotPass (ndm -> boss), which is
+    // rare and tells whether background SpotPass runs at all.
+    const bool ndm_boss = src.GetName() == "ndm" && dst.GetName() == "boss";
+    const auto level = ndm_boss && !reply && command <= 0x0004 ? Common::Log::Level::Info
+                                                               : Common::Log::Level::Debug;
     if (reply) {
-        LOG_INFO(Service_BOSS, "{} -> {}: reply to command 0x{:04X}: 0x{:08X}", src.GetName(),
-                 dst.GetName(), command, result);
+        LOG_GENERIC(Common::Log::Class::Service_BOSS, Common::Log::Level::Debug,
+                    "{} -> {}: reply to command 0x{:04X}: 0x{:08X}", src.GetName(), dst.GetName(),
+                    command, result);
         return;
     }
     // A task ID (up to 8 characters) in the request's first mapped buffer, e.g. StartTask,
@@ -89,8 +95,9 @@ static void LogBossCall(Memory::MemorySystem& memory, Process& src, Process& dst
     for (std::size_t i = 1; i < untranslated_size && i <= 4; ++i) {
         params += fmt::format("{}{:08X}", i == 1 ? " params " : " ", cmd_buf[i]);
     }
-    LOG_INFO(Service_BOSS, "{} -> {}: command 0x{:04X} (header 0x{:08X}){}{}{}", src.GetName(),
-             dst.GetName(), command, header, task.empty() ? "" : " task ", task, params);
+    LOG_GENERIC(Common::Log::Class::Service_BOSS, level,
+                "{} -> {}: command 0x{:04X} (header 0x{:08X}){}{}{}", src.GetName(), dst.GetName(),
+                command, header, task.empty() ? "" : " task ", task, params);
 }
 
 Result TranslateCommandBuffer(Kernel::KernelSystem& kernel, Memory::MemorySystem& memory,
