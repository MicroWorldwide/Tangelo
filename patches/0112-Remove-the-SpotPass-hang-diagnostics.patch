-/// What the real (LLE) SpotPass module's threads block on (boss only, Service_BOSS:Info). Used
-/// for the Badge Arcade hang when it is started from the HOME Menu: the module fetches the policy
-/// list and then goes idle without downloading. Each distinct wait (thread, objects, timeout) is
-/// logged the first 10 times, then every 200th.
-static void LogBossWait(Core::System& system, const Thread* thread,
-                        const std::vector<std::shared_ptr<WaitObject>>& objects, s64 nano_seconds,
-                        bool wait_all) {
-    auto& kernel = system.Kernel();
-    const auto process = kernel.GetCurrentProcess();
-    if (!thread || process->GetName() != "boss") {
-        return;
-    }
-    std::string what;
-    for (const auto& object : objects) {
-        what += fmt::format(" {}:{}#{}", object->GetTypeName(), object->GetName(),
-                            object->GetObjectId());
-    }
-    static std::mutex mutex;
-    static std::map<std::string, u64> counts;
-    const std::string key = fmt::format("{}|{}|{}", thread->thread_id, what, nano_seconds);
-    {
-        std::scoped_lock lock{mutex};
-        const u64 n = ++counts[key];
-        if (n > 10 && n % 200 != 0) {
-            return;
-        }
-    }
-    auto& core = system.GetRunningCore();
-    LOG_INFO(Service_BOSS, "boss thread {} waits ({}{}){} (pc 0x{:08X}, lr 0x{:08X})",
-             thread->thread_id, wait_all ? "all of" : "any of", what,
-             nano_seconds < 0 ? ", no timeout"
-                              : fmt::format(", timeout {} ms", nano_seconds / 1000000),
-             core.GetPC(), core.GetReg(14));
-}
-
-/// Address arbiter use and sleeps of the SpotPass module's threads (boss only, Service_BOSS:Info):
-/// system modules block on their own light events and critical sections through
-/// ArbitrateAddress, which WaitSynchronization logging doesn't see. Each distinct (thread, kind,
-/// address) is logged the first 10 times, then every 500th.
-static void LogBossArbiter(Core::System& system, const Thread* thread, const char* kind,
-                           u32 address, s64 value, s64 nano_seconds) {
-    auto& kernel = system.Kernel();
-    const auto process = kernel.GetCurrentProcess();
-    if (!thread || process->GetName() != "boss") {
-        return;
-    }
-    static std::mutex mutex;
-    static std::map<std::tuple<u32, std::string, u32>, u64> counts;
-    {
-        std::scoped_lock lock{mutex};
-        const u64 n = ++counts[{thread->thread_id, kind, address}];
-        if (n > 10 && n % 500 != 0) {
-            return;
-        }
-    }
-    auto& core = system.GetRunningCore();
-    const u32 now = address ? system.Memory().Read32(address) : 0;
-    LOG_INFO(Service_BOSS,
-             "boss thread {} {} address 0x{:08X} (now {}) value {}{} (pc 0x{:08X}, lr 0x{:08X})",
-             thread->thread_id, kind, address, static_cast<s32>(now), value,
-             nano_seconds < 0 ? ""
-                              : fmt::format(", timeout {} ms", nano_seconds / 1000000),
-             core.GetPC(), core.GetReg(14));
-}
-
 /// Logs what a wait on an invalid handle was about: the waiting thread and, if the handle was
 /// closed shortly before, who closed it and what it was.
 static void LogInvalidWaitHandle(Core::System& system, Handle handle, VAddr handles_address,
@@ -940,7 +872,6 @@ Result SVC::WaitSynchronization1(Handle handle, s64 nano_seconds) {
 
     if (object->ShouldWait(thread)) {
         R_UNLESS(nano_seconds != 0, ResultTimeout);
-        LogBossWait(system, thread, {object}, nano_seconds, false);
 
         thread->wait_objects = {object};
         object->AddWaitingThread(SharedFrom(thread));
@@ -1009,8 +940,6 @@ Result SVC::WaitSynchronizationN(s32* out, VAddr handles_address, s32 handle_cou
         // suspending the thread.
         R_UNLESS(nano_seconds != 0, ResultTimeout);
 
-        LogBossWait(system, thread, objects, nano_seconds, true);
-
         // Put the thread to sleep
         thread->status = ThreadStatus::WaitSynchAll;
 
@@ -1053,8 +982,6 @@ Result SVC::WaitSynchronizationN(s32* out, VAddr handles_address, s32 handle_cou
         // suspending the thread.
         R_UNLESS(nano_seconds != 0, ResultTimeout);
 
-        LogBossWait(system, thread, objects, nano_seconds, false);
-
         // Put the thread to sleep
         thread->status = ThreadStatus::WaitSynchAny;
 
@@ -1275,15 +1202,9 @@ Result SVC::ArbitrateAddress(Handle handle, u32 address, u32 type, u32 value, s6
         kernel.GetCurrentProcess()->handle_table.Get<AddressArbiter>(handle);
     R_UNLESS(arbiter, ResultInvalidHandle);
 
-    Thread* current = kernel.GetCurrentThreadManager().GetCurrentThread();
-    auto res = arbiter->ArbitrateAddress(SharedFrom(current), static_cast<ArbitrationType>(type),
-                                         address, value, nanoseconds);
-    if (current->status == ThreadStatus::WaitArb) {
-        LogBossArbiter(system, current, "waits on", address, value,
-                       type == 3 || type == 4 ? nanoseconds : -1);
-    } else if (type == 0) {
-        LogBossArbiter(system, current, "signals", address, value, -1);
-    }
+    auto res =
+        arbiter->ArbitrateAddress(SharedFrom(kernel.GetCurrentThreadManager().GetCurrentThread()),
+                                  static_cast<ArbitrationType>(type), address, value, nanoseconds);
 
     // TODO(Subv): Identify in which specific cases this call should cause a reschedule.
     system.PrepareReschedule();
@@ -1792,8 +1713,6 @@ void SVC::SleepThread(s64 nanoseconds) {
         return;
     }
 
-    LogBossArbiter(system, thread_manager.GetCurrentThread(), "sleeps", 0, 0, nanoseconds);
-
     // Sleep current thread and check for next thread to schedule
     thread_manager.WaitCurrentThread_Sleep();
 
