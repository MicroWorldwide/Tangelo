     core/zip_pass.cpp
     precompiled_headers.h
     audio_core/hle/hle.cpp
diff --git a/src/tests/core/system_titles.cpp b/src/tests/core/system_titles.cpp
new file mode 100644
index 0000000..2df00f8
--- /dev/null
+++ b/src/tests/core/system_titles.cpp
@@ -0,0 +1,17 @@
+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <catch2/catch_test_macros.hpp>
+#include "core/system_titles.h"
+
+TEST_CASE("GetSystemTitleRegion maps applet titles to their region", "[core]") {
+    // Software Keyboard: JPN C002, USA C802, EUR D002 (AUS shares the EUR title).
+    CHECK(Core::GetSystemTitleRegion(0x000400300000C002) == 0u);
+    CHECK(Core::GetSystemTitleRegion(0x000400300000C802) == 1u);
+    CHECK(Core::GetSystemTitleRegion(0x000400300000D002) == 2u);
+
+    // Games and unknown titles have no system region.
+    CHECK_FALSE(Core::GetSystemTitleRegion(0x00040000000EA900).has_value());
+    CHECK_FALSE(Core::GetSystemTitleRegion(0x0004003000FFFF02).has_value());
+}
