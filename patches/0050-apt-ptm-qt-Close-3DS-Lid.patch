+void AppletManager::RequestShellState(bool closed) {
+    requested_shell_state.store(closed ? 1 : 0);
+}
+
+void AppletManager::ApplyShellState(bool closed) {
+    if (closed == shell_closed) {
+        return;
+    }
+    shell_closed = closed;
+    if (const auto ptm = Service::PTM::GetModule(system)) {
+        ptm->SetShellOpen(!closed);
+    }
+
+    if (closed) {
+        LOG_INFO(Service_APT, "3DS lid closed: asking the software to sleep");
+        sleep_query_pending = true;
+        SendNotificationToAll(Notification::SleepQuery);
+        return;
+    }
+
+    if (sleeping) {
+        LOG_INFO(Service_APT, "3DS lid opened: waking up");
+        SendNotificationToAll(Notification::SleepAwake);
+    } else if (sleep_query_pending) {
+        LOG_INFO(Service_APT, "3DS lid opened before the software accepted sleep");
+        SendNotificationToAll(Notification::SleepCancelledByOpen);
+    } else {
+        LOG_INFO(Service_APT, "3DS lid opened");
+    }
+    sleeping = false;
+    sleep_query_pending = false;
+}
+
+void AppletManager::ReplySleepQuery(AppletId from_applet_id, SleepQueryReply reply) {
+    if (!shell_closed || !sleep_query_pending) {
+        return; // a reply without a lid close (or after opening it again)
+    }
+    switch (reply) {
+    case SleepQueryReply::Accept: {
+        LOG_INFO(Service_APT, "{:03X} accepts sleep", from_applet_id);
+        sleep_query_pending = false;
+        sleeping = true;
+        const auto slot = GetAppletSlotFromId(from_applet_id);
+        if (slot != AppletSlot::Error) {
+            const auto slot_data = GetAppletSlot(slot);
+            if (slot_data->registered) {
+                slot_data->notification = Notification::SleepAccepted;
+                slot_data->notification_event->Signal();
+            }
+        }
+        break;
+    }
+    case SleepQueryReply::Reject:
+        LOG_INFO(Service_APT, "{:03X} doesn't want to sleep now", from_applet_id);
+        sleep_query_pending = false;
+        break;
+    case SleepQueryReply::Later:
+    default:
+        break; // it replies again when it's ready
+    }
+}
+
 void AppletManager::ButtonUpdateEvent(std::uintptr_t user_data, s64 cycles_late) {
     if (is_device_reload_pending.exchange(false)) {
         LoadInputDevices();
     }
 
+    if (const int lid = requested_shell_state.exchange(-1); lid >= 0) {
