+void Module::Interface::SetPhotoMode(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const CameraSet camera_select(rp.Pop<u8>());
+    const u8 photo_mode = rp.Pop<u8>();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    // The photo mode (normal, portrait, landscape, night view, letter) only tunes the real
+    // camera's image processing; the emulated cameras have nothing to tune.
+    if (camera_select.IsValid() && photo_mode <= 4) {
+        rb.Push(ResultSuccess);
+    } else {
+        LOG_ERROR(Service_CAM, "invalid camera_select={}, photo_mode={}", camera_select.m_val,
+                  photo_mode);
+        rb.Push(ResultInvalidEnumValue);
+    }
+
+    LOG_DEBUG(Service_CAM, "called, camera_select={}, photo_mode={}", camera_select.m_val,
+              photo_mode);
+}
