From 52abf565931a33fe3f1b3bada63a2fddaa5a6141 Mon Sep 17 00:00:00 2001
From: Tangelo Dev <tangelo-dev@noreply.invalid>
Date: Wed, 14 Oct 2026 22:31:41 +0200
Subject: [PATCH] soc: Nintendo host names resolve to the custom Nintendo server

Games look some Nintendo hosts up themselves instead of going through
HTTP, e.g. the NAT check servers nncs1/nncs2.app.nintendowifi.net that
Mario Golf: World Tour asks before playing online together. With a custom
Nintendo server, GetHostByName and GetAddrInfo now look up the server's
host for those names (logged), so the check reaches it. The asked-for
name is logged at debug level.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FYz3krf43qKGY6aS2Z5snz
---
 src/core/hle/service/soc/soc_u.cpp | 29 +++++++++++++++++++++++++++--
 1 file changed, 27 insertions(+), 2 deletions(-)

diff --git a/src/core/hle/service/soc/soc_u.cpp b/src/core/hle/service/soc/soc_u.cpp
index 2bf9d13..600681c 100644
--- a/src/core/hle/service/soc/soc_u.cpp
+++ b/src/core/hle/service/soc/soc_u.cpp
@@ -13,11 +13,13 @@
 #include "common/common_types.h"
 #include "common/logging/log.h"
 #include "common/scope_exit.h"
+#include "common/settings.h"
 #include "common/swap.h"
 #include "core/core.h"
 #include "core/hle/ipc_helpers.h"
 #include "core/hle/kernel/shared_memory.h"
 #include "core/hle/result.h"
+#include "core/hle/service/http/spotpass_redirect.h"
 #include "core/hle/service/soc/soc_u.h"
 #include "network/socket_manager.h"
 
@@ -1721,13 +1723,33 @@ void SOC_U::GetHostByAddr(Kernel::HLERequestContext& ctx) {
     LOG_DEBUG(Service_SOC, "called, ret={}", static_cast<s32>(ret));
 }
 
+/// The host name to look up for a name a game asks for. With a custom Nintendo server, Nintendo's
+/// own host names go to that server: games look some of them up themselves, outside the HTTP
+/// redirect (the NAT check servers nncs1/nncs2.app.nintendowifi.net used before playing online
+/// together). Without it, or for any other name, the name itself.
+static std::string HostNameToResolve(const char* name) {
+    std::string host(name ? name : "");
+    if (Settings::values.use_custom_nintendo_server.GetValue() && HTTP::IsNintendoHost(host)) {
+        std::string server = HTTP::GetUrlHost(Settings::values.nintendo_server_url.GetValue());
+        if (!server.empty()) {
+            LOG_INFO(Service_SOC, "{} looked up as {} (custom Nintendo server)", host, server);
+            return server;
+        }
+    }
+    return host;
+}
+
 void SOC_U::GetHostByName(Kernel::HLERequestContext& ctx) {
     IPC::RequestParser rp(ctx);
     [[maybe_unused]] u32 name_len = rp.Pop<u32>();
     [[maybe_unused]] u32 out_buf_len = rp.Pop<u32>();
     auto host_name = rp.PopStaticBuffer();
+    host_name.push_back(0);
 
-    struct hostent* result = ::gethostbyname(reinterpret_cast<char*>(host_name.data()));
+    const char* asked = reinterpret_cast<const char*>(host_name.data());
+    const std::string lookup = HostNameToResolve(asked);
+    LOG_DEBUG(Service_SOC, "host name {}", asked);
+    struct hostent* result = ::gethostbyname(lookup.c_str());
 
     IPC::RequestBuilder rb = rp.MakeBuilder(2, 2);
     rb.Push(ResultSuccess);
@@ -2042,7 +2064,10 @@ void SOC_U::GetAddrInfoImpl(Kernel::HLERequestContext& ctx) {
     auto service = rp.PopStaticBuffer();
     auto hints_buff = rp.PopStaticBuffer();
 
-    const char* node_data = node_length > 0 ? reinterpret_cast<const char*>(node.data()) : nullptr;
+    node.push_back(0);
+    const std::string node_lookup =
+        node_length > 0 ? HostNameToResolve(reinterpret_cast<const char*>(node.data())) : "";
+    const char* node_data = node_length > 0 ? node_lookup.c_str() : nullptr;
     const char* service_data =
         service_length > 0 ? reinterpret_cast<const char*>(service.data()) : nullptr;
 
