+    std::size_t index = compressed.size() - top;
+    std::size_t stop_index = compressed.size() - bottom;
 
     std::memset(decompressed.data(), 0, decompressed.size());
     std::memcpy(decompressed.data(), compressed.data(), compressed.size());
