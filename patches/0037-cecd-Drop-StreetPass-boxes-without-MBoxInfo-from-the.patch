 Module::~Module() = default;
 
+std::vector<std::string> Module::GetValidBoxNames() const {
+    std::vector<std::string> boxes;
+    FileSys::Path root_path(GetCecDataPathTypeAsString(CecDataPathType::RootDir, 0).data());
+    auto dir_result = cecd_system_save_data_archive->OpenDirectory(root_path);
+    if (dir_result.Failed()) {
+        return boxes;
+    }
+    auto root_dir = std::move(dir_result).Unwrap();
+    std::vector<FileSys::Entry> entries(64);
+    const u32 entry_count = root_dir->Read(static_cast<u32>(entries.size()), entries.data());
+    root_dir->Close();
+
+    FileSys::Mode read_mode;
+    read_mode.read_flag.Assign(1);
+    for (u32 i = 0; i < entry_count; i++) {
+        if (!entries[i].is_directory) {
+            continue;
+        }
+        std::string name = Common::UTF16ToUTF8(std::u16string(entries[i].filename));
+        std::transform(name.begin(), name.end(), name.begin(),
+                       [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+        const FileSys::Path info_path(fmt::format("/CEC/{}/MBoxInfo____", name).c_str());
+        auto info = cecd_system_save_data_archive->OpenFile(info_path, read_mode);
+        if (info.Failed()) {
+            LOG_DEBUG(Service_CECD, "Box {} has no MBoxInfo____, not listed", name);
+            continue;
+        }
+        std::move(info).Unwrap()->Close();
+        boxes.push_back(std::move(name));
+    }
+    return boxes;
+}
+
+void Module::RefreshMBoxList() {
+    const FileSys::Path list_path(GetCecDataPathTypeAsString(CecDataPathType::MboxList, 0).data());
+    FileSys::Mode mode;
+    mode.read_flag.Assign(1);
+    mode.write_flag.Assign(1);
+    auto file_result = cecd_system_save_data_archive->OpenFile(list_path, mode);
+    if (file_result.Failed()) {
+        return;
+    }
+    auto file = std::move(file_result).Unwrap();
+    if (file->GetSize() != sizeof(CecMBoxListHeader)) {
+        file->Close();
+        return;
+    }
+    std::vector<u8> original(sizeof(CecMBoxListHeader));
+    if (file->Read(0, original.size(), original.data()).Failed()) {
+        file->Close();
+        return;
+    }
+    std::vector<u8> updated = original;
+    CheckAndUpdateFile(CecDataPathType::MboxList, 0, updated);
+    if (updated != original) {
+        LOG_INFO(Service_CECD, "Removed deleted StreetPass boxes from MBoxList____");
+        file->Write(0, updated.size(), true, false, updated.data());
+    }
+    file->Close();
+}
+
 std::vector<std::string> MergeMBoxList(const std::vector<std::string>& listed,
                                        const std::vector<std::string>& box_dirs,
                                        std::string_view add_box, std::size_t max_boxes) {
diff --git a/src/core/hle/service/cecd/cecd.h b/src/core/hle/service/cecd/cecd.h
index 6be3045..02afb35 100644
--- a/src/core/hle/service/cecd/cecd.h
+++ b/src/core/hle/service/cecd/cecd.h
@@ -641,6 +641,13 @@ private:
 
     std::string GetCecCommandAsString(const CecCommand command) const;
 
+    /// Box folders in /CEC that hold a MBoxInfo____, i.e. StreetPass boxes that really exist.
+    std::vector<std::string> GetValidBoxNames() const;
+
+    /// Rewrites /CEC/MBoxList____ without boxes whose folder or MBoxInfo____ is gone (deleted
+    /// boxes, cleared StreetPass data), so System Settings doesn't show empty entries.
+    void RefreshMBoxList();
+
     void CheckAndUpdateFile(const CecDataPathType path_type, const u32 ncch_program_id,
                             std::vector<u8>& file_buffer);
 
