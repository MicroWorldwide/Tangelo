+void Module::Interface::IsDataTitleInUse(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const auto media_type = rp.Pop<u8>();
+    const u64 title_id = rp.Pop<u64>();
