     LOG_WARNING(Service_AC, "(STUBBED) called");
 }
 
+void Module::Interface::GetLastErrorCode(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(2, 0);
+    rb.Push(ResultSuccess);
+    rb.Push<u32>(0); // no connection error
+
+    LOG_DEBUG(Service_AC, "called");
+}
+
+void Module::Interface::SetNetworkArea(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 area = rp.Pop<u32>();
+    const std::vector<u8>& ac_config = rp.PopStaticBuffer();
+
+    // Like SetFromApplication: only the real connection logic uses it; the config goes back.
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
+    rb.Push(ResultSuccess);
+    rb.PushStaticBuffer(std::move(ac_config), 0);
+
+    LOG_DEBUG(Service_AC, "called, area={}", area);
+}
+
+namespace {
+/// The SSID Tangelo's virtual access point has while connected (see GetCurrentAPInfo).
+std::string_view ConnectingSsid(bool connected) {
+    if (!connected) {
+        return {};
+    }
+    return IsNintendoZoneMode() ? NintendoZoneSSID : std::string_view{"Tangelo"};
+}
+} // namespace
+
+void Module::Interface::GetConnectingSecurityMode(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(2, 0);
+    rb.Push(ResultSuccess);
+    rb.Push<u32>(0); // open network, like a Nintendo Zone hotspot
+
+    LOG_DEBUG(Service_AC, "called");
+}
+
+void Module::Interface::GetConnectingSsid(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+
+    const std::string_view ssid = ConnectingSsid(ac->ac_connected);
+    std::vector<u8> buffer(0x20, 0);
+    std::memcpy(buffer.data(), ssid.data(), std::min(ssid.size(), buffer.size()));
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
+    rb.Push(ResultSuccess);
+    rb.PushStaticBuffer(std::move(buffer), 0);
+
+    LOG_DEBUG(Service_AC, "called, ssid={}", ssid);
+}
+
+void Module::Interface::GetConnectingSsidLength(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(2, 0);
+    rb.Push(ResultSuccess);
+    rb.Push<u32>(static_cast<u32>(ConnectingSsid(ac->ac_connected).size()));
+
+    LOG_DEBUG(Service_AC, "called");
+}
