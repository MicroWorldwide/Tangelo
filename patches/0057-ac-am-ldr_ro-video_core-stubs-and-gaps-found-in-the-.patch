diff --git a/src/core/hle/service/ldr_ro/cro_helper.cpp b/src/core/hle/service/ldr_ro/cro_helper.cpp
index ac0e9c1..19e6593 100644
--- a/src/core/hle/service/ldr_ro/cro_helper.cpp
+++ b/src/core/hle/service/ldr_ro/cro_helper.cpp
@@ -78,13 +78,48 @@ Result CROHelper::ApplyRelocation(VAddr target_address, RelocationType relocatio
         system.Memory().Write32(target_address, symbol_address + addend - target_future_address);
         system.InvalidateCacheRange(target_address, sizeof(u32));
         break;
-    case RelocationType::ThumbBranch:
-    case RelocationType::ArmBranch:
-    case RelocationType::ModifyArmBranch:
-    case RelocationType::AlignedRelativeAddress:
-        // TODO(wwylele): implement other types
-        UNIMPLEMENTED();
+    case RelocationType::ArmBranch:       // R_ARM_CALL: BL/BLX imm24
+    case RelocationType::ModifyArmBranch: { // R_ARM_JUMP24: B/BL imm24
+        u32 instruction = system.Memory().Read32(target_address);
+        const bool to_thumb = (symbol_address & 1) != 0;
+        const s32 offset =
+            static_cast<s32>((symbol_address & ~1u) + addend - target_future_address);
+        if (relocation_type == RelocationType::ArmBranch && to_thumb) {
+            // A call into Thumb code becomes BLX (unconditional, H bit = halfword offset).
+            instruction = 0xFA000000 | ((static_cast<u32>(offset) & 2) << 23) |
+                          ((static_cast<u32>(offset) >> 2) & 0x00FFFFFF);
+        } else {
+            if (relocation_type == RelocationType::ArmBranch && (instruction >> 28) == 0xF) {
+                instruction = 0xEB000000; // a BLX into ARM code becomes BL again
+            }
+            instruction = (instruction & 0xFF000000) | ((static_cast<u32>(offset) >> 2) & 0x00FFFFFF);
+        }
+        system.Memory().Write32(target_address, instruction);
+        system.InvalidateCacheRange(target_address, sizeof(u32));
         break;
+    }
+    case RelocationType::ThumbBranch: { // R_ARM_THM_CALL: Thumb BL/BLX pair
+        const bool to_arm = (symbol_address & 1) == 0;
+        // BLX into ARM code is relative to the word-aligned PC.
+        const u32 base = to_arm ? (target_future_address & ~3u) : target_future_address;
+        const u32 offset = (symbol_address & ~1u) + addend - base;
+        const u16 high = static_cast<u16>(0xF000 | ((offset >> 12) & 0x07FF));
+        u16 low = static_cast<u16>((to_arm ? 0xE800 : 0xF800) | ((offset >> 1) & 0x07FF));
+        if (to_arm) {
+            low &= ~1; // BLX targets must be word aligned
+        }
+        system.Memory().Write16(target_address, high);
+        system.Memory().Write16(target_address + 2, low);
+        system.InvalidateCacheRange(target_address, sizeof(u32));
+        break;
+    }
+    case RelocationType::AlignedRelativeAddress: { // R_ARM_PREL31
+        const u32 old_value = system.Memory().Read32(target_address);
+        const u32 value = (symbol_address + addend - target_future_address) & 0x7FFFFFFF;
+        system.Memory().Write32(target_address, (old_value & 0x80000000) | value);
+        system.InvalidateCacheRange(target_address, sizeof(u32));
+        break;
+    }
     default:
         return CROFormatError(0x22);
     }
@@ -105,8 +140,8 @@ Result CROHelper::ClearRelocation(VAddr target_address, RelocationType relocatio
     case RelocationType::ArmBranch:
     case RelocationType::ModifyArmBranch:
     case RelocationType::AlignedRelativeAddress:
-        // TODO(wwylele): implement other types
-        UNIMPLEMENTED();
+        // Branches keep their instruction bits: an unloaded module's branches are pointed at the
+        // unresolved-symbol handler by the reset batches instead, so nothing is cleared here.
         break;
     default:
         return CROFormatError(0x22);
