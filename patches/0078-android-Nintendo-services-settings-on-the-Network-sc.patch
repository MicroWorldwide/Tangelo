diff --git a/src/android/app/src/main/java/io/github/microworldwide/tangelo/features/settings/model/BooleanSetting.kt b/src/android/app/src/main/java/io/github/microworldwide/tangelo/features/settings/model/BooleanSetting.kt
index 36ee3e1..2b4cc6c 100644
