+                       sub_dir);
+}
+
+bool IsHexTitleId(const std::string& id) {
+    return id.size() == 8 &&
+           std::all_of(id.begin(), id.end(), [](unsigned char c) { return std::isxdigit(c); });
+}
+
+bool IsMessageFileName(const std::string& name) {
+    return name.size() == 12 && name[0] == '_';
+}
+
+std::size_t CountFiles(const std::string& dir) {
+    FileUtil::FSTEntry root;
+    std::vector<FileUtil::FSTEntry> files;
+    FileUtil::ScanDirectoryTree(dir, root, 2048);
+    FileUtil::GetAllFilesFromNestedEntries(root, files);
+    return files.size();
+}
+
+/// Reads and validates the header of an inbox's BoxInfo_____ file.
+bool ReadBoxInfo(FileUtil::IOFile& file, BoxInfoHeader& info) {
+    if (!file.IsOpen() || file.GetSize() < sizeof(BoxInfoHeader)) {
+        return false;
+    }
+    if (!file.Seek(0, SEEK_SET) || file.ReadBytes(&info, sizeof(info)) != sizeof(info)) {
+        return false;
+    }
+    return info.magic == BoxInfoMagic;
+}
+
+/// Whether one more message of `size` bytes fits in the inbox (count and total size).
+bool FitsInBox(const BoxInfoHeader& info, u64 size) {
+    if (info.message_num >= info.max_message_num) {
+        return false;
+    }
+    // A max_box_size of 0 would mean "no size limit"; real boxes always set it.
+    return info.max_box_size == 0 || u64{info.box_size} + size <= info.max_box_size;
+}
+
+/// Registers a message in BoxInfo_____: appends its 0x70-byte header entry, then updates the
+/// counters. The entry is written first so the counters never reference a missing entry.
+bool AppendToBox(FileUtil::IOFile& file, BoxInfoHeader& info, const u8* message_header,
+                 u64 message_size) {
+    BoxInfoHeader updated = info;
+    updated.message_num = updated.message_num + 1;
+    updated.box_info_size = updated.box_info_size + sizeof(MessageHeader);
+    updated.box_size = updated.box_size + static_cast<u32>(message_size);
+
+    if (!file.Seek(0, SEEK_END) ||
+        file.WriteBytes(message_header, sizeof(MessageHeader)) != sizeof(MessageHeader)) {
+        return false;
+    }
+    if (!file.Seek(0, SEEK_SET) || file.WriteBytes(&updated, sizeof(updated)) != sizeof(updated)) {
+        return false;
+    }
+    file.Flush();
+    info = updated;
+    return true;
+}
+
+bool AddFileToZip(zip_t* za, const std::string& zip_path, const std::string& src_path) {
+    zip_source_t* src = zip_source_file_create(src_path.c_str(), 0, ZIP_LENGTH_TO_END, nullptr);
+    if (src == nullptr) {
+        return false;
+    }
+    if (zip_file_add(za, zip_path.c_str(), src, 0) < 0) {
+        zip_source_free(src);
+        return false;
+    }
+    return true;
+}
+
+int ZipPassChecks() {
+    int n_homes = 0;
+    for (u32 region = 0; region < Core::NUM_SYSTEM_TITLE_REGIONS; region++) {
+        if (region == 3) {
+            continue;
+        }
+        const auto home_path = Core::GetHomeMenuNcchPath(region);
+        if (!home_path.empty() && FileUtil::Exists(home_path)) {
+            n_homes++;
+        }
+    }
+
+    if (n_homes < 1) {
+        LOG_ERROR(Frontend, "ZipPass import impossible without system files");
+        return -2;
+    }
+
+    if (!Settings::values.enable_required_online_lle_modules.GetValue()) {
+        LOG_ERROR(Frontend, "ZipPass import impossible without LLE modules");
+        return -3;
+    }
+
+    if (isEmulationRunning()) {
+        LOG_ERROR(Frontend, "ZipPass import refused while emulation is running");
+        return -4;
+    }
+
+    return 0;
 }
 
