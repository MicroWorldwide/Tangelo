+// Return codes shared by the import functions:
+//   >= 0  number of messages imported (0 = nothing usable in the file)
+//     -1  the file could not be read, or writing into the NAND failed
+//     -2  no system files installed
+//     -3  the required online LLE modules are disabled
+//     -4  emulation is running (StreetPass boxes are in use)
+//    -10  the ZipPass folders could not be created
+
+/// Exports every game's StreetPass outbox to a .pass.zip file.
+/// Returns the number of messages exported, or -1 on failure.
 int exportZipPass(std::string path);
 
+/// Imports one .pass.zip file into the games' StreetPass inboxes.
 int importZipPass(std::string path);
 
+/// Moves parked messages into inboxes that have room again, then imports queued .pass.zip files.
 int importQueuedZipPass();
 
+/// Keeps only the most recent ZipPass history files.
 void trimZipPassHistory();
 
+/// Deletes every game's StreetPass box (games recreate them when StreetPass is re-enabled).
 int clearStreetPassConfig();
 
+/// Whether a game is currently running, so ZipPass must not touch the StreetPass boxes.
+bool isEmulationRunning();
+
 } // namespace Core
