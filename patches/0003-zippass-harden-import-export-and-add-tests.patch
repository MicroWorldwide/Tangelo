+           "00000000000000000000000000000000" + DIR_SEP + "sysdata" + DIR_SEP + "00010026" +
+           DIR_SEP + "00000000" + DIR_SEP + "CEC";
+}
+
+std::string GetInboxPath(const std::string& title_id) {
