+using BoxInfoHeader = Service::CECD::Module::CecBoxInfoHeader;
+using MessageHeader = Service::CECD::Module::CecMessageHeader;
+
+constexpr u32 TitleId = 0x0018af00;
+constexpr const char* TitleDir = "0018af00";
+constexpr u32 BodySize = 0x30;
+constexpr u32 MessageSize = sizeof(MessageHeader) + BodySize;
+
+/// A throwaway user folder laid out like the emulator's: nand/, zippass/, and a fake home menu
+/// so ZipPass's "system files installed" check passes.
+struct ZipPassFixture {
+    std::string root;
+
+    ZipPassFixture() {
+        root = (std::filesystem::temp_directory_path() /
+                ("tangelo_zippass_test_" + std::to_string(std::rand())))
+                   .string() +
+               "/";
+        FileUtil::CreateFullPath(root + "nand/");
+        FileUtil::SetUserPath(root);
+        FileUtil::UpdateUserPath(FileUtil::UserPath::UserDir, root);
+        FileUtil::UpdateUserPath(FileUtil::UserPath::NANDDir, root + "nand/");
+
+        const std::string home = Core::GetHomeMenuNcchPath(0);
+        FileUtil::CreateFullPath(home);
+        FileUtil::WriteStringToFile(false, home, "not a real home menu");
+
+        Settings::values.enable_required_online_lle_modules.SetValue(true);
+    }
+
+    ~ZipPassFixture() {
+        FileUtil::DeleteDirRecursively(root);
+    }
+
+    std::string Cec() const {
+        return root + "nand/data/00000000000000000000000000000000/sysdata/00010026/00000000/CEC/";
+    }
+    std::string Inbox() const {
+        return Cec() + TitleDir + "/InBox___/";
+    }
+    std::string Outbox() const {
+        return Cec() + TitleDir + "/OutBox__/";
+    }
+    std::string ZipPass(const std::string& sub) const {
+        return root + "zippass/" + sub;
+    }
+
+    void WriteBoxInfo(u32 message_num, u32 max_message_num) const {
+        BoxInfoHeader info{};
+        info.magic = 0x6262;
+        info.box_info_size = sizeof(BoxInfoHeader) + message_num * sizeof(MessageHeader);
+        info.max_box_size = 0x10000;
+        info.box_size = message_num * MessageSize;
+        info.max_message_num = max_message_num;
+        info.message_num = message_num;
+        info.max_batch_size = 1;
+        info.max_message_size = 0x1000;
+
+        std::vector<u8> data(info.box_info_size);
+        std::memcpy(data.data(), &info, sizeof(info));
+        FileUtil::CreateFullPath(Inbox());
+        FileUtil::IOFile file(Inbox() + "BoxInfo_____", "wb");
+        file.WriteBytes(data.data(), data.size());
+    }
+
+    BoxInfoHeader ReadBoxInfo() const {
+        BoxInfoHeader info{};
+        FileUtil::IOFile file(Inbox() + "BoxInfo_____", "rb");
+        file.ReadBytes(&info, sizeof(info));
+        return info;
+    }
+
+    /// Puts one valid StreetPass message in the outbox and returns its file name.
+    std::string WriteOutboxMessage() const {
+        MessageHeader header{};
+        header.magic = 0x6060;
+        header.message_size = MessageSize;
+        header.header_size = sizeof(MessageHeader);
+        header.body_size = BodySize;
+        header.title_id = TitleId;
+        header.message_id = {1, 2, 3, 4, 5, 6, 7, 8};
+
+        std::vector<u8> data(MessageSize, 0xAB);
+        std::memcpy(data.data(), &header, sizeof(header));
+
+        const std::string name = "_" + Service::CECD::Module::EncodeBase64(header.message_id);
+        FileUtil::CreateFullPath(Outbox());
+        FileUtil::IOFile file(Outbox() + name, "wb");
+        file.WriteBytes(data.data(), data.size());
+        return name;
+    }
+
+    /// Message files in a folder (everything except BoxInfo_____).
+    std::vector<std::string> Messages(const std::string& dir) const {
+        std::vector<std::string> names;
+        if (!std::filesystem::exists(dir)) {
+            return names;
+        }
+        for (const auto& entry : std::filesystem::directory_iterator(dir)) {
+            const std::string name = entry.path().filename().string();
+            if (name != "BoxInfo_____") {
+                names.push_back(name);
+            }
+        }
+        return names;
+    }
+};
+
+} // namespace
+
+TEST_CASE("ZipPass export and import round trip", "[core][zippass]") {
+    ZipPassFixture fx;
+    const std::string original_name = fx.WriteOutboxMessage();
+    fx.WriteBoxInfo(0, 2);
+
+    const std::string zip = fx.root + "test.pass.zip";
+    REQUIRE(Core::exportZipPass(zip) == 1);
+    REQUIRE(FileUtil::Exists(zip));
+
+    // First import lands in the real inbox and is registered in BoxInfo.
+    REQUIRE(Core::importZipPass(zip) == 1);
+    auto inbox = fx.Messages(fx.Inbox());
+    REQUIRE(inbox.size() == 1);
+    CHECK(inbox[0] != original_name); // a fresh message ID is assigned
+    CHECK(FileUtil::GetSize(fx.Inbox() + inbox[0]) == MessageSize);
+
+    BoxInfoHeader info = fx.ReadBoxInfo();
+    CHECK(info.message_num == 1);
+    CHECK(info.box_size == MessageSize);
+    CHECK(info.box_info_size == sizeof(BoxInfoHeader) + sizeof(MessageHeader));
+    CHECK(FileUtil::GetSize(fx.Inbox() + "BoxInfo_____") == info.box_info_size);
+
+    // The imported message keeps a valid header.
+    MessageHeader header{};
+    {
+        FileUtil::IOFile file(fx.Inbox() + inbox[0], "rb");
+        file.ReadBytes(&header, sizeof(header));
+    }
+    CHECK(header.magic == 0x6060);
+    CHECK(header.title_id == TitleId);
+    CHECK("_" + Service::CECD::Module::EncodeBase64(header.message_id) == inbox[0]);
+
+    // Second import fills the inbox (max 2 messages).
+    REQUIRE(Core::importZipPass(zip) == 1);
+    CHECK(fx.ReadBoxInfo().message_num == 2);
+
+    // Third import: inbox full, so the message is parked in the external inbox.
+    REQUIRE(Core::importZipPass(zip) == 1);
+    CHECK(fx.ReadBoxInfo().message_num == 2);
+    CHECK(fx.Messages(fx.Inbox()).size() == 2);
+    CHECK(fx.Messages(fx.ZipPass("inboxes/") + TitleDir).size() == 1);
+
+    // The game "reads" a message: room again, so the queue pass moves the parked one in.
+    fx.WriteBoxInfo(1, 2);
+    std::filesystem::remove(fx.Inbox() + fx.Messages(fx.Inbox())[0]);
+    REQUIRE(Core::importQueuedZipPass() == 0);
+    CHECK(fx.Messages(fx.ZipPass("inboxes/") + TitleDir).empty());
+    CHECK(fx.ReadBoxInfo().message_num == 2);
+    CHECK(fx.Messages(fx.Inbox()).size() == 2);
+}
+
+TEST_CASE("ZipPass import rejects bad input without crashing", "[core][zippass]") {
+    ZipPassFixture fx;
+    fx.WriteBoxInfo(0, 2);
+
+    SECTION("file that is not a zip") {
+        const std::string bad = fx.root + "broken.pass.zip";
+        FileUtil::WriteStringToFile(false, bad, "this is not a zip file");
+        CHECK(Core::importZipPass(bad) == -1);
+    }
+
+    SECTION("missing file") {
+        CHECK(Core::importZipPass(fx.root + "does_not_exist.pass.zip") == -1);
+    }
+
+    SECTION("inbox with a corrupt BoxInfo is left untouched") {
+        fx.WriteOutboxMessage();
+        const std::string zip = fx.root + "test.pass.zip";
+        REQUIRE(Core::exportZipPass(zip) == 1);
+
+        FileUtil::WriteStringToFile(false, fx.Inbox() + "BoxInfo_____", "garbage");
+        CHECK(Core::importZipPass(zip) == 0);
+        CHECK(fx.Messages(fx.Inbox()).empty());
+    }
+
+    CHECK(fx.ReadBoxInfo().message_num == 0);
+}
+
+TEST_CASE("ZipPass queue is not blocked by a broken file", "[core][zippass]") {
+    ZipPassFixture fx;
+    FileUtil::CreateFullPath(fx.ZipPass("queue/"));
+    FileUtil::WriteStringToFile(false, fx.ZipPass("queue/broken.pass.zip"), "not a zip");
+
+    REQUIRE(Core::importQueuedZipPass() == 0);
+    CHECK(fx.Messages(fx.ZipPass("queue/")).empty());
+    CHECK(FileUtil::Exists(fx.ZipPass("history/broken.pass.zip")));
+}
+
+TEST_CASE("ZipPass environment checks", "[core][zippass]") {
+    ZipPassFixture fx;
+    const std::string zip = fx.root + "any.pass.zip";
+
+    SECTION("LLE modules disabled") {
+        Settings::values.enable_required_online_lle_modules.SetValue(false);
+        CHECK(Core::importZipPass(zip) == -3);
+        Settings::values.enable_required_online_lle_modules.SetValue(true);
+    }
+
+    SECTION("no system files") {
+        FileUtil::Delete(Core::GetHomeMenuNcchPath(0));
+        CHECK(Core::importZipPass(zip) == -2);
+    }
+}
