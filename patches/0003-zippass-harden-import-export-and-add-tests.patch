+namespace {
+
+using BoxInfoHeader = Service::CECD::Module::CecBoxInfoHeader;
+using MessageHeader = Service::CECD::Module::CecMessageHeader;
+
+constexpr u16 BoxInfoMagic = 0x6262;          // 'bb'
+constexpr u16 MessageMagic = 0x6060;          // '``'
+constexpr u64 MaxMessageFileSize = 0x100000;  // sanity cap before allocating (1 MiB)
+constexpr std::size_t MaxExternalInboxFiles = 100;
+constexpr std::size_t MaxHistoryFiles = 100;
+
+/// Serializes every ZipPass operation. Imports can be started from the UI thread, at startup
+/// and from the network thread (room downloads), and all of them rewrite BoxInfo_____ files.
+/// Recursive because importQueuedZipPass calls importZipPass.
+std::recursive_mutex zip_pass_mutex;
+
+std::string GetCecPath() {
