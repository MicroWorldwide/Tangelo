@@ -267,9 +270,34 @@ void Module::Interface::CheckNew3DS(Kernel::HLERequestContext& ctx) {
     Service::PTM::CheckNew3DS(rb);
 }
 
+namespace {
+// Who set the notification LED and to what (blue = SpotPass news, green = StreetPass,
+// orange = a friend online, all zero = off), for tests of the emulated LED.
+std::string LedCaller(Kernel::HLERequestContext& ctx) {
+    auto thread = ctx.ClientThread();
+    auto process = thread ? thread->owner_process.lock() : nullptr;
+    return process && process->codeset ? process->codeset->name : std::string("?");
+}
+
+std::string DescribeLed(const MCU::InfoLedPattern& p) {
+    u32 r = 0, g = 0, b = 0;
+    for (std::size_t i = 0; i < MCU::InfoLedPattern::PATTERN_INDEX_COUNT; i++) {
+        r = std::max<u32>(r, p.r[i]);
+        g = std::max<u32>(g, p.g[i]);
+        b = std::max<u32>(b, p.b[i]);
+    }
+    if (r == 0 && g == 0 && b == 0) {
+        return "off";
+    }
+    return fmt::format("max RGB {:02X}{:02X}{:02X}, {} tick(s) per step, last step repeated {}", r,
+                       g, b, p.header.ticks_per_index, p.header.last_index_repeat_times);
+}
+} // namespace
+
 void Module::Interface::SetInfoLEDPattern(Kernel::HLERequestContext& ctx) {
     IPC::RequestParser rp(ctx);
     auto pat = rp.PopRaw<MCU::InfoLedPattern>();
+    LOG_INFO(Service_PTM, "Notification LED set by {}: {}", LedCaller(ctx), DescribeLed(pat));
 
     IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
 
@@ -285,6 +313,8 @@ void Module::Interface::SetInfoLEDPattern(Kernel::HLERequestContext& ctx) {
 void Module::Interface::SetInfoLEDPatternHeader(Kernel::HLERequestContext& ctx) {
     IPC::RequestParser rp(ctx);
     auto head = rp.PopRaw<MCU::InfoLedPattern::Header>();
+    LOG_INFO(Service_PTM, "Notification LED header set by {}: {} tick(s) per step, repeat {}",
+             LedCaller(ctx), head.ticks_per_index, head.last_index_repeat_times);
 
     IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
 
