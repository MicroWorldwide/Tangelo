+// Levels as the log filter writes them, from most to least detail.
+constexpr std::array<const char*, 6> Levels{"Trace", "Debug", "Info", "Warning", "Error",
+                                            "Critical"};
+
+int LevelRank(const QString& level) {
+    for (std::size_t i = 0; i < Levels.size(); ++i) {
+        if (level.compare(QString::fromLatin1(Levels[i]), Qt::CaseInsensitive) == 0) {
+            return static_cast<int>(i);
+        }
+    }
+    return -1;
+}
+
