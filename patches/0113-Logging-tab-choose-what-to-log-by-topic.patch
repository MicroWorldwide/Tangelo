+/// Topics and base level → filter text. Entries the user added by hand that belong to no
+/// topic are kept after the base level.
+void ConfigureLogging::FilterFromTopics() {
+    if (updating) {
+        return;
+    }
+    QStringList owned;
+    for (const auto& topic : topics) {
+        owned += topic.classes;
+    }
+    QStringList extras;
+    for (const auto& entry : filter_edit->text().split(QLatin1Char(' '), Qt::SkipEmptyParts)) {
+        const QString name = entry.section(QLatin1Char(':'), 0, 0);
+        if (name != QStringLiteral("*") && !owned.contains(name)) {
+            extras << entry;
+        }
+    }
+    QStringList parts{QStringLiteral("*:") + level_combo->currentData().toString()};
+    parts += extras;
+    for (const auto& topic : topics) {
+        if (topic.box->isChecked()) {
+            for (const auto& name : topic.classes) {
+                parts << name + QStringLiteral(":Debug");
+            }
+        }
+    }
+    updating = true;
+    filter_edit->setText(parts.join(QLatin1Char(' ')));
+    updating = false;
+}
+
+/// Filter text → base level and topics: a topic is ticked when one of its classes logs at Debug
+/// (or Trace), e.g. an older hand-written filter; ticked, it logs all of them.
+void ConfigureLogging::TopicsFromFilter() {
+    if (updating) {
+        return;
+    }
+    QString base = QStringLiteral("Info");
+    std::map<QString, QString> levels;
+    for (const auto& entry : filter_edit->text().split(QLatin1Char(' '), Qt::SkipEmptyParts)) {
+        const QString name = entry.section(QLatin1Char(':'), 0, 0);
+        const QString level = entry.section(QLatin1Char(':'), 1, 1);
+        if (name == QStringLiteral("*")) {
+            base = level;
+        } else {
+            levels[name] = level;
+        }
+    }
+    updating = true;
+    const int base_index = level_combo->findData(base, Qt::UserRole, Qt::MatchFixedString);
+    level_combo->setCurrentIndex(base_index >= 0 ? base_index : 0);
+    for (auto& topic : topics) {
+        bool any = false;
+        for (const auto& name : topic.classes) {
+            const auto it = levels.find(name);
+            any = any || (it != levels.end() && LevelRank(it->second) >= 0 &&
+                          LevelRank(it->second) <= LevelRank(QStringLiteral("Debug")));
+        }
+        topic.box->setChecked(any);
+    }
+    updating = false;
+}
+
+void ConfigureLogging::SetConfiguration() {
+    updating = true;
+    filter_edit->setText(QString::fromStdString(Settings::values.log_filter.GetValue()));
+    regex_edit->setText(QString::fromStdString(Settings::values.log_regex_filter.GetValue()));
+    console_box->setChecked(UISettings::values.show_console.GetValue());
+    flush_box->setChecked(Settings::values.instant_debug_log.GetValue());
+    updating = false;
+    TopicsFromFilter();
+}
+
+void ConfigureLogging::ApplyConfiguration() {
+    Settings::values.log_filter = filter_edit->text().toStdString();
+    Settings::values.log_regex_filter = regex_edit->text().toStdString();
+    UISettings::values.show_console = console_box->isChecked();
+    Settings::values.instant_debug_log = flush_box->isChecked();
+    Debugger::ToggleConsole();
+    Common::Log::Filter filter;
+    filter.ParseFilterString(Settings::values.log_filter.GetValue());
+    Common::Log::SetGlobalFilter(filter);
+    Common::Log::SetRegexFilter(Settings::values.log_regex_filter.GetValue());
+}
+
+void ConfigureLogging::RetranslateUI() {
+    // Built in code with tr(); texts follow the language at the next opening of the dialog.
+}
