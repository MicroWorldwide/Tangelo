+void Module::Interface::AttachToEventNotification(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    // No friend server means no friend notifications, so the event is kept but never signalled.
+    [[maybe_unused]] const auto event = rp.PopObject<Kernel::Event>();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push(ResultSuccess);
+
+    LOG_DEBUG(Service_FRD, "(STUBBED) called");
+}
