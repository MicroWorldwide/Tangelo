diff --git a/src/core/hle/service/ac/ac.cpp b/src/core/hle/service/ac/ac.cpp
index 3b630a4..b11e651 100644
--- a/src/core/hle/service/ac/ac.cpp
+++ b/src/core/hle/service/ac/ac.cpp
@@ -29,6 +29,15 @@ SERIALIZE_EXPORT_IMPL(Service::AC::Module)
 SERVICE_CONSTRUCT_IMPL(Service::AC::Module)
 
 namespace Service::AC {
+namespace {
+/// SSID the 3DS treats as a Nintendo Zone hotspot (an open network with this name).
+constexpr std::string_view NintendoZoneSSID = "NintendoSpotPass1";
+
+bool IsNintendoZoneMode() {
+    return Settings::values.nintendo_zone_mode.GetValue();
+}
+} // namespace
+
 void Module::Interface::CreateDefaultConfig(Kernel::HLERequestContext& ctx) {
     IPC::RequestParser rp(ctx);
 
@@ -206,11 +215,13 @@ void Module::Interface::GetCurrentAPInfo(Kernel::HLERequestContext& ctx) {
 
     // Layout from 3dbrew: 0x0 SSID length, 0x4 SSID (32 bytes), 0x24 BSSID (6 bytes), rest
     // unknown. Tangelo has no real access point, so while "connected" it reports a fixed virtual
-    // one; when not connected the structure is left empty.
+    // one; when not connected the structure is left empty. In Nintendo Zone mode the access point
+    // is named like a Nintendo Zone hotspot: an open network called "NintendoSpotPass1" is what
+    // the 3DS treats as one.
     constexpr std::size_t APInfoSize = 0x34;
     std::vector<u8> info(std::min<std::size_t>(size, APInfoSize), 0);
     if (ac->ac_connected && info.size() == APInfoSize) {
-        constexpr std::string_view ssid = "Tangelo";
+        const std::string_view ssid = IsNintendoZoneMode() ? NintendoZoneSSID : "Tangelo";
         const u32 ssid_length = static_cast<u32>(ssid.size());
         std::memcpy(info.data(), &ssid_length, sizeof(ssid_length));
         std::memcpy(info.data() + 0x4, ssid.data(), ssid.size());
@@ -223,7 +234,8 @@ void Module::Interface::GetCurrentAPInfo(Kernel::HLERequestContext& ctx) {
     rb.Push(ResultSuccess);
     rb.PushStaticBuffer(std::move(info), 0);
 
-    LOG_DEBUG(Service_AC, "called, size=0x{:X}, connected={}", size, ac->ac_connected);
+    LOG_DEBUG(Service_AC, "called, size=0x{:X}, connected={}, nintendo_zone={}", size,
+              ac->ac_connected, IsNintendoZoneMode());
 }
 
 void Module::Interface::GetNZoneApNumService(Kernel::HLERequestContext& ctx) {
@@ -232,15 +244,22 @@ void Module::Interface::GetNZoneApNumService(Kernel::HLERequestContext& ctx) {
     rp.PopPID();
 
     // Layout from 3dbrew: 0x0 ApNum (10 bytes), 0xA padding, 0xC service name (UTF-8, 24 bytes).
-    // Nintendo Zone hotspots don't exist for Tangelo, so the structure is always empty.
+    // Empty unless Nintendo Zone mode is on; the values used then are placeholders, since the
+    // real ones came from Nintendo's hotspot list.
     constexpr std::size_t NZoneInfoSize = 0x24;
     std::vector<u8> info(std::min<std::size_t>(size, NZoneInfoSize), 0);
+    if (ac->ac_connected && IsNintendoZoneMode() && info.size() == NZoneInfoSize) {
+        constexpr std::string_view ap_num = "0000000001";
+        constexpr std::string_view service_name = "Nintendo Zone";
+        std::memcpy(info.data(), ap_num.data(), ap_num.size());
+        std::memcpy(info.data() + 0xC, service_name.data(), service_name.size());
+    }
 
     IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
     rb.Push(ResultSuccess);
     rb.PushStaticBuffer(std::move(info), 0);
 
-    LOG_DEBUG(Service_AC, "called, size=0x{:X}", size);
+    LOG_DEBUG(Service_AC, "called, size=0x{:X}, nintendo_zone={}", size, IsNintendoZoneMode());
 }
 
 void Module::Interface::GetConnectingLocation(Kernel::HLERequestContext& ctx) {
@@ -248,15 +267,19 @@ void Module::Interface::GetConnectingLocation(Kernel::HLERequestContext& ctx) {
     rp.PopPID();
 
     // Asked by games that hand out Nintendo Zone gifts (e.g. Animal Crossing: New Leaf at the
-    // post office) right after connecting. The reply layout isn't documented; a u32 is assumed
-    // and its value comes from a hidden setting so values can be tried without rebuilding.
-    const u32 location = Settings::values.ac_connecting_location.GetValue();
+    // post office) right after connecting. The reply layout isn't documented; a u32 is assumed.
+    // A non-zero hidden setting overrides the value so others can be tried without rebuilding;
+    // otherwise Nintendo Zone mode reports 1 (assumed to mean "Nintendo Zone") and normal mode 0.
+    const u32 override_location = Settings::values.ac_connecting_location.GetValue();
+    const u32 location =
+        override_location != 0 ? override_location : (IsNintendoZoneMode() ? 1u : 0u);
 
     IPC::RequestBuilder rb = rp.MakeBuilder(2, 0);
     rb.Push(ResultSuccess);
     rb.Push<u32>(location);
 
-    LOG_INFO(Service_AC, "called, connected={}, reporting location {}", ac->ac_connected, location);
+    LOG_INFO(Service_AC, "called, connected={}, nintendo_zone={}, reporting location {}",
+             ac->ac_connected, IsNintendoZoneMode(), location);
 }
 
 void Module::Interface::IsConnected(Kernel::HLERequestContext& ctx) {
