diff --git a/src/citra_qt/citra_qt.cpp b/src/citra_qt/citra_qt.cpp
index 0d5d299..2409181 100644
--- a/src/citra_qt/citra_qt.cpp
+++ b/src/citra_qt/citra_qt.cpp
@@ -2422,6 +2422,34 @@ void GMainWindow::ConnectMenuEvents() {
     connect_menu(ui->action_Dump_Process_Memory, &GMainWindow::OnDumpProcessMemory);
     connect(ui->action_Start_SpotPass_Now, &QAction::toggled, this,
             [](bool checked) { Kernel::SetStartSpotPassTasksNow(checked); });
+    // Tools > Dump Memory After SpotPass Reads: 3 s after a game has read SpotPass data (the
+    // last read, if it reads several in a row), its memory is dumped like Dump Process Memory,
+    // as <title id>-<date-time>-after-nsdata-<id>.bin, without dialogs.
+    spotpass_dump_timer.setSingleShot(true);
+    spotpass_dump_timer.setInterval(3000);
+    connect(&spotpass_dump_timer, &QTimer::timeout, this, [this] {
+        DumpProcessMemory(true, spotpass_dump_tag);
+    });
+    connect(ui->action_Dump_After_SpotPass_Read, &QAction::toggled, this, [this](bool checked) {
+        if (!checked) {
+            Kernel::SetSpotPassReadCallback({});
+            spotpass_dump_timer.stop();
+            return;
+        }
+        Kernel::SetSpotPassReadCallback([this](u64 program_id, u32 ns_data_id) {
+            LOG_INFO(Frontend,
+                     "SpotPass: {:016X} read NsData {:08X}; dumping its memory in 3 seconds",
+                     program_id, ns_data_id);
+            const std::string tag = fmt::format("-after-nsdata-{:08X}", ns_data_id);
+            QMetaObject::invokeMethod(
+                this,
+                [this, tag] {
+                    spotpass_dump_tag = tag;
+                    spotpass_dump_timer.start(); // restarts on every read
+                },
+                Qt::QueuedConnection);
+        });
+    });
     connect_menu(ui->action_Dump_Video, &GMainWindow::OnDumpVideo);
 
     // Tools debug
@@ -4755,6 +4783,10 @@ void GMainWindow::OnSaveMovie() {
 }
 
 void GMainWindow::OnDumpProcessMemory() {
+    DumpProcessMemory(false, {});
+}
+
+void GMainWindow::DumpProcessMemory(bool automatic, const std::string& tag) {
     // Writes the memory of the running game (every readable region of each application process)
     // to <user>/dump/memory/<title id>-<date-time>.bin, with a .txt list of the regions next to it
     // (address, size, file offset). Some games only build settings such as their NEX game-server ID
@@ -4766,7 +4798,8 @@ void GMainWindow::OnDumpProcessMemory() {
     const auto dir = fmt::format("{}memory", FileUtil::GetUserPath(FileUtil::UserPath::DumpDir));
     FileUtil::CreateFullPath(dir + "/");
     const std::string stamp =
-        QDateTime::currentDateTime().toString(QStringLiteral("yyyyMMdd-HHmmss")).toStdString();
+        QDateTime::currentDateTime().toString(QStringLiteral("yyyyMMdd-HHmmss")).toStdString() +
+        tag;
 
     std::vector<std::string> written;
     u64 total = 0;
@@ -4817,6 +4850,15 @@ void GMainWindow::OnDumpProcessMemory() {
         }
     }
 
+    if (automatic) { // Tools > Dump Memory After SpotPass Reads: no dialogs while playing
+        if (!written.empty()) {
+            statusBar()->showMessage(
+                tr("Dumped game memory after a SpotPass read: %1")
+                    .arg(QString::fromStdString(written.front())),
+                10000);
+        }
+        return;
+    }
     if (written.empty()) {
         QMessageBox::critical(this, QStringLiteral("Tangelo"),
                               tr("No running game found to dump.\nRefer to the log for details."));
