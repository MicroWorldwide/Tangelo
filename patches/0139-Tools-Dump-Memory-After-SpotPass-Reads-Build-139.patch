diff --git a/src/core/hle/kernel/ipc.cpp b/src/core/hle/kernel/ipc.cpp
index 704063f..825c88f 100644
--- a/src/core/hle/kernel/ipc.cpp
+++ b/src/core/hle/kernel/ipc.cpp
@@ -142,8 +142,19 @@ std::map<std::pair<u64, std::string>, std::chrono::steady_clock::time_point> sta
 /// Game threads whose request was turned into StartTaskImmediate, with the command they sent,
 /// so the reply goes back under the command the game expects.
 std::map<u32, u32> rewritten_requests;
+
+std::mutex spotpass_read_mutex;
+SpotPassReadCallback spotpass_read_callback;
+/// Game threads waiting for a ReadNsData reply -> the NsData ID they asked for.
+std::map<u32, u32> pending_ns_data_reads;
 } // namespace
 
+void SetSpotPassReadCallback(SpotPassReadCallback callback) {
+    std::scoped_lock lock{spotpass_read_mutex};
+    spotpass_read_callback = std::move(callback);
+    pending_ns_data_reads.clear();
+}
+
 void SetStartSpotPassTasksNow(bool enabled) {
     start_spotpass_tasks_now = enabled;
     std::scoped_lock lock{start_now_mutex};
@@ -241,6 +252,31 @@ Result TranslateCommandBuffer(Kernel::KernelSystem& kernel, Memory::MemorySystem
         }
     }
 
+    // Tools > Dump Memory After SpotPass Reads: a game's ReadNsData (boss:U 0x00280102: NsData
+    // ID, u64 offset, size, output buffer) and boss's successful answer. Nintendogs + Cats reads
+    // a downloaded neighbour at no fixed moment (37 s, 95 s, 213 s after start in the 30 Oct
+    // tests), and checks and stores it right after; a memory dump taken a few seconds later
+    // shows what it made of it.
+    if (!reply && header.raw == 0x00280102 && dst_process->GetName() == "boss" &&
+        is_app(*src_process)) {
+        std::scoped_lock lock{spotpass_read_mutex};
+        if (spotpass_read_callback) {
+            pending_ns_data_reads[src_thread->GetThreadId()] = cmd_buf[1];
+        }
+    }
+    if (reply && (header.raw >> 16) == 0x0028 && src_process->GetName() == "boss" &&
+        is_app(*dst_process)) {
+        std::scoped_lock lock{spotpass_read_mutex};
+        const auto it = pending_ns_data_reads.find(dst_thread->GetThreadId());
+        if (it != pending_ns_data_reads.end()) {
+            const u32 ns_data_id = it->second;
+            pending_ns_data_reads.erase(it);
+            if (spotpass_read_callback && header.normal_params_size >= 1 && cmd_buf[1] == 0) {
+                spotpass_read_callback(dst_process->codeset->program_id, ns_data_id);
+            }
+        }
+    }
+
     // Background SpotPass and StreetPass while a game runs (test, 2026-10-16). Games ask NDM to
     // pause the background daemons when they start (ndm:u SuspendDaemons, mask bit 0 = StreetPass
     // (cecd), bit 1 = SpotPass (boss), bit 2 = nim); on a console the HOME Menu and sleep mode
diff --git a/src/core/hle/kernel/ipc.h b/src/core/hle/kernel/ipc.h
index 7991dbc..e3a27e8 100644
--- a/src/core/hle/kernel/ipc.h
+++ b/src/core/hle/kernel/ipc.h
@@ -4,6 +4,8 @@
 
 #pragma once
 
+#include <functional>
+
 #include <memory>
 #include <string>
 #include <vector>
@@ -54,6 +56,12 @@ void LogFailedReply(const std::string& server, const std::string& client, u32 he
 /// next scheduled time (Nintendogs + Cats: every 12 hours).
 void SetStartSpotPassTasksNow(bool enabled);
 bool GetStartSpotPassTasksNow();
+
+/// Called (on the emulation thread, with the kernel lock held: just queue work) each time the
+/// SpotPass module answers a game's ReadNsData (boss:U 0x0028) with success: the game's program
+/// ID and the NsData ID it read. Tools > Dump Memory After SpotPass Reads uses it. Empty = off.
+using SpotPassReadCallback = std::function<void(u64 program_id, u32 ns_data_id)>;
+void SetSpotPassReadCallback(SpotPassReadCallback callback);
 } // namespace Kernel
 
 BOOST_CLASS_EXPORT_KEY(Kernel::MappedBufferContext)
