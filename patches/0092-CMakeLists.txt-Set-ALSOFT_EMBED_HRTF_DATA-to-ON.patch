From 262b775893bbdfe64b377bfe51133bcb07593747 Mon Sep 17 00:00:00 2001
From: Tangelo Dev <tangelo-dev@noreply.invalid>
Date: Wed, 14 Oct 2026 22:57:32 +0200
Subject: [PATCH 92/92] CMakeLists.txt: Set ALSOFT_EMBED_HRTF_DATA to ON

openal-soft 1.25.2+ fails to build when
ALSOFT_EMBED_HRTF_DATA is set to OFF. This is
probably an upstream bug, but in the meantime,
setting the option to ON will allow recent versions
of openal to compile correctly.

From AzaharPlus 2126.2-A, commit cf9068844820f819a6eabbeeeb6a70d546e3e85a, by Reg Tiangha.

(cherry picked from commit cf9068844820f819a6eabbeeeb6a70d546e3e85a)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FYz3krf43qKGY6aS2Z5snz
---
 externals/CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/externals/CMakeLists.txt b/externals/CMakeLists.txt
index 9c6d27e98..899b2eba8 100644
--- a/externals/CMakeLists.txt
+++ b/externals/CMakeLists.txt
@@ -409,7 +409,7 @@ if (ENABLE_OPENAL)
         if (BSD STREQUAL "OpenBSD")
             set(ALSOFT_BACKEND_SOLARIS OFF CACHE BOOL "")
         endif()
-        set(ALSOFT_EMBED_HRTF_DATA OFF CACHE BOOL "")
+        set(ALSOFT_EMBED_HRTF_DATA ON CACHE BOOL "")
         set(ALSOFT_EXAMPLES OFF CACHE BOOL "")
         set(ALSOFT_INSTALL OFF CACHE BOOL "")
         set(ALSOFT_INSTALL_CONFIG OFF CACHE BOOL "")
