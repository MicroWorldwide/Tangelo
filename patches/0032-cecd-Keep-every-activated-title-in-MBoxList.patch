-            } else { // ncch_program_id == 0, remove/update activated boxes
-                /// We need to read the /CEC directory to find out which titles, if any,
-                /// are activated. The num_of_titles = (total_read_count) - 1, to adjust for
-                /// the MBoxList____ file that is present in the directory as well.
-                FileSys::Path root_path(
-                    GetCecDataPathTypeAsString(CecDataPathType::RootDir, 0).data());
-
-                auto dir_result = cecd_system_save_data_archive->OpenDirectory(root_path);
-
-                auto root_dir = std::move(dir_result).Unwrap();
-                std::vector<FileSys::Entry> entries(max_num_boxes + 1); // + 1 mboxlist
-                const u32 entry_count = root_dir->Read(max_num_boxes + 1, entries.data());
-                root_dir->Close();
-
-                LOG_DEBUG(Service_CECD, "Number of entries found in /CEC: {}", entry_count);
-
-                std::string mbox_list_name("MBoxList____");
-                std::string file_name;
-                std::u16string u16_filename;
-
-                // Loop through entries but don't add mboxlist____ to itself.
-                for (u32 i = 0; i < entry_count; i++) {
-                    u16_filename = std::u16string(entries[i].filename);
-                    file_name = Common::UTF16ToUTF8(u16_filename);
-
-                    if (mbox_list_name.compare(file_name) != 0) {
-                        LOG_DEBUG(Service_CECD, "Adding title to mboxlist____: {}", file_name);
-                        std::memcpy(&mbox_list_header.box_names[mbox_list_header.num_boxes++],
-                                    file_name.data(), valid_name_size);
-                    }
+        // Titles write the list with only their own box in it (or nothing at all), so rebuild it
+        // from the box folders in /CEC; otherwise the last title to activate StreetPass would
+        // remove every other title from the list.
+        std::vector<std::string> listed;
+        const u32 listed_count = std::min<u32>(mbox_list_header.num_boxes, max_num_boxes);
+        for (u32 i = 0; i < listed_count; i++) {
+            const auto& box = mbox_list_header.box_names[i];
+            const auto end = std::find(box.begin(), box.begin() + valid_name_size, u8{0});
+            listed.emplace_back(box.begin(), end);
+        }
+
+        std::vector<std::string> box_dirs;
+        FileSys::Path root_path(GetCecDataPathTypeAsString(CecDataPathType::RootDir, 0).data());
+        auto dir_result = cecd_system_save_data_archive->OpenDirectory(root_path);
+        if (dir_result.Succeeded()) {
+            auto root_dir = std::move(dir_result).Unwrap();
+            std::vector<FileSys::Entry> entries(64);
+            const u32 entry_count =
+                root_dir->Read(static_cast<u32>(entries.size()), entries.data());
+            root_dir->Close();
+            for (u32 i = 0; i < entry_count; i++) {
+                if (entries[i].is_directory) {
+                    box_dirs.push_back(Common::UTF16ToUTF8(std::u16string(entries[i].filename)));
                 }
             }
         }
+
+        const std::string add_box =
+            ncch_program_id != 0 ? fmt::format("{:08x}", ncch_program_id) : std::string{};
+        const auto boxes = MergeMBoxList(listed, box_dirs, add_box, max_num_boxes);
+
+        mbox_list_header.num_boxes = static_cast<u16>(boxes.size());
+        for (auto& box : mbox_list_header.box_names) {
+            box.fill(0);
+        }
+        for (std::size_t i = 0; i < boxes.size(); i++) {
+            std::memcpy(mbox_list_header.box_names[i].data(), boxes[i].data(), boxes[i].size());
+        }
+        LOG_DEBUG(Service_CECD, "MBoxList____: {} box(es): {}", boxes.size(),
+                  fmt::join(boxes, ", "));
         std::memcpy(file_buffer.data(), &mbox_list_header, sizeof(CecMBoxListHeader));
         break;
     }
@@ -1563,6 +1542,52 @@ Module::Module(Core::System& system) : system(system) {
 
 Module::~Module() = default;
 
+std::vector<std::string> MergeMBoxList(const std::vector<std::string>& listed,
+                                       const std::vector<std::string>& box_dirs,
+                                       std::string_view add_box, std::size_t max_boxes) {
+    const auto normalize = [](std::string_view name) {
+        std::string result(name.substr(0, std::min<std::size_t>(name.size(), 8)));
+        std::transform(result.begin(), result.end(), result.begin(),
+                       [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+        return result;
+    };
+    const auto is_box_name = [](const std::string& name) {
+        return name.size() == 8 && std::all_of(name.begin(), name.end(), [](unsigned char c) {
+                   return std::isxdigit(c) != 0;
+               });
+    };
+
+    std::vector<std::string> dirs;
+    for (const auto& dir : box_dirs) {
+        const std::string name = normalize(dir);
+        if (dir.size() == 8 && is_box_name(name)) {
+            dirs.push_back(name);
+        }
+    }
+    std::sort(dirs.begin(), dirs.end());
+
+    std::vector<std::string> result;
+    const auto add = [&](const std::string& name) {
+        if (result.size() < max_boxes && is_box_name(name) &&
+            std::find(result.begin(), result.end(), name) == result.end()) {
+            result.push_back(name);
+        }
+    };
+    for (const auto& entry : listed) {
+        const std::string name = normalize(entry);
+        if (std::find(dirs.begin(), dirs.end(), name) != dirs.end()) {
+            add(name);
+        }
+    }
+    for (const auto& name : dirs) {
+        add(name);
+    }
+    if (!add_box.empty()) {
+        add(normalize(add_box));
+    }
+    return result;
+}
+
 void InstallInterfaces(Core::System& system) {
     auto& service_manager = system.ServiceManager();
     auto cecd = std::make_shared<Module>(system);
