 #include "core/hle/service/cecd/cecd.h"
 
 using Service::CECD::Module;
@@ -78,3 +79,27 @@ TEST_CASE("CECD gives new OutBox messages an ID and creation time", "[core][cecd
     CHECK(result.message_id == new_id);
     CHECK(std::memcmp(&result.create_time, &now, sizeof(now)) == 0);
 }
+
+TEST_CASE("MBoxList keeps every activated StreetPass box", "[service][cecd]") {
+    using Service::CECD::MergeMBoxList;
+    // Mario & Sonic writes the list with nothing in it; Mii Plaza and ACNL have box folders.
+    const std::vector<std::string> dirs{"0014a400", "00020800", "00198f00"};
+    CHECK(MergeMBoxList({}, dirs, "0014a400") ==
+          std::vector<std::string>{"00020800", "0014a400", "00198f00"});
+
+    // Existing order is kept, boxes without a folder are dropped, the new box goes last.
+    CHECK(
+        MergeMBoxList({"00198F00", "00020800", "deadbeef"}, {"00020800", "00198f00"}, "0014a400") ==
+        std::vector<std::string>{"00198f00", "00020800", "0014a400"});
+
+    // Rebuild without a title (ncch_program_id 0), no duplicates, non-box folders ignored.
+    CHECK(MergeMBoxList({"00020800", "00020800"}, {"00020800", "TMP", "MBoxList____"}, "") ==
+          std::vector<std::string>{"00020800"});
+
+    // At most 24 boxes.
+    std::vector<std::string> many;
+    for (int i = 0; i < 30; i++) {
+        many.push_back(fmt::format("{:08x}", 0x1000 + i));
+    }
+    CHECK(MergeMBoxList({}, many, "").size() == 24);
+}
