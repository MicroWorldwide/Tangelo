@@ -658,6 +660,17 @@ private:
 /// Initialize CECD service(s)
 void InstallInterfaces(Core::System& system);
 
+/**
+ * The boxes for /CEC/MBoxList____ (the StreetPass titles shown in System Settings).
+ * A title writing the list only knows about its own box, so the list is rebuilt from the box
+ * folders in /CEC: first the `listed` boxes that still have a folder (keeping their order), then
+ * the other folders, then `add_box` (the title activating StreetPass), at most `max_boxes`.
+ * Names are the 8-digit hex box IDs, compared case-insensitively.
+ */
+std::vector<std::string> MergeMBoxList(const std::vector<std::string>& listed,
+                                       const std::vector<std::string>& box_dirs,
+                                       std::string_view add_box, std::size_t max_boxes = 24);
+
 } // namespace Service::CECD
 
 SERVICE_CONSTRUCT(Service::CECD::Module)
