+TEST_CASE("HandleTable::GetUsedCount", "[core][kernel]") {
+    Core::Timing timing(1, 100);
+    Core::System system;
+    Memory::MemorySystem memory{system};
+    Kernel::KernelSystem kernel(memory, timing, [] {}, Kernel::MemoryMode::NewProd, 1);
+    auto process = kernel.CreateProcess(kernel.CreateCodeSet("", 0));
+    auto& table = process->handle_table;
+
+    const std::size_t initial = table.GetUsedCount();
+
+    Handle a{}, b{};
+    REQUIRE(table.Create(std::addressof(a), MakeObject(kernel)).IsSuccess());
+    REQUIRE(table.Create(std::addressof(b), MakeObject(kernel)).IsSuccess());
+    CHECK(table.GetUsedCount() == initial + 2);
+
+    REQUIRE(table.Close(a).IsSuccess());
+    CHECK(table.GetUsedCount() == initial + 1);
+
+    table.Clear();
+    CHECK(table.GetUsedCount() == 0);
+}
