+/// Number of live threads owned by `process`, across all cores.
+static u64 CountProcessThreads(const Process& process) {
+    auto& system = Core::System::GetInstance();
+    u64 count = 0;
+    for (u32 core = 0; core < system.GetNumCores(); ++core) {
+        for (const auto& thread : system.Kernel().GetThreadManager(core).GetThreadList()) {
+            const auto owner = thread->owner_process.lock();
+            if (owner.get() == &process && thread->status != ThreadStatus::Dead) {
+                ++count;
+            }
+        }
+    }
+    return count;
+}
+
 Result SVC::GetProcessInfo(s64* out, Handle process_handle, u32 type) {
     LOG_TRACE(Kernel_SVC, "called process=0x{:08X} type={}", process_handle, type);
 
@@ -1963,14 +1979,30 @@ Result SVC::GetProcessInfo(s64* out, Handle process_handle, u32 type) {
         }
         break;
     case ProcessInfoType::SUPERVISOR_AND_HANDLE_USED_MEMORY:
-    case ProcessInfoType::SUPERVISOR_AND_HANDLE_USED_MEMORY2:
+    case ProcessInfoType::SUPERVISOR_AND_HANDLE_USED_MEMORY2: {
+        // The kernel's own bookkeeping for the process: one 0x1000-byte supervisor stack per
+        // thread plus the page-rounded handle table (8 bytes per entry). Citra doesn't allocate
+        // these, so this is computed from the same inputs the real kernel uses.
+        constexpr u64 SupervisorStackSize = 0x1000;
+        const u64 handle_table_bytes = static_cast<u64>(process->handle_table_size) * 8;
+        *out = static_cast<s64>(CountProcessThreads(*process) * SupervisorStackSize +
+                                Common::AlignUp(handle_table_bytes, Memory::CITRA_PAGE_SIZE));
+        break;
+    }
     case ProcessInfoType::USED_HANDLE_COUNT:
+        *out = static_cast<s64>(process->handle_table.GetUsedCount());
+        break;
     case ProcessInfoType::HIGHEST_HANDLE_COUNT:
+        // The peak isn't tracked; the current count is the closest known lower bound.
+        *out = static_cast<s64>(process->handle_table.GetUsedCount());
+        break;
     case ProcessInfoType::KPROCESS_0X234:
-    case ProcessInfoType::THREAD_COUNT:
     case ProcessInfoType::MAX_THREAD_AMOUNT:
-        // These are valid, but not implemented yet
-        LOG_ERROR(Kernel_SVC, "unimplemented GetProcessInfo type={}", type);
+        // Always 0 on hardware.
+        *out = 0;
+        break;
+    case ProcessInfoType::THREAD_COUNT:
+        *out = static_cast<s64>(CountProcessThreads(*process));
         break;
     case ProcessInfoType::LINEAR_BASE_ADDR_OFFSET:
         *out = Memory::FCRAM_PADDR - process->GetLinearHeapAreaAddress();
