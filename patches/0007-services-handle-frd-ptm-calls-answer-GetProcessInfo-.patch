+void Module::Interface::UpdateGameModeDescription(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    // There is no friend server to show the description on, so it is only accepted.
+    [[maybe_unused]] const auto& description = rp.PopStaticBuffer();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push(ResultSuccess);
+
+    LOG_DEBUG(Service_FRD, "(STUBBED) called");
+}
+
+void Module::Interface::SetNotificationMask(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 mask = rp.Pop<u32>();
+
+    // Friend notifications are never generated offline, so the mask has nothing to filter.
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push(ResultSuccess);
+
+    LOG_DEBUG(Service_FRD, "(STUBBED) called, mask=0x{:08X}", mask);
+}
