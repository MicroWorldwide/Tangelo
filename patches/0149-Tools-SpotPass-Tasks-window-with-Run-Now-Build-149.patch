+namespace {
+
+enum Column {
+    ColumnGame,
+    ColumnTask,
+    ColumnEvery,
+    ColumnLastRun,
+    ColumnResult,
+    ColumnNextRun,
+    ColumnRunsLeft,
+    ColumnAddress,
+    ColumnCount,
+};
+
+constexpr int ProgramIdRole = Qt::UserRole + 1;
+constexpr int TaskIdRole = Qt::UserRole + 2;
+constexpr int RunnableRole = Qt::UserRole + 3;
+constexpr int SortRole = Qt::UserRole + 4;
+
+/// The SpotPass module keeps times as seconds since 1 Jan 2000 in console (local) time.
+QDateTime ConsoleTime(u32 seconds) {
+    return QDateTime(QDate(2000, 1, 1), QTime(0, 0)).addSecs(seconds);
+}
+
+qint64 NowInConsoleSeconds() {
+    return QDateTime(QDate(2000, 1, 1), QTime(0, 0)).secsTo(QDateTime::currentDateTime());
+}
+
+QString Interval(u32 seconds) {
+    if (seconds == 0) {
+        return QStringLiteral("–");
+    }
+    if (seconds % 86400 == 0) {
+        return QObject::tr("%n day(s)", "", static_cast<int>(seconds / 86400));
+    }
+    if (seconds % 3600 == 0) {
+        return QObject::tr("%n hour(s)", "", static_cast<int>(seconds / 3600));
+    }
+    if (seconds % 60 == 0) {
+        return QObject::tr("%n minute(s)", "", static_cast<int>(seconds / 60));
+    }
+    return QObject::tr("%n second(s)", "", static_cast<int>(seconds));
+}
+
+QString ResultText(const Service::BOSS::SpotPassTaskSummary& task) {
+    if (task.last_run == 0) {
+        return QObject::tr("never run");
+    }
+    QString text;
+    switch (task.state) {
+    case 6:
+        text = QObject::tr("done");
+        break;
+    case 7:
+        text = QObject::tr("failed");
+        break;
+    default:
+        text = QObject::tr("state %1").arg(task.state);
+        break;
+    }
+    if (task.http_status != 0 && task.http_status != 0xFFFFFFFF) {
+        text += QStringLiteral(" (HTTP %1)").arg(task.http_status);
+    }
+    return text;
+}
+
+} // namespace
+
+SpotPassTasks::SpotPassTasks(QWidget* parent, GameLookup lookup_)
+    : QDialog(parent), lookup(std::move(lookup_)) {
+    setWindowTitle(tr("SpotPass Tasks"));
+    setWindowFlags(windowFlags() & ~Qt::WindowContextHelpButtonHint);
+    resize(1100, 520);
+
+    auto* intro = new QLabel(
+        tr("Every SpotPass task the console's SpotPass module has registered. A task runs every "
+           "\"Every\" after its last run (on a 3DS mostly in sleep mode or on the HOME Menu). "
+           "Run Now downloads the task's file at once, from your SpotPass server, and puts it "
+           "in the game's SpotPass storage; the game reads it the next time it checks its "
+           "SpotPass data. The list refreshes every 10 seconds."));
+    intro->setWordWrap(true);
+
+    tree = new QTreeWidget;
+    tree->setColumnCount(ColumnCount);
+    tree->setHeaderLabels({tr("Game"), tr("Task"), tr("Every"), tr("Last run"), tr("Result"),
+                           tr("Next run"), tr("Runs left"), tr("Address")});
+    tree->setRootIsDecorated(false);
+    tree->setUniformRowHeights(true);
+    tree->setSortingEnabled(true);
+    tree->setIconSize(QSize(24, 24));
+    tree->header()->setStretchLastSection(true);
+
+    status = new QLabel;
+    status->setWordWrap(true);
+    status->setTextInteractionFlags(Qt::TextSelectableByMouse);
+
+    run_button = new QPushButton(tr("Run Now"));
+    auto* refresh_button = new QPushButton(tr("Refresh"));
+    auto* buttons = new QHBoxLayout;
+    buttons->addWidget(run_button);
+    buttons->addStretch();
+    buttons->addWidget(refresh_button);
+
+    auto* close = new QDialogButtonBox(QDialogButtonBox::Close);
+
+    auto* layout = new QVBoxLayout(this);
+    layout->addWidget(intro);
+    layout->addWidget(tree, 1);
+    layout->addWidget(status);
+    layout->addLayout(buttons);
+    layout->addWidget(close);
+
+    connect(close, &QDialogButtonBox::rejected, this, &QDialog::reject);
+    connect(tree, &QTreeWidget::itemSelectionChanged, this, &SpotPassTasks::UpdateButtons);
+    connect(tree, &QTreeWidget::itemDoubleClicked, this, [this] { RunSelected(); });
+    connect(run_button, &QPushButton::clicked, this, &SpotPassTasks::RunSelected);
+    connect(refresh_button, &QPushButton::clicked, this, &SpotPassTasks::Refresh);
+
+    timer = new QTimer(this);
+    timer->setInterval(10000);
+    connect(timer, &QTimer::timeout, this, &SpotPassTasks::Refresh);
+    timer->start();
+
+    Refresh();
+}
+
+SpotPassTasks::~SpotPassTasks() = default;
+
+void SpotPassTasks::Refresh() {
+    QString selected_program;
+    QString selected_task;
+    if (const auto items = tree->selectedItems(); !items.isEmpty()) {
+        selected_program = items.front()->data(ColumnGame, ProgramIdRole).toString();
+        selected_task = items.front()->data(ColumnGame, TaskIdRole).toString();
+    }
+    tree->setSortingEnabled(false);
+    tree->clear();
+
+    const auto tasks = Service::BOSS::OnlineService::ListAllTasks();
+    const qint64 now = NowInConsoleSeconds();
+    int due = 0;
+    QTreeWidgetItem* reselect = nullptr;
+    for (const auto& task : tasks) {
+        auto* item = new QTreeWidgetItem;
+        const QString program = QString::fromStdString(fmt::format("{:016X}", task.program_id));
+        const QString task_id = QString::fromStdString(task.task_id);
+        const bool upload = Service::HTTP::IsSpotPassUploadUrl(task.url);
+        const bool runnable = !task.url.empty() && !upload;
+        item->setData(ColumnGame, ProgramIdRole, program);
+        item->setData(ColumnGame, TaskIdRole, task_id);
+        item->setData(ColumnGame, RunnableRole, runnable);
+
+        GameInfo game = lookup ? lookup(task.program_id) : GameInfo{};
+        item->setText(ColumnGame, game.name.isEmpty() ? program : game.name);
+        item->setIcon(ColumnGame, game.icon);
+        item->setToolTip(ColumnGame, program);
+        item->setText(ColumnTask, task_id);
+        item->setText(ColumnEvery, Interval(task.interval));
+        item->setText(ColumnLastRun,
+                      task.last_run == 0
+                          ? QStringLiteral("–")
+                          : ConsoleTime(task.last_run).toString(QStringLiteral("yyyy-MM-dd HH:mm")));
+        item->setText(ColumnResult, ResultText(task));
+        if (task.last_run != 0 && task.state == 7) {
+            item->setForeground(ColumnResult, QColor(0xC0, 0x50, 0x00));
+        }
+
+        if (task.interval != 0 && task.last_run != 0) {
+            const qint64 next = static_cast<qint64>(task.last_run) + task.interval;
+            if (next <= now) {
+                item->setText(ColumnNextRun, tr("due now"));
+                item->setForeground(ColumnNextRun, QColor(0x20, 0x80, 0x20));
+                ++due;
+            } else {
+                const qint64 left = next - now;
+                item->setText(ColumnNextRun,
+                              tr("%1 (in %2:%3)")
+                                  .arg(ConsoleTime(static_cast<u32>(next))
+                                           .toString(QStringLiteral("HH:mm")))
+                                  .arg(left / 3600)
+                                  .arg((left / 60) % 60, 2, 10, QLatin1Char('0')));
+            }
+            item->setData(ColumnNextRun, SortRole, next);
+        } else {
+            item->setText(ColumnNextRun, QStringLiteral("–"));
+        }
+        item->setText(ColumnRunsLeft, QString::number(task.runs_left));
+        item->setText(ColumnAddress, upload ? tr("(sends data) %1").arg(QString::fromStdString(
+                                                  task.url))
+                                            : QString::fromStdString(task.url));
+        item->setToolTip(ColumnAddress, QString::fromStdString(task.url));
+        tree->addTopLevelItem(item);
+        if (program == selected_program && task_id == selected_task) {
+            reselect = item;
+        }
+    }
+    tree->setSortingEnabled(true);
+    for (int column = 0; column < ColumnAddress; ++column) {
+        tree->resizeColumnToContents(column);
+    }
+    if (reselect) {
+        reselect->setSelected(true);
+        tree->setCurrentItem(reselect);
+    }
+    if (!running) {
+        status->setText(tasks.empty()
+                            ? tr("No SpotPass tasks yet (the SpotPass module's save is empty or "
+                                 "not there).")
+                            : tr("%n task(s), %1 due now.", "", static_cast<int>(tasks.size()))
+                                  .arg(due));
+    }
+    UpdateButtons();
+}
+
+void SpotPassTasks::UpdateButtons() {
+    const auto items = tree->selectedItems();
+    run_button->setEnabled(!running && !items.isEmpty() &&
+                           items.front()->data(ColumnGame, RunnableRole).toBool());
+}
+
+void SpotPassTasks::RunSelected() {
+    const auto items = tree->selectedItems();
+    if (running || items.isEmpty() || !items.front()->data(ColumnGame, RunnableRole).toBool()) {
+        return;
+    }
+    const u64 program_id = items.front()->data(ColumnGame, ProgramIdRole).toString().toULongLong(
+        nullptr, 16);
+    const QString task = items.front()->data(ColumnGame, TaskIdRole).toString();
+    const QString label = QStringLiteral("%1 / %2").arg(items.front()->text(ColumnGame), task);
+    running = true;
+    status->setText(tr("Running %1 ...").arg(label));
+    UpdateButtons();
+
+    // The download can take a while (DOA's costumes are 21 MB): it runs on its own thread.
+    // The result goes back to the UI thread, which checks the window is still open.
+    QPointer<SpotPassTasks> self(this);
+    std::thread([self, program_id, task_id = task.toStdString(), label] {
+        auto service = std::make_shared<Service::BOSS::OnlineService>(program_id, 0);
+        const QString message = QString::fromStdString(service->RunTaskNow(task_id));
+        QMetaObject::invokeMethod(
+            qApp,
+            [self, label, message] {
+                if (self) {
+                    self->OnRunFinished(label, message);
+                }
+            },
+            Qt::QueuedConnection);
+    }).detach();
+}
+
+void SpotPassTasks::OnRunFinished(const QString& task, const QString& message) {
+    running = false;
+    Refresh();
+    status->setText(QStringLiteral("%1: %2").arg(task, message));
+    UpdateButtons();
+}
