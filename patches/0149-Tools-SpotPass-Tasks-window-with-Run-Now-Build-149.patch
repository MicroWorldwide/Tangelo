+std::vector<SpotPassTaskSummary> OnlineService::ListAllTasks() {
+    std::vector<SpotPassTaskSummary> tasks;
+    auto archive = OpenBossSystemSaveData();
+    if (!archive) {
+        return tasks;
+    }
+    const std::vector<u8> sv = ReadWholeFile(*archive, "/BOSS_SV.db");
+    const std::vector<u8> ss = ReadWholeFile(*archive, "/BOSS_SS.db");
+    if (sv.size() <= BOSS_SAVE_HEADER_SIZE || sv.size() != ss.size() ||
+        (sv.size() - BOSS_SAVE_HEADER_SIZE) % BOSS_S_ENTRY_SIZE != 0) {
+        return tasks;
+    }
+    const auto read32 = [&](std::size_t offset) {
+        u32 value;
+        std::memcpy(&value, sv.data() + offset, sizeof(value));
+        return value;
+    };
+    for (std::size_t entry = BOSS_SAVE_HEADER_SIZE; entry + BOSS_S_ENTRY_SIZE <= sv.size();
+         entry += BOSS_S_ENTRY_SIZE) {
+        SpotPassTaskSummary task;
+        std::memcpy(&task.program_id, sv.data() + entry + 0x10, sizeof(task.program_id));
+        if (task.program_id == 0) {
+            continue;
+        }
+        task.task_id = NormalizeTaskId(
+            std::string_view(reinterpret_cast<const char*>(sv.data() + entry + 0x18), TASK_ID_SIZE));
+        const char* url = reinterpret_cast<const char*>(ss.data() + entry + 0x21C);
+        task.url.assign(url, strnlen(url, URL_SIZE));
+        task.interval = read32(entry + 0x28);
+        task.runs_left = read32(entry + 0x2C);
+        task.last_run = read32(entry + 0x30);
+        task.state = sv[entry + 0x40];
+        task.http_status = read32(entry + 0x48);
+        tasks.push_back(std::move(task));
+    }
+    return tasks;
+}
+
+std::string OnlineService::RunTaskNow(const std::string& task_id) {
+    if (InitializeSession(program_id).IsError()) {
+        return "The SpotPass module's save data couldn't be opened.";
+    }
+    std::string url;
+    {
+        std::scoped_lock lock(mutex);
+        const auto task = task_id_list.find(task_id);
+        if (task == task_id_list.end()) {
+            return fmt::format("Task '{}' isn't registered for {:016X}.", task_id, program_id);
+        }
+        url = PropertyString(task->second.properties[PropertyID::Url]);
+    }
+    if (url.empty()) {
+        return fmt::format("Task '{}' has no address to download.", task_id);
+    }
+    if (HTTP::IsSpotPassUploadUrl(url)) {
+        return fmt::format("Task '{}' sends data ({}); only downloads can run here.", task_id, url);
+    }
+    if (!storage) {
+        return fmt::format("{:016X} hasn't set up its SpotPass storage yet; start the game once.",
+                           program_id);
+    }
+
+    LOG_INFO(Service_BOSS, "SpotPass Tasks: running '{}' of {:016X} now: {}", task_id, program_id,
+             url);
+    const std::atomic<bool> cancel{false};
+    const TaskDownload download = DownloadTaskFile(url, {}, cancel);
+    if (download.status != 200) {
+        return fmt::format("{}: {}", url,
+                           download.status != 0 ? fmt::format("HTTP {}", download.status)
+                                                : download.error);
+    }
+    if (!HW::AES::IsNormalKeyAvailable(HW::AES::BOSSDataKey)) {
+        return "The SpotPass key (slot 0x38) is missing.";
+    }
+    const auto payloads =
+        DecodeBossContainer(download.body, HW::AES::GetNormalKey(HW::AES::BOSSDataKey));
+    if (!payloads) {
+        return fmt::format("{}: {} bytes, but not SpotPass data.", url, download.body.size());
+    }
+    const auto written = StoreNsData(*payloads);
+    if (!written) {
+        return "The game's SpotPass storage couldn't be opened.";
+    }
+    LOG_INFO(Service_BOSS, "SpotPass Tasks: '{}' of {:016X}: {} file(s), {} new or updated",
+             task_id, program_id, payloads->size(), written->size());
+    return fmt::format("Downloaded {} bytes: {} SpotPass file(s), {} new or updated. The game "
+                       "reads them the next time it looks at its SpotPass data.",
+                       download.body.size(), payloads->size(), written->size());
+}
