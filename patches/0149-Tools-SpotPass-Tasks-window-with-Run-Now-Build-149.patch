+void GMainWindow::OnSpotPassTasks() {
+    // Tools > SpotPass Tasks: names and icons from the game list, looked up by title ID.
+    // It stays open next to the game (not modal); a second click brings it to the front.
+    static QPointer<SpotPassTasks> open_window;
+    if (open_window) {
+        open_window->raise();
+        open_window->activateWindow();
+        return;
+    }
+    auto titles = std::make_shared<std::map<u64, GameList::TitleEntry>>(game_list->GetTitles());
+    auto* dialog = new SpotPassTasks(this, [titles](u64 title_id) -> SpotPassTasks::GameInfo {
+        const auto it = titles->find(title_id);
+        if (it == titles->end()) {
+            return {};
+        }
+        return {it->second.name, it->second.icon};
+    });
+    dialog->setAttribute(Qt::WA_DeleteOnClose);
+    open_window = dialog;
+    dialog->show();
+}
