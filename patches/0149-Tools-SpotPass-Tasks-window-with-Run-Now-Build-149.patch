+/// Tools > SpotPass Tasks: every SpotPass task the console's SpotPass module has registered
+/// (from its save, BOSS_SV.db / BOSS_SS.db): the game, how often it runs, when it last ran and
+/// with what result, when it is due next, and a Run Now button that downloads the task's file
+/// at once with Tangelo's own downloader and puts it in the game's SpotPass storage.
+class SpotPassTasks : public QDialog {
+    Q_OBJECT
+
+public:
+    struct GameInfo {
+        QString name;
+        QIcon icon;
+    };
+    /// Looks up a game by title ID in the game list; returns an empty name when it isn't there.
+    using GameLookup = std::function<GameInfo(u64 title_id)>;
+
+    SpotPassTasks(QWidget* parent, GameLookup lookup);
+    ~SpotPassTasks() override;
+
+private:
+    void Refresh();
+    void UpdateButtons();
+    void RunSelected();
+
+public:
+    /// Called on the UI thread when a Run Now download has finished.
+    void OnRunFinished(const QString& task, const QString& message);
+
+private:
+
+    GameLookup lookup;
+    bool running = false;
+
+    QTreeWidget* tree = nullptr;
+    QLabel* status = nullptr;
+    QPushButton* run_button = nullptr;
+    QTimer* timer = nullptr;
+};
