From a253b3644a7ea9d393a3f04e8546037e7f1f9a8e Mon Sep 17 00:00:00 2001
From: Tangelo Dev <tangelo-dev@noreply.invalid>
Date: Fri, 2 Oct 2026 01:39:31 +0200
Subject: [PATCH] am: IsExternalTitleDatabaseInitialized

am:app/am:sys 0x100A reports whether the SD card's title database is
initialized. Tangelo's (virtual) SD card always has one, so it answers
true. Called by a game (000400000018AF00) right before it opens the eShop
applet; before this the call was unimplemented and the game read
leftover buffer data.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FYz3krf43qKGY6aS2Z5snz
---
 src/core/hle/service/am/am.cpp     | 11 +++++++++++
 src/core/hle/service/am/am.h       | 10 ++++++++++
 src/core/hle/service/am/am_app.cpp |  2 +-
 src/core/hle/service/am/am_sys.cpp |  2 +-
 4 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/src/core/hle/service/am/am.cpp b/src/core/hle/service/am/am.cpp
index 0dd6062..b127e1f 100644
--- a/src/core/hle/service/am/am.cpp
+++ b/src/core/hle/service/am/am.cpp
@@ -3254,6 +3254,17 @@ void Module::Interface::QueryAvailableTitleDatabase(Kernel::HLERequestContext& c
     LOG_WARNING(Service_AM, "(STUBBED) media_type={}", media_type);
 }
 
+void Module::Interface::IsExternalTitleDatabaseInitialized(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+
+    // The SD card's title database: Tangelo's (virtual) SD card always has one.
+    IPC::RequestBuilder rb = rp.MakeBuilder(2, 0);
+    rb.Push(ResultSuccess);
+    rb.Push(true);
+
+    LOG_DEBUG(Service_AM, "called");
+}
+
 void Module::Interface::GetPersonalizedTicketInfoList(Kernel::HLERequestContext& ctx) {
     IPC::RequestParser rp(ctx);
 
diff --git a/src/core/hle/service/am/am.h b/src/core/hle/service/am/am.h
index 645311a..ba84239 100644
--- a/src/core/hle/service/am/am.h
+++ b/src/core/hle/service/am/am.h
@@ -755,6 +755,16 @@ public:
          */
         void QueryAvailableTitleDatabase(Kernel::HLERequestContext& ctx);
 
+        /**
+         * AM::IsExternalTitleDatabaseInitialized service function
+         *  Inputs:
+         *      0 : Command header (0x100A0000)
+         *  Outputs:
+         *      1 : Result, 0 on success, otherwise error code
+         *      2 : u8 whether the SD card's title database is initialized (always true)
+         */
+        void IsExternalTitleDatabaseInitialized(Kernel::HLERequestContext& ctx);
+
         /**
          * AM::GetPersonalizedTicketInfoList service function
          *  Inputs:
diff --git a/src/core/hle/service/am/am_app.cpp b/src/core/hle/service/am/am_app.cpp
index 27f3f6e..9054daa 100644
--- a/src/core/hle/service/am/am_app.cpp
+++ b/src/core/hle/service/am/am_app.cpp
@@ -19,7 +19,7 @@ AM_APP::AM_APP(std::shared_ptr<Module> am) : Module::Interface(std::move(am), "a
         {0x1007, &AM_APP::ListDataTitleTicketInfos, "ListDataTitleTicketInfos"},
         {0x1008, nullptr, "GetItemRights"},
         {0x1009, nullptr, "IsDataTitleInUse"},
-        {0x100A, nullptr, "IsExternalTitleDatabaseInitialized"},
+        {0x100A, &AM_APP::IsExternalTitleDatabaseInitialized, "IsExternalTitleDatabaseInitialized"},
         {0x100B, nullptr, "GetNumExistingContentInfos"},
         {0x100C, nullptr, "ListExistingContentInfos"},
         {0x100D, &AM_APP::GetPatchTitleInfos, "GetPatchTitleInfos"},
