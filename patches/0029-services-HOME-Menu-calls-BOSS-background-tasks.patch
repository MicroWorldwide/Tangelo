+void FS_USER::ListSeeds(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 max_count = rp.Pop<u32>();
+    auto& buffer = rp.PopMappedBuffer();
+
+    std::vector<u64> title_ids = FileSys::GetSeedTitleIds();
+    const std::size_t count =
+        std::min<std::size_t>({title_ids.size(), max_count, buffer.GetSize() / sizeof(u64)});
+    buffer.Write(title_ids.data(), 0, count * sizeof(u64));
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(2, 2);
+    rb.Push(ResultSuccess);
+    rb.Push<u32>(static_cast<u32>(count));
+    rb.PushMappedBuffer(buffer);
+    LOG_DEBUG(Service_FS, "max_count={}, count={}", max_count, count);
+}
