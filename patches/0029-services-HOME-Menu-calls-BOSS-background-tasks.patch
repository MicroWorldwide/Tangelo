+void Module::NSInterface::LaunchTitle(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u64 title_id = rp.Pop<u64>();
+    const u32 flags = rp.Pop<u32>();
+
+    constexpr u64 SystemModuleHigh = 0x00040130;
+    auto rb = rp.MakeBuilder(2, 0);
+    if ((title_id >> 32) == SystemModuleHigh) {
+        rb.Push(ResultSuccess);
+        rb.Push<u32>(0);
+        LOG_DEBUG(Service_APT, "system module {:016X} is already running, flags={:#x}", title_id,
+                  flags);
+        return;
+    }
+    rb.Push(Result(ErrorDescription::NotImplemented, ErrorModule::NS, ErrorSummary::NotSupported,
+                   ErrorLevel::Permanent));
+    rb.Push<u32>(0);
+    LOG_WARNING(Service_APT, "launching title {:016X} (flags={:#x}) is not supported", title_id,
+                flags);
+}
