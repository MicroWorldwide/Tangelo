+void GMainWindow::OnGameListDumpCode(QString game_path, u64 program_id) {
+    // Writes the game's decrypted executable (the ExeFS .code section) to
+    // <user>/dump/code/<title id>.code. The loader already decrypts it with the console's own
+    // keys, so nothing secret leaves the machine. Used to read a game's own constants (e.g. the
+    // NEX access key and game-server ID a custom server needs) without extra tools.
+    const auto dir = fmt::format("{}code", FileUtil::GetUserPath(FileUtil::UserPath::DumpDir));
+    FileUtil::CreateFullPath(dir + "/");
+    const auto target = fmt::format("{}/{:016X}.code", dir, program_id);
+
+    std::unique_ptr<Loader::AppLoader> loader = Loader::GetLoader(game_path.toStdString());
+    std::vector<u8> code;
+    if (!loader || loader->ReadCode(code) != Loader::ResultStatus::Success || code.empty()) {
+        QMessageBox::critical(
+            this, QStringLiteral("Tangelo"),
+            tr("Could not read the executable code.\nRefer to the log for details."));
+        return;
+    }
+
+    FileUtil::IOFile file(target, "wb");
+    if (!file.IsOpen() || file.WriteBytes(code.data(), code.size()) != code.size()) {
+        QMessageBox::critical(this, QStringLiteral("Tangelo"),
+                              tr("Could not write the executable code to %1.")
+                                  .arg(QString::fromStdString(target)));
+        return;
+    }
+    file.Close();
+    LOG_INFO(Frontend, "Dumped {} bytes of executable code to {}", code.size(), target);
+    QDesktopServices::openUrl(QUrl::fromLocalFile(QString::fromStdString(dir)));
+}
