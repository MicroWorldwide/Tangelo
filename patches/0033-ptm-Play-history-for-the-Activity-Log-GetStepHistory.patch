+void Module::Interface::GetStepHistoryAll(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 size1 = rp.Pop<u32>();
+    const u32 size2 = rp.Pop<u32>();
+    auto& buffer1 = rp.PopMappedBuffer();
+    auto& buffer2 = rp.PopMappedBuffer();
+
+    std::vector<u8> zeros(std::max<std::size_t>(buffer1.GetSize(), buffer2.GetSize()), 0);
+    buffer1.Write(zeros.data(), 0, buffer1.GetSize());
+    buffer2.Write(zeros.data(), 0, buffer2.GetSize());
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(2, 4);
+    rb.Push(ResultSuccess);
+    rb.Push<u32>(0);
+    rb.PushMappedBuffer(buffer1);
+    rb.PushMappedBuffer(buffer2);
+    LOG_DEBUG(Service_PTM, "size1={:#x}, size2={:#x} (no step log)", size1, size2);
