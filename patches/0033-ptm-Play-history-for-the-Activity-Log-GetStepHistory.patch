+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <span>
+#include <vector>
+#include "common/common_types.h"
+
+namespace Service::PTM {
+
+/**
+ * The play log PTM keeps in its save data (/PlayHistory.dat) and hands to the Activity Log
+ * (GetPlayHistory). See https://www.3dbrew.org/wiki/PTM_Savegame
+ */
+class PlayHistory {
+public:
+    /// One log entry (0xC bytes): title ID high, title ID low, event bits 0-3 + minutes since
+    /// 2000-01-01 in bits 4-31.
+    struct Entry {
+        u32 title_id_high = 0;
+        u32 title_id_low = 0;
+        u32 info_and_time = 0;
+
+        u64 TitleId() const {
+            return (static_cast<u64>(title_id_high) << 32) | title_id_low;
+        }
+        u8 Event() const {
+            return static_cast<u8>(info_and_time & 0xF);
+        }
+        u32 Minutes() const {
+            return info_and_time >> 4;
+        }
+    };
+    static_assert(sizeof(Entry) == 0xC);
+
+    /// Event bits: bit 0 = closed, bit 1 = applet, bit 2 = resume/suspend.
+    enum EventBits : u8 {
+        Close = 1 << 0,
+        Applet = 1 << 1,
+        ResumeSuspend = 1 << 2,
+    };
+
+    static constexpr u32 MaxEntries = 0x11D28;
+    static constexpr std::size_t FileSize = 8 + MaxEntries * sizeof(Entry); // 0xD5DE8
+
+    /// Reads PlayHistory.dat (a ring buffer: start index, entry count, entries). Returns false
+    /// and leaves the history empty if the data is not a valid play history.
+    bool Load(std::span<const u8> file);
+    /// The file contents, with the oldest entry first (start index 0).
+    std::vector<u8> Save() const;
+
+    /// Adds an entry; the oldest entry is dropped when the log is full.
+    void Add(u64 title_id, u8 event, u64 ms_since_2000);
+
+    static Entry MakeEntry(u64 title_id, u8 event, u64 ms_since_2000);
+    /// Whether a title is logged as an applet (HOME Menu, Activity Log, ...) rather than an
+    /// application: system applets have title ID high 0x00040030.
+    static bool IsApplet(u64 title_id);
+
+    const std::vector<Entry>& Entries() const {
+        return entries;
+    }
+
+private:
+    std::vector<Entry> entries; // oldest first
+};
+
+} // namespace Service::PTM
