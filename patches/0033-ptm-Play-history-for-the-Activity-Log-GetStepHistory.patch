+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <cstring>
+#include "core/hle/service/ptm/ptm_play_history.h"
+
+namespace Service::PTM {
+
+bool PlayHistory::Load(std::span<const u8> file) {
+    entries.clear();
+    if (file.size() < 8) {
+        return false;
+    }
+    u32 start = 0;
+    u32 count = 0;
+    std::memcpy(&start, file.data(), sizeof(u32));
+    std::memcpy(&count, file.data() + 4, sizeof(u32));
+    const std::size_t capacity = (file.size() - 8) / sizeof(Entry);
+    if (capacity == 0 || start >= capacity || count > capacity) {
+        return count == 0;
+    }
+    entries.resize(count);
+    for (u32 i = 0; i < count; i++) {
+        const std::size_t index = (start + i) % capacity;
+        std::memcpy(&entries[i], file.data() + 8 + index * sizeof(Entry), sizeof(Entry));
+    }
+    return true;
+}
+
+std::vector<u8> PlayHistory::Save() const {
+    std::vector<u8> file(FileSize, 0);
+    const u32 start = 0;
+    const u32 count = static_cast<u32>(entries.size());
+    std::memcpy(file.data(), &start, sizeof(u32));
+    std::memcpy(file.data() + 4, &count, sizeof(u32));
+    if (!entries.empty()) {
+        std::memcpy(file.data() + 8, entries.data(), entries.size() * sizeof(Entry));
+    }
+    return file;
+}
+
+PlayHistory::Entry PlayHistory::MakeEntry(u64 title_id, u8 event, u64 ms_since_2000) {
+    const u64 minutes = ms_since_2000 / 60000;
+    return Entry{
+        .title_id_high = static_cast<u32>(title_id >> 32),
+        .title_id_low = static_cast<u32>(title_id),
+        .info_and_time = (static_cast<u32>(minutes & 0x0FFFFFFF) << 4) | (event & 0xF),
+    };
+}
+
+void PlayHistory::Add(u64 title_id, u8 event, u64 ms_since_2000) {
+    if (entries.size() >= MaxEntries) {
+        entries.erase(entries.begin(), entries.begin() + (entries.size() - MaxEntries + 1));
+    }
+    entries.push_back(MakeEntry(title_id, event, ms_since_2000));
+}
+
+bool PlayHistory::IsApplet(u64 title_id) {
+    return (title_id >> 32) == 0x00040030;
+}
+
+} // namespace Service::PTM
