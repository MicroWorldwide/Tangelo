+
+    LoadPlayHistory();
+    if (system.GetAppLoader().ReadProgramId(running_title_id) != Loader::ResultStatus::Success) {
+        running_title_id = 0;
+    }
+    if (running_title_id != 0) {
+        launch_ms_since_2000 = system.Kernel().GetSharedPageHandler().GetSystemTimeSince2000();
+        launch_host_time = std::chrono::steady_clock::now();
+        const u8 event = PlayHistory::IsApplet(running_title_id) ? PlayHistory::Applet : 0;
+        play_history.Add(running_title_id, event, launch_ms_since_2000);
+        SavePlayHistory();
+        LOG_INFO(Service_PTM, "Play history: {:016X} launched", running_title_id);
+    }
+}
+
+Module::~Module() {
+    if (running_title_id == 0) {
+        return;
+    }
+    // The kernel may already be gone here; the close time is the launch time plus the time
+    // that has passed since.
+    const auto played = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - launch_host_time);
+    const u8 event =
+        PlayHistory::Close | (PlayHistory::IsApplet(running_title_id) ? PlayHistory::Applet : 0);
+    play_history.Add(running_title_id, event,
+                     launch_ms_since_2000 + static_cast<u64>(played.count()));
+    SavePlayHistory();
+    LOG_INFO(Service_PTM, "Play history: {:016X} closed after {} min", running_title_id,
+             played.count() / 60000);
+}
+
+namespace {
+constexpr std::array<u8, 8> ptm_system_savedata_id{0x00, 0x00, 0x00, 0x00, 0x22, 0x00, 0x01, 0x00};
+constexpr char play_history_path[] = "/PlayHistory.dat";
+
+std::unique_ptr<FileSys::ArchiveBackend> OpenPtmSaveData() {
+    const std::string& nand_directory = FileUtil::GetUserPath(FileUtil::UserPath::NANDDir);
+    FileSys::ArchiveFactory_SystemSaveData factory(nand_directory);
+    const FileSys::Path archive_path(
+        std::vector<u8>(ptm_system_savedata_id.begin(), ptm_system_savedata_id.end()));
+    if (factory.Open(archive_path, 0).Code() == FileSys::ResultNotFound) {
+        factory.Format(archive_path, FileSys::ArchiveFormatInfo(), 0, 0, 0);
+    }
+    auto archive_result = factory.Open(archive_path, 0);
+    if (archive_result.Failed()) {
+        LOG_ERROR(Service_PTM, "Could not open the PTM system save data");
+        return nullptr;
+    }
+    return std::move(archive_result).Unwrap();
+}
+} // namespace
+
+void Module::LoadPlayHistory() {
+    auto archive = OpenPtmSaveData();
+    if (!archive) {
+        return;
+    }
+    FileSys::Mode mode{};
+    mode.read_flag.Assign(1);
+    auto file_result = archive->OpenFile(FileSys::Path(play_history_path), mode);
+    if (file_result.Failed()) {
+        return; // No history yet.
+    }
+    auto file = std::move(file_result).Unwrap();
+    std::vector<u8> data(file->GetSize());
+    file->Read(0, data.size(), data.data());
+    file->Close();
+    if (!play_history.Load(data)) {
+        LOG_WARNING(Service_PTM, "PlayHistory.dat is not a valid play history; starting a new one");
+    }
+}
+
+void Module::SavePlayHistory() const {
+    auto archive = OpenPtmSaveData();
+    if (!archive) {
+        return;
+    }
+    const std::vector<u8> data = play_history.Save();
+    const FileSys::Path path(play_history_path);
+    FileSys::Mode mode{};
+    mode.write_flag.Assign(1);
+    mode.create_flag.Assign(1);
+    auto file_result = archive->OpenFile(path, mode);
+    if (file_result.Failed()) {
+        LOG_ERROR(Service_PTM, "Could not write PlayHistory.dat");
+        return;
+    }
+    auto file = std::move(file_result).Unwrap();
+    file->SetSize(data.size());
+    file->Write(0, data.size(), true, false, data.data());
+    file->Close();
 }
 
