+#include <cstring>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include "core/hle/service/ptm/ptm_play_history.h"
+
+using Service::PTM::PlayHistory;
+
+TEST_CASE("Play history entries use the PTM save data layout", "[service][ptm]") {
+    constexpr u64 MiiPlaza = 0x0004001000022800;
+    // 2026-09-29 18:00 = 13,787,640 minutes after 2000-01-01.
+    constexpr u64 Ms = 13'787'640ULL * 60'000 + 59'999;
+    const auto entry = PlayHistory::MakeEntry(MiiPlaza, PlayHistory::Close, Ms);
+    CHECK(entry.title_id_high == 0x00040010);
+    CHECK(entry.title_id_low == 0x00022800);
+    CHECK(entry.Minutes() == 13'787'640);
+    CHECK(entry.Event() == PlayHistory::Close);
+
+    CHECK(PlayHistory::IsApplet(0x0004003000009802)); // HOME Menu
+    CHECK_FALSE(PlayHistory::IsApplet(MiiPlaza));
+    CHECK_FALSE(PlayHistory::IsApplet(0x0004000000198F00));
+}
+
+TEST_CASE("Play history is saved oldest first and loaded from a ring buffer", "[service][ptm]") {
+    PlayHistory history;
+    history.Add(0x0004003000009802, PlayHistory::Applet, 60'000);
+    history.Add(0x0004001000022800, 0, 120'000);
+    history.Add(0x0004001000022800, PlayHistory::Close, 180'000);
+
+    const auto file = history.Save();
+    REQUIRE(file.size() == PlayHistory::FileSize);
+    CHECK(file.size() == 0xD5DE8);
+    u32 start = 1, count = 0;
+    std::memcpy(&start, file.data(), 4);
+    std::memcpy(&count, file.data() + 4, 4);
+    CHECK(start == 0);
+    CHECK(count == 3);
+
+    PlayHistory loaded;
+    REQUIRE(loaded.Load(file));
+    REQUIRE(loaded.Entries().size() == 3);
+    CHECK(loaded.Entries()[0].TitleId() == 0x0004003000009802);
+    CHECK(loaded.Entries()[2].Event() == PlayHistory::Close);
+
+    // A console's file where the log wrapped: start index 2 of a 4-entry buffer.
+    std::vector<u8> ring(8 + 4 * sizeof(PlayHistory::Entry), 0);
+    const u32 ring_start = 2, ring_count = 3;
+    std::memcpy(ring.data(), &ring_start, 4);
+    std::memcpy(ring.data() + 4, &ring_count, 4);
+    for (u32 slot = 0; slot < 4; slot++) {
+        const auto e = PlayHistory::MakeEntry(0x1000 + slot, 0, slot * 60'000ULL);
+        std::memcpy(ring.data() + 8 + slot * sizeof(e), &e, sizeof(e));
+    }
+    REQUIRE(loaded.Load(ring));
+    REQUIRE(loaded.Entries().size() == 3);
+    CHECK(loaded.Entries()[0].TitleId() == 0x1002);
+    CHECK(loaded.Entries()[1].TitleId() == 0x1003);
+    CHECK(loaded.Entries()[2].TitleId() == 0x1000);
+
+    CHECK_FALSE(loaded.Load(std::vector<u8>{1, 2, 3}));
+    CHECK(loaded.Entries().empty());
+}
