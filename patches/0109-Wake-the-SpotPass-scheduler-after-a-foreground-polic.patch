From 647043009e4f9273d1f6a4e218979b9cdb362e91 Mon Sep 17 00:00:00 2001
From: Tangelo Dev <tangelo-dev@noreply.invalid>
Date: Fri, 16 Oct 2026 19:36:19 +0200
Subject: [PATCH] Wake the SpotPass scheduler after a foreground policy list refresh

Badge Arcade (and other games with a foreground SpotPass task) hung on
"Downloading latest data" when started from the HOME Menu. Once ndm has
resumed boss, a foreground task start makes boss's worker refresh the policy
list first; afterwards the worker only sets its policy-done event and goes
back to waiting on the scheduler's event, so the scheduler never looks at the
queued task again (Build 108 logs, 2026-10-16). When a boss thread set the
policy-done event and then waits on the scheduler's event without having
signalled it, it is now signalled once for it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FYz3krf43qKGY6aS2Z5snz
---
 BUILD-NUMBER                |  2 +-
 src/core/hle/kernel/svc.cpp | 40 +++++++++++++++++++++++++++++++++++++
 2 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/BUILD-NUMBER b/BUILD-NUMBER
index 3b20426c0..e2a9fee00 100644
--- a/BUILD-NUMBER
+++ b/BUILD-NUMBER
@@ -1 +1 @@
-108
+109
diff --git a/src/core/hle/kernel/svc.cpp b/src/core/hle/kernel/svc.cpp
index 7e694c102..398f022ae 100644
--- a/src/core/hle/kernel/svc.cpp
+++ b/src/core/hle/kernel/svc.cpp
@@ -821,6 +821,45 @@ static void LogBossArbiter(Core::System& system, const Thread* thread, const cha
              core.GetPC(), core.GetReg(14));
 }
 
+/// Badge Arcade hang when started from the HOME Menu (2026-10-16, Build 108 logs). Once ndm has
+/// resumed the SpotPass module (boss), a game's foreground task first makes boss's worker thread
+/// refresh the policy list. After that refresh the worker only sets its "policy done" event
+/// (0x00156508) and goes back to waiting on the scheduler's event (0x0014D154); nothing wakes the
+/// scheduler again, so the game's download never starts and the game waits forever. After its
+/// background run the worker does signal 0x0014D154 itself. Here: when a boss thread set the
+/// policy-done event and then waits on the scheduler's event without having signalled it, signal
+/// it once for it, so the scheduler looks at the queued task again.
+/// Addresses are those of the current SpotPass module (11.17, PBOS-8.0); with any other layout
+/// the pattern simply never matches.
+static void WakeBossSchedulerAfterPolicyRefresh(Core::System& system, AddressArbiter& arbiter,
+                                                Thread* thread, u32 address, u32 type) {
+    constexpr u32 PolicyDoneEvent = 0x00156508;
+    constexpr u32 SchedulerEvent = 0x0014D154;
+    static std::mutex mutex;
+    static std::map<u32, bool> pending; // boss thread ID → set policy-done, scheduler not woken
+    if (!thread || system.Kernel().GetCurrentProcess()->GetName() != "boss") {
+        return;
+    }
+    std::scoped_lock lock{mutex};
+    if (type == 0 && address == PolicyDoneEvent) {
+        pending[thread->thread_id] = true;
+        return;
+    }
+    if (type == 0 && address == SchedulerEvent) {
+        pending[thread->thread_id] = false;
+        return;
+    }
+    if (address != SchedulerEvent || thread->status != ThreadStatus::WaitArb ||
+        !pending[thread->thread_id]) {
+        return;
+    }
+    pending[thread->thread_id] = false;
+    LOG_INFO(Service_BOSS, "boss thread {} finished a policy list refresh without waking the "
+                           "scheduler: waking it",
+             thread->thread_id);
+    arbiter.ArbitrateAddress(SharedFrom(thread), ArbitrationType::Signal, SchedulerEvent, -1, 0);
+}
+
 /// Logs what a wait on an invalid handle was about: the waiting thread and, if the handle was
 /// closed shortly before, who closed it and what it was.
 static void LogInvalidWaitHandle(Core::System& system, Handle handle, VAddr handles_address,
@@ -1284,6 +1323,7 @@ Result SVC::ArbitrateAddress(Handle handle, u32 address, u32 type, u32 value, s6
     } else if (type == 0) {
         LogBossArbiter(system, current, "signals", address, value, -1);
     }
+    WakeBossSchedulerAfterPolicyRefresh(system, *arbiter, current, address, type);
 
     // TODO(Subv): Identify in which specific cases this call should cause a reschedule.
     system.PrepareReschedule();
