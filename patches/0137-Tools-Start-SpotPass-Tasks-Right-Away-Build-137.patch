--- a/src/core/hle/kernel/ipc.cpp
+++ b/src/core/hle/kernel/ipc.cpp
@@ -3,6 +3,9 @@
 // Refer to the misc/licenses/gplv2.txt file included.
 
 #include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <set>
 #include <map>
 #include <mutex>
 #include <tuple>
@@ -130,6 +133,28 @@ static void LogBossCall(Memory::MemorySystem& memory, Process& src, Process& dst
                 command, header, task.empty() ? "" : " task ", task, params);
 }
 
+namespace {
+std::atomic<bool> start_spotpass_tasks_now{false};
+std::mutex start_now_mutex;
+/// (program ID, task ID) -> when it was last started this way, so a game that names its task
+/// over and over doesn't restart it each time (at most once a minute).
+std::map<std::pair<u64, std::string>, std::chrono::steady_clock::time_point> started_now;
+/// Game threads whose request was turned into StartTaskImmediate, with the command they sent,
+/// so the reply goes back under the command the game expects.
+std::map<u32, u32> rewritten_requests;
+} // namespace
+
+void SetStartSpotPassTasksNow(bool enabled) {
+    start_spotpass_tasks_now = enabled;
+    std::scoped_lock lock{start_now_mutex};
+    started_now.clear();
+    LOG_INFO(Service_BOSS, "SpotPass: start tasks right away {}", enabled ? "on" : "off");
+}
+
+bool GetStartSpotPassTasksNow() {
+    return start_spotpass_tasks_now;
+}
+
 Result TranslateCommandBuffer(Kernel::KernelSystem& kernel, Memory::MemorySystem& memory,
                               std::shared_ptr<Thread> src_thread,
                               std::shared_ptr<Thread> dst_thread, VAddr src_address,
@@ -157,6 +182,65 @@ Result TranslateCommandBuffer(Kernel::KernelSystem& kernel, Memory::MemorySystem
         LogFailedReply(src_process->GetName(), dst_process->GetName(), header.raw, cmd_buf[1]);
     }
 
+    // Tools > Start SpotPass Tasks Right Away. A game names its SpotPass task to the real
+    // SpotPass module now and then; Nintendogs + Cats does it once at start (UpdateTaskCount
+    // task_EU) and otherwise waits for the module's 12-hour schedule. While the option is on,
+    // such a request becomes StartTaskImmediate (boss:U 0x001D0042: size, task ID buffer) for the
+    // same task, and its reply goes back under the game's own command. All three requests answer
+    // with just a result. UpdateTaskCount/UpdateTaskInterval's value is dropped that once (the
+    // game sets it again at its next start).
+    const auto is_app = [](const Process& process) {
+        return process.codeset && (process.codeset->program_id >> 32) == 0x00040000;
+    };
+    if (!reply && start_spotpass_tasks_now && dst_process->GetName() == "boss" &&
+        is_app(*src_process) &&
+        (header.raw == 0x001C0042 || header.raw == 0x00170082 || header.raw == 0x00180082)) {
+        const std::size_t desc_index = header.raw == 0x001C0042 ? 2 : 3;
+        const u32 desc = cmd_buf[desc_index];
+        const u32 size = desc >> 4;
+        std::string task;
+        if (IPC::GetDescriptorType(desc) == IPC::MappedBuffer && size > 0 && size <= 8) {
+            char buffer[9]{};
+            memory.ReadBlock(*src_process, cmd_buf[desc_index + 1], buffer, size);
+            task = buffer;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        bool start = !task.empty();
+        if (start) {
+            std::scoped_lock lock{start_now_mutex};
+            auto& last = started_now[{src_process->codeset->program_id, task}];
+            start = last == std::chrono::steady_clock::time_point{} ||
+                    now - last > std::chrono::minutes(1);
+            if (start) {
+                last = now;
+                rewritten_requests[src_thread->GetThreadId()] = header.raw;
+            }
+        }
+        if (start) {
+            LOG_INFO(Service_BOSS,
+                     "SpotPass: {} names its task {} (command 0x{:04X}): starting it right away "
+                     "(StartTaskImmediate)",
+                     src_process->GetName(), task, header.raw >> 16);
+            cmd_buf[0] = 0x001D0042;
+            cmd_buf[2] = cmd_buf[desc_index];
+            cmd_buf[3] = cmd_buf[desc_index + 1];
+            header.raw = cmd_buf[0];
+            untranslated_size = 1u + header.normal_params_size;
+            command_size = untranslated_size + header.translate_params_size;
+        }
+    }
+    if (reply && src_process->GetName() == "boss" && (header.raw >> 16) == 0x001D) {
+        std::scoped_lock lock{start_now_mutex};
+        if (const auto it = rewritten_requests.find(dst_thread->GetThreadId());
+            it != rewritten_requests.end()) {
+            LOG_INFO(Service_BOSS, "SpotPass: StartTaskImmediate for {} answered 0x{:08X}",
+                     dst_process->GetName(), header.normal_params_size >= 1 ? cmd_buf[1] : 0);
+            cmd_buf[0] = (it->second & 0xFFFF0000) | (cmd_buf[0] & 0xFFFF);
+            header.raw = cmd_buf[0];
+            rewritten_requests.erase(it);
+        }
+    }
+
     // Background SpotPass and StreetPass while a game runs (test, 2026-10-16). Games ask NDM to
     // pause the background daemons when they start (ndm:u SuspendDaemons, mask bit 0 = StreetPass
     // (cecd), bit 1 = SpotPass (boss), bit 2 = nim); on a console the HOME Menu and sleep mode
