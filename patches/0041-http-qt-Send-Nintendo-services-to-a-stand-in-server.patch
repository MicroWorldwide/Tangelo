+    using Service::HTTP::RedirectNintendoServiceUrl;
+
+    CHECK(GetNintendoService("https://nasc.nintendowifi.net/ac") ==
+          NintendoService::GameServerLogin);
+    CHECK(GetNintendoService("http://conntest.nintendowifi.net/") ==
+          NintendoService::ConnectionTest);
+    CHECK(GetNintendoService("https://NUS.c.shop.nintendowifi.net/nus/services/NetUpdateSOAP") ==
+          NintendoService::SystemUpdate);
+    CHECK_FALSE(GetNintendoService("https://ecs.c.shop.nintendowifi.net/ecs/services/x"));
+    CHECK_FALSE(GetNintendoService("https://npdl.cdn.nintendowifi.net/p01/nsa/a/b/c"));
+
+    // Without a scheme the stand-in server is plain http (it has no Nintendo certificate).
+    CHECK(RedirectNintendoServiceUrl("https://nasc.nintendowifi.net/ac", "localhost:8080") ==
+          "http://localhost:8080/ac");
+    CHECK(RedirectNintendoServiceUrl("https://nus.c.shop.nintendowifi.net/nus/services/"
+                                     "NetUpdateSOAP",
+                                     "https://my.host/base/") ==
+          "https://my.host/base/nus/services/NetUpdateSOAP");
+    CHECK(RedirectNintendoServiceUrl("http://conntest.nintendowifi.net", "localhost:8080") ==
+          "http://localhost:8080/");
+    CHECK_FALSE(RedirectNintendoServiceUrl("https://nasc.nintendowifi.net/ac", "  "));
+    CHECK_FALSE(RedirectNintendoServiceUrl("https://example.com/ac", "localhost:8080"));
