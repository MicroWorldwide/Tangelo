+++ b/src/core/hle/service/http/spotpass_redirect.h
@@ -42,4 +42,26 @@ std::optional<std::string> RedirectSpotPassUrl(std::string_view url, std::string
 /// The host part of `url` without scheme, port, path or query.
 std::string GetUrlHost(std::string_view url);
 
+/// Nintendo 3DS services other than SpotPass that a stand-in server can answer.
+enum class NintendoService {
+    ConnectionTest,  ///< conntest.nintendowifi.net
+    GameServerLogin, ///< nasc.nintendowifi.net (NASC)
+    SystemUpdate,    ///< nus.c.shop.nintendowifi.net (NUS)
+};
+
+/// The service `url` is for, or nullopt if it isn't one of the services above.
+std::optional<NintendoService> GetNintendoService(std::string_view url);
+
+/// Name of a service for the log ("game server login", ...).
+std::string_view GetNintendoServiceName(NintendoService service);
+
+/**
+ * Rewrites `url` to the stand-in server `server` ("[scheme://]host[:port][/base/path]", http
+ * when no scheme is given), keeping the path and query: "https://nasc.nintendowifi.net/ac"
+ * with server "localhost:8080" becomes "http://localhost:8080/ac". Returns nullopt if `url`
+ * isn't a Nintendo service or `server` is empty or invalid.
+ */
+std::optional<std::string> RedirectNintendoServiceUrl(std::string_view url,
+                                                      std::string_view server);
+
 } // namespace Service::HTTP
