+void Module::Interface::ScanAPs(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 size = rp.Pop<u32>();
+    rp.PopPID();
+
+    constexpr std::size_t APInfoSize = 0x34;
+    const auto around = AccessPointsAround();
+    const std::size_t count = std::min(around.size(), static_cast<std::size_t>(size / APInfoSize));
+    std::vector<u8> buffer(size, 0);
+    for (std::size_t i = 0; i < count; ++i) {
+        const ScannedAP& ap = around[i];
+        u8* entry = buffer.data() + i * APInfoSize;
+        const u32 ssid_length = static_cast<u32>(std::min<std::size_t>(ap.ssid.size(), 32));
+        std::memcpy(entry, &ssid_length, sizeof(ssid_length));
+        std::memcpy(entry + 0x4, ap.ssid.data(), ssid_length);
+        std::memcpy(entry + 0x24, ap.bssid.data(), ap.bssid.size());
+        const u16 channel = ap.channel;
+        std::memcpy(entry + 0x2C, &channel, sizeof(channel));
+        entry[0x2E] = ap.signal;
+    }
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(2, 2);
+    rb.Push(ResultSuccess);
+    rb.Push<u32>(static_cast<u32>(count));
+    rb.PushStaticBuffer(std::move(buffer), 0);
+
+    LOG_INFO(Service_AC, "ScanAPs: {} access point(s) around (buffer for {})", count,
+             size / APInfoSize);
+    for (std::size_t i = 0; i < count; ++i) {
+        const auto& b = around[i].bssid;
+        LOG_DEBUG(Service_AC, "  {} {:02X}:{:02X}:{:02X}:{:02X}:{:02X}:{:02X} signal {}",
+                  around[i].ssid, b[0], b[1], b[2], b[3], b[4], b[5], around[i].signal);
+    }
+}
