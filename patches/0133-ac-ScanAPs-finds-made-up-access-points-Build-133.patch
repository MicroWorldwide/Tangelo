+
+/// One access point as ScanAPs reports it (0x34 bytes, the GetCurrentAPInfo layout):
+/// 0x00 u32 SSID length, 0x04 SSID (32 bytes), 0x24 BSSID (6 bytes), 0x2C u16 channel,
+/// 0x2E u8 signal strength, 0x2F u8 unknown (kept 0). Field use seen in The Denpa Men 2
+/// (00040000000EAF00): it makes its Denpa Men from the BSSID, skips an access point whose
+/// signal byte is below its threshold (0xA0), and skips a locally administered BSSID
+/// (first byte bit 1).
+struct ScannedAP {
+    std::string ssid;
+    std::array<u8, 6> bssid{};
+    u8 channel = 1;
+    u8 signal = 0xE0;
+};
+
+/// Real vendor prefixes (OUIs) for the made-up access points, so their BSSIDs look like
+/// ordinary routers (universally administered: games skip locally administered ones).
+constexpr std::array<std::array<u8, 3>, 8> VendorPrefixes{{
+    {0x00, 0x1D, 0x7E}, {0x00, 0x24, 0x01}, {0x00, 0x1F, 0x33}, {0xC8, 0x3A, 0x35},
+    {0x00, 0x14, 0xBF}, {0x00, 0x26, 0x5A}, {0x00, 0x1E, 0x58}, {0x00, 0x0F, 0xB5},
+}};
+
+/// The access points ScanAPs finds. From <sysdata>/access_points.txt when it exists, one per
+/// line "SSID;BSSID[;signal]" (BSSID as 6 hex bytes, ':' or '-' between them allowed; '#'
+/// starts a comment). Otherwise 8 made-up ones that change every day, so a game that collects
+/// them (The Denpa Men) finds new ones each day as on a console carried around.
+std::vector<ScannedAP> AccessPointsAround() {
+    std::vector<ScannedAP> found;
+    const std::string path =
+        FileUtil::GetUserPath(FileUtil::UserPath::SysDataDir) + "access_points.txt";
+    std::ifstream file(path);
+    std::string line;
+    while (file && std::getline(file, line) && found.size() < 32) {
+        if (line.empty() || line[0] == '#') {
+            continue;
+        }
+        const auto first = line.find(';');
+        if (first == std::string::npos) {
+            continue;
+        }
+        ScannedAP ap;
+        ap.ssid = line.substr(0, std::min<std::size_t>(first, 32));
+        const auto second = line.find(';', first + 1);
+        std::string mac = line.substr(first + 1, second == std::string::npos
+                                                     ? std::string::npos
+                                                     : second - first - 1);
+        std::string hex;
+        for (char c : mac) {
+            if (std::isxdigit(static_cast<unsigned char>(c))) {
+                hex.push_back(c);
+            }
+        }
+        if (hex.size() != 12) {
+            continue;
+        }
+        for (std::size_t i = 0; i < 6; ++i) {
+            ap.bssid[i] = static_cast<u8>(std::stoul(hex.substr(i * 2, 2), nullptr, 16));
+        }
+        if (second != std::string::npos) {
+            ap.signal = static_cast<u8>(std::clamp(std::atoi(line.c_str() + second + 1), 0, 255));
+        }
+        ap.channel = static_cast<u8>(1 + (found.size() * 5) % 11);
+        found.push_back(std::move(ap));
+    }
+    if (!found.empty()) {
+        return found;
+    }
+
+    // No list: 8 made-up access points, the same all day and different the next day.
+    const std::time_t now = std::time(nullptr);
+    const std::tm* local = std::localtime(&now);
+    u32 seed = static_cast<u32>((local->tm_year + 1900) * 10000 + (local->tm_mon + 1) * 100 +
+                                local->tm_mday);
+    const auto next = [&seed] {
+        seed = seed * 1103515245u + 12345u;
+        return static_cast<u8>(seed >> 16);
+    };
+    for (int i = 0; i < 8; ++i) {
+        ScannedAP ap;
+        const auto& vendor = VendorPrefixes[next() % VendorPrefixes.size()];
+        ap.bssid = {vendor[0], vendor[1], vendor[2], next(), next(), next()};
+        ap.ssid = fmt::format("Tangelo-{:02X}{:02X}", ap.bssid[4], ap.bssid[5]);
+        ap.channel = static_cast<u8>(1 + (i * 5) % 11);
+        ap.signal = static_cast<u8>(0xB0 + next() % 0x50);
+        found.push_back(std::move(ap));
+    }
+    return found;
+}
