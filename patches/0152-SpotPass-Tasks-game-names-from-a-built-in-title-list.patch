+            const int tab = line.indexOf(QLatin1Char('\t'));
+            if (line.startsWith(QLatin1Char('#')) || tab != 16) {
+                continue;
+            }
+            bool ok = false;
+            const u64 title_id = line.left(16).toULongLong(&ok, 16);
+            if (ok) {
+                list.insert(title_id, line.mid(tab + 1));
+            }
+        }
+        return list;
+    }();
+    return names;
