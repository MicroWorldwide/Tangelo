+bool OnlineService::StartTask(const std::string& task_id,
+                              const std::shared_ptr<SpotPassState>& state) {
+    std::string url;
+    std::string last_modified;
+    {
+        std::scoped_lock lock(mutex);
+        const auto task = task_id_list.find(task_id);
+        if (task == task_id_list.end()) {
+            return false;
+        }
+        auto& properties = task->second.properties;
+        if (std::get<u8>(properties[TaskStateProperty]) == static_cast<u8>(TaskState::Running)) {
+            LOG_DEBUG(Service_BOSS, "SpotPass task '{}' is already running", task_id);
+            return true;
+        }
+        url = PropertyString(properties[PropertyID::Url]);
+        last_modified = PropertyString(properties[TaskLastModifiedProperty]);
+        properties[TaskStateProperty] = static_cast<u8>(TaskState::Running);
+    }
+
+    {
+        std::scoped_lock state_lock(state->mutex);
+        state->tasks_run.emplace(session_program_id, task_id);
+        if (state->cancel) {
+            FinishTask(task_id, TaskState::Failed, 0, {});
+            return true;
+        }
+        ++state->active_workers;
+    }
+
+    LOG_INFO(Service_BOSS, "Running SpotPass task '{}': {}", task_id, url);
+    std::thread([self = shared_from_this(), task_id, url = std::move(url),
+                 last_modified = std::move(last_modified), state]() mutable {
+        self->RunTask(task_id, std::move(url), std::move(last_modified), state);
+        std::scoped_lock state_lock(state->mutex);
+        --state->active_workers;
+        state->workers_done.notify_all();
+    }).detach();
+    return true;
+}
+
+void OnlineService::RunTask(const std::string& task_id, std::string url, std::string last_modified,
+                            std::shared_ptr<SpotPassState> state) {
+    if (url.empty()) {
+        LOG_WARNING(Service_BOSS, "SpotPass task '{}' has no URL", task_id);
+        FinishTask(task_id, TaskState::Failed, 0, {});
+        return;
+    }
+
+    const TaskDownload download = DownloadTaskFile(url, last_modified, state->cancel);
+    if (state->cancel) {
+        return;
+    }
+    if (download.status == 304) {
+        LOG_INFO(Service_BOSS, "SpotPass task '{}': nothing new", task_id);
+        FinishTask(task_id, TaskState::Success, 304, last_modified);
+        return;
+    }
+    if (download.status != 200) {
+        LOG_WARNING(Service_BOSS, "SpotPass task '{}' failed: {}", task_id,
+                    download.status != 0 ? fmt::format("HTTP {}", download.status)
+                                         : download.error);
+        FinishTask(task_id, TaskState::Failed, download.status, {});
+        return;
+    }
+
+    if (!HW::AES::IsNormalKeyAvailable(HW::AES::BOSSDataKey)) {
+        LOG_ERROR(Service_BOSS, "SpotPass task '{}': the SpotPass key (slot 0x38) is missing",
+                  task_id);
+        FinishTask(task_id, TaskState::Failed, download.status, {});
+        return;
+    }
+    const auto payloads =
+        DecodeBossContainer(download.body, HW::AES::GetNormalKey(HW::AES::BOSSDataKey));
+    if (!payloads) {
+        LOG_WARNING(Service_BOSS, "SpotPass task '{}': the downloaded file isn't SpotPass data",
+                    task_id);
+        FinishTask(task_id, TaskState::Failed, download.status, {});
+        return;
+    }
+
+    const auto written = StoreNsData(*payloads);
+    if (!written) {
+        FinishTask(task_id, TaskState::Failed, download.status, {});
+        return;
+    }
+    if (!written->empty()) {
+        std::scoped_lock state_lock(state->mutex);
+        for (const u32 ns_data_id : *written) {
+            state->ns_data_new_flags[ns_data_id] = 1;
+        }
+        state->new_arrival = true;
+    }
+    LOG_INFO(Service_BOSS, "SpotPass task '{}' done: {} file(s), {} new or updated", task_id,
+             payloads->size(), written->size());
+    FinishTask(task_id, TaskState::Success, download.status, download.last_modified);
+}
+
+void OnlineService::FinishTask(const std::string& task_id, TaskState state, u32 http_status,
+                               const std::string& last_modified) {
+    std::scoped_lock lock(mutex);
+    const auto task = task_id_list.find(task_id);
+    if (task == task_id_list.end()) {
+        return;
+    }
+    auto& properties = task->second.properties;
+    properties[TaskStateProperty] = static_cast<u8>(state);
+    properties[TaskHttpStatusProperty] = http_status;
+    if (state == TaskState::Success) {
+        properties[TaskLastSuccessProperty] =
+            static_cast<u64>(static_cast<s64>(std::time(nullptr)) - SecondsTo2000);
+        SetPropertyString(properties[TaskLastModifiedProperty], last_modified);
+    }
+}
+
+void OnlineService::RunTasksAtStart(const std::shared_ptr<SpotPassState>& state,
+                                    std::optional<std::string> task_id) {
+    if (!Settings::values.use_custom_spotpass_server.GetValue()) {
+        return;
+    }
+
+    std::vector<std::string> task_ids;
+    {
+        std::scoped_lock lock(mutex);
+        for (auto& [id, task] : task_id_list) {
+            if ((!task_id || *task_id == id) &&
+                !PropertyString(task.properties[PropertyID::Url]).empty()) {
+                task_ids.push_back(id);
+            }
+        }
+    }
+    for (const auto& id : task_ids) {
+        {
+            std::scoped_lock state_lock(state->mutex);
+            if (state->tasks_run.contains({session_program_id, id})) {
+                continue;
+            }
+        }
+        StartTask(id, state);
+    }
+}
+
+std::optional<TaskState> OnlineService::GetTaskState(const std::string& task_id) {
+    std::scoped_lock lock(mutex);
+    const auto task = task_id_list.find(task_id);
+    if (task == task_id_list.end()) {
+        return std::nullopt;
+    }
+    return static_cast<TaskState>(std::get<u8>(task->second.properties[TaskStateProperty]));
+}
+
+bool OnlineService::LoadTaskProperties(const std::string& task_id) {
+    std::scoped_lock lock(mutex);
+    const auto task = task_id_list.find(task_id);
+    if (task == task_id_list.end()) {
+        return false;
+    }
+    current_props = task->second;
+    return true;
+}
+
+std::optional<std::vector<u32>> OnlineService::StoreNsData(
+    const std::vector<BossPayload>& payloads) {
+    std::scoped_lock lock(mutex);
+    auto boss_archive = OpenBossExtData();
+    if (!boss_archive) {
+        LOG_WARNING(Service_BOSS,
+                    "Can't store SpotPass data: the game hasn't created its SpotPass storage");
+        return std::nullopt;
+    }
+    const std::vector<NsDataEntry> existing = GetNsDataEntries();
+
+    std::vector<u32> written;
+    for (BossPayload payload : payloads) {
+        if (payload.program_id != program_id) {
+            // E.g. data from another region's server; stored for this game so it can read it.
+            LOG_WARNING(Service_BOSS,
+                        "SpotPass file {:#010x} is for program {:#018x}; storing it for {:#018x}",
+                        payload.ns_data_id, payload.program_id, program_id);
+            payload.program_id = program_id;
+        }
+
+        std::string filename = fmt::format("tangelo_{:08X}", payload.ns_data_id);
+        const auto old = std::find_if(existing.begin(), existing.end(), [&](const auto& entry) {
+            return entry.header.ns_data_id == payload.ns_data_id;
+        });
+        if (old != existing.end()) {
+            if (old->header.version == payload.version &&
+                old->header.payload_size == payload.data.size()) {
+                continue;
+            }
+            filename = old->filename;
+            boss_archive->DeleteFile(FileSys::Path(("/" + filename).c_str()));
+        }
+
+        const std::vector<u8> stored = MakeStoredNsData(payload);
+        const FileSys::Path path(("/" + filename).c_str());
+        if (boss_archive->CreateFile(path, stored.size()).IsError()) {
+            LOG_ERROR(Service_BOSS, "Could not create SpotPass file '{}'", filename);
+            continue;
+        }
+        FileSys::Mode mode{};
+        mode.write_flag.Assign(1);
+        auto file_result = boss_archive->OpenFile(path, mode);
+        if (!file_result.Succeeded()) {
+            LOG_ERROR(Service_BOSS, "Could not open SpotPass file '{}'", filename);
+            continue;
+        }
+        auto file = std::move(file_result).Unwrap();
+        const auto write_result = file->Write(0, stored.size(), true, false, stored.data());
+        file->Close();
+        if (!write_result.Succeeded() || write_result.Unwrap() != stored.size()) {
+            LOG_ERROR(Service_BOSS, "Could not write SpotPass file '{}'", filename);
+            continue;
+        }
+        LOG_INFO(Service_BOSS, "Stored SpotPass file '{}' (NsData {:#010x}, version {}, {} bytes)",
+                 filename, payload.ns_data_id, payload.version, payload.data.size());
+        written.push_back(payload.ns_data_id);
+    }
+    return written;
+}
+
 } // namespace Service::BOSS
