+
+namespace Service::BOSS {
+
+namespace {
+// Larger than any file in the SpotPass archive (the biggest are ~30 MB).
+constexpr std::size_t MaxDownloadSize = 128 * 1024 * 1024;
+constexpr time_t ConnectionTimeoutSeconds = 10;
+constexpr time_t ReadTimeoutSeconds = 60;
+} // namespace
+
+TaskDownload DownloadTaskFile(const std::string& url, const std::string& if_modified_since,
+                              const std::atomic<bool>& cancel) {
+    TaskDownload download;
+
+    std::string request_url = url;
+    std::optional<std::string> original_host;
+    if (Settings::values.use_custom_spotpass_server.GetValue()) {
+        if (auto redirected =
+                HTTP::RedirectSpotPassUrl(url, Settings::values.spotpass_server_url.GetValue())) {
+            original_host = HTTP::GetUrlHost(url);
+            request_url = std::move(*redirected);
+        }
+    }
+    if (request_url.rfind("http://", 0) != 0 && request_url.rfind("https://", 0) != 0) {
+        download.error = "not an http(s) address";
+        return download;
+    }
+
+    const Common::URLInfo url_info = Common::SplitUrl(request_url);
+    std::unique_ptr<httplib::ClientImpl> client;
+    if (url_info.is_https) {
+        auto ssl_client = std::make_unique<httplib::SSLClient>(url_info.host, url_info.port);
+        ssl_client->enable_server_certificate_verification(false);
+        client = std::move(ssl_client);
+    } else {
+        client = std::make_unique<httplib::ClientImpl>(url_info.host, url_info.port);
+    }
+    client->set_connection_timeout(ConnectionTimeoutSeconds);
+    client->set_read_timeout(ReadTimeoutSeconds);
+
+    httplib::Headers headers{{"User-Agent", "PBOS-8.0/0000000000000000-0000000000000000/0.0.0/0"}};
+    if (original_host) {
+        headers.emplace("X-Tangelo-Original-Host", *original_host);
+    }
+    if (!if_modified_since.empty()) {
+        headers.emplace("If-Modified-Since", if_modified_since);
+    }
+
+    std::string body;
+    bool too_large = false;
+    const auto result = client->Get(url_info.path.empty() ? "/" : url_info.path, headers,
+                                    [&](const char* data, std::size_t length) {
+                                        if (cancel) {
+                                            return false;
+                                        }
+                                        if (body.size() + length > MaxDownloadSize) {
+                                            too_large = true;
+                                            return false;
+                                        }
+                                        body.append(data, length);
+                                        return true;
+                                    });
+
+    if (!result) {
+        download.error = cancel      ? "cancelled"
+                         : too_large ? "file too large"
+                                     : httplib::to_string(result.error());
+        LOG_WARNING(Service_BOSS, "SpotPass download of {} failed: {}", request_url,
+                    download.error);
+        return download;
+    }
+
+    download.status = result->status;
+    download.last_modified = result->get_header_value("Last-Modified");
+    download.body.assign(body.begin(), body.end());
+    LOG_INFO(Service_BOSS, "SpotPass download {} -> HTTP {}, {} bytes", request_url,
+             download.status, download.body.size());
+    return download;
+}
+
+} // namespace Service::BOSS
