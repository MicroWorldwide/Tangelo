@@ -0,0 +1,43 @@
+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <array>
+#include <optional>
+#include <span>
+#include <vector>
+#include "common/common_types.h"
+
+namespace Service::BOSS {
+
+/// One entry of a SpotPass ("boss") container, after decryption.
+struct BossPayload {
+    u64 program_id = 0;
+    u32 datatype = 0;
+    u32 ns_data_id = 0;
+    u32 version = 0;
+    std::vector<u8> data;
+};
+
+/**
+ * Decodes a SpotPass container as served by Nintendo's content server
+ * (https://www.3dbrew.org/wiki/SpotPass): a 0x28-byte header ("boss", 0x00010001, size, ...,
+ * 12-byte IV at 0x1C) followed by data encrypted with AES-128-CTR (IV + big-endian counter 1).
+ * The decrypted data starts with a 0x132-byte content header (payload count as a big-endian u16
+ * at 0x10), followed by each payload: a 0x13C-byte header (program ID, unknown, datatype, size,
+ * NsData ID, version, hash, signature; all big-endian) and its data.
+ * Signatures aren't checked. Returns nullopt for anything that isn't a valid container.
+ */
+std::optional<std::vector<BossPayload>> DecodeBossContainer(std::span<const u8> file,
+                                                            const std::array<u8, 16>& key);
+
+/**
+ * The file the BOSS module stores in the title's SpotPass extdata for a payload: a 0x34-byte
+ * header (header length 0x18, program ID at 0x18, datatype, payload size, NsData ID and version
+ * at 0x24..0x33, all big-endian) followed by the payload data.
+ */
+std::vector<u8> MakeStoredNsData(const BossPayload& payload);
+
+} // namespace Service::BOSS
