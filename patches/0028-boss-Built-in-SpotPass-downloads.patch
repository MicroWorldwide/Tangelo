+// Copyright 2026 Tangelo Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <cryptopp/aes.h>
+#include <cryptopp/modes.h>
+#include "core/hle/service/boss/boss_container.h"
+
+namespace Service::BOSS {
+
+namespace {
+constexpr std::size_t HeaderSize = 0x28;
+constexpr std::size_t IvOffset = 0x1C;
+constexpr std::size_t IvSize = 12;
+constexpr std::size_t ContentHeaderSize = 0x132;
+constexpr std::size_t PayloadCountOffset = 0x10;
+constexpr std::size_t PayloadHeaderSize = 0x13C;
+constexpr std::size_t StoredHeaderSize = 0x34;
+constexpr u8 StoredHeaderLength = 0x18;
+
+u32 ReadBE32(std::span<const u8> d, std::size_t o) {
+    return (u32{d[o]} << 24) | (u32{d[o + 1]} << 16) | (u32{d[o + 2]} << 8) | u32{d[o + 3]};
+}
+
+u64 ReadBE64(std::span<const u8> d, std::size_t o) {
+    return (u64{ReadBE32(d, o)} << 32) | ReadBE32(d, o + 4);
+}
+
+void WriteBE32(std::vector<u8>& d, std::size_t o, u32 v) {
+    for (int i = 0; i < 4; ++i) {
+        d[o + i] = static_cast<u8>(v >> (24 - 8 * i));
+    }
+}
+} // namespace
+
+std::optional<std::vector<BossPayload>> DecodeBossContainer(std::span<const u8> file,
+                                                            const std::array<u8, 16>& key) {
+    if (file.size() < HeaderSize + ContentHeaderSize || file[0] != 'b' || file[1] != 'o' ||
+        file[2] != 's' || file[3] != 's' || ReadBE32(file, 4) != 0x00010001) {
+        return std::nullopt;
+    }
+    const u32 declared_size = ReadBE32(file, 8);
+    if (declared_size > file.size()) {
+        return std::nullopt;
+    }
+
+    std::array<u8, 16> iv{};
+    std::copy_n(file.begin() + IvOffset, IvSize, iv.begin());
+    iv[15] = 1;
+
+    std::vector<u8> plain(declared_size - HeaderSize);
+    CryptoPP::CTR_Mode<CryptoPP::AES>::Decryption decryption(key.data(), key.size(), iv.data());
+    decryption.ProcessData(plain.data(), file.data() + HeaderSize, plain.size());
+
+    const std::span<const u8> content(plain);
+    const u32 count = (u32{content[PayloadCountOffset]} << 8) | content[PayloadCountOffset + 1];
+    std::vector<BossPayload> payloads;
+    std::size_t offset = ContentHeaderSize;
+    for (u32 i = 0; i < count; ++i) {
+        if (offset + PayloadHeaderSize > content.size()) {
+            return std::nullopt;
+        }
+        BossPayload payload{
+            .program_id = ReadBE64(content, offset),
+            .datatype = ReadBE32(content, offset + 0xC),
+            .ns_data_id = ReadBE32(content, offset + 0x14),
+            .version = ReadBE32(content, offset + 0x18),
+        };
+        const u32 size = ReadBE32(content, offset + 0x10);
+        offset += PayloadHeaderSize;
+        if (size > content.size() - offset) {
+            return std::nullopt;
+        }
+        payload.data.assign(content.begin() + offset, content.begin() + offset + size);
+        offset += size;
+        payloads.push_back(std::move(payload));
+    }
+    return payloads;
+}
+
+std::vector<u8> MakeStoredNsData(const BossPayload& payload) {
+    std::vector<u8> file(StoredHeaderSize + payload.data.size(), 0);
+    file[0] = StoredHeaderLength;
+    WriteBE32(file, 0x18, static_cast<u32>(payload.program_id >> 32));
+    WriteBE32(file, 0x1C, static_cast<u32>(payload.program_id));
+    WriteBE32(file, 0x24, payload.datatype);
+    WriteBE32(file, 0x28, static_cast<u32>(payload.data.size()));
+    WriteBE32(file, 0x2C, payload.ns_data_id);
+    WriteBE32(file, 0x30, payload.version);
+    std::copy(payload.data.begin(), payload.data.end(), file.begin() + StoredHeaderSize);
+    return file;
+}
+
+} // namespace Service::BOSS
