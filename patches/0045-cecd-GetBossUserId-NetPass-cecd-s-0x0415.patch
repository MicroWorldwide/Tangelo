+
+TEST_CASE("BOSS user ID follows the MAC address", "[service][cecd]") {
+    const u64 a = Service::CECD::MakeBossUserId("34:2F:BD:8E:E5:15");
+    CHECK(a == Service::CECD::MakeBossUserId("34:2F:BD:8E:E5:15"));
+    CHECK(a != Service::CECD::MakeBossUserId("34:2F:BD:00:00:01"));
+    CHECK((a >> 63) == 0);
+}
