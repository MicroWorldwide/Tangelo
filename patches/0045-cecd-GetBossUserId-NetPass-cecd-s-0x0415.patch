+++ b/src/core/hle/service/cecd/cecd.h
@@ -624,6 +624,15 @@ public:
          */
         void GetCecInfoEventHandleSys(Kernel::HLERequestContext& ctx);
 
+        /**
+         * GetBossUserId (cecd:s 0x0415). Not in Nintendo's CECD module: added by NetPass's CECD
+         * patch, and read by the NetPass app (3ds-boss-userid header) to tell consoles apart.
+         *  Outputs:
+         *      1: Result
+         *    2-3: u64 BOSS user ID
+         */
+        void GetBossUserId(Kernel::HLERequestContext& ctx);
+
     protected:
         std::shared_ptr<Module> cecd;
     };
@@ -665,6 +674,10 @@ private:
 };
 
 /// Initialize CECD service(s)
+/// The BOSS user ID this emulated console reports (GetBossUserId): derived from its MAC address,
+/// so it stays the same for an install and differs between installs.
+u64 MakeBossUserId(std::string_view mac_address);
+
 void InstallInterfaces(Core::System& system);
 
